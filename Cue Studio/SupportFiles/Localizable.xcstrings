    "From Files. Use only music you own or have the rights to — songs from Apple Music can’t be added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من الملفات. استخدم فقط موسيقى تملكها أو لديك حقوقها — لا يمكن إضافة أغاني Apple Music."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus „Dateien“. Nutze nur Musik, die dir gehört oder für die du die Rechte hast – Songs aus Apple Music lassen sich nicht hinzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde Archivos. Usa solo música tuya o con derechos: las canciones de Apple Music no se pueden añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depuis Fichiers. N’utilisez que de la musique à vous ou dont vous avez les droits — les morceaux d’Apple Music ne peuvent pas être ajoutés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files से। सिर्फ़ अपना या जिसके अधिकार आपके पास हैं वही म्यूज़िक इस्तेमाल करें — Apple Music के गाने नहीं जोड़े जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari File. Gunakan hanya musik milikmu atau yang hak-nya kamu punya — lagu dari Apple Music tidak bisa ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da File. Usa solo musica tua o di cui hai i diritti: i brani di Apple Music non si possono aggiungere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルから。自分の音楽か権利のある音楽だけを使ってください — Apple Musicの曲は追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일에서 가져옵니다. 직접 소유했거나 권리가 있는 음악만 사용하세요 — Apple Music 노래는 추가할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do app Arquivos. Use só música sua ou com direitos — músicas do Apple Music não podem ser adicionadas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จากไฟล์ ใช้เฉพาะเพลงที่คุณเป็นเจ้าของหรือมีสิทธิ์ — เพิ่มเพลงจาก Apple Music ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyalar’dan. Yalnızca sana ait ya da hakkına sahip olduğun müzikleri kullan — Apple Music şarkıları eklenemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ Tệp. Chỉ dùng nhạc của bạn hoặc bạn có quyền — không thể thêm bài hát từ Apple Music."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自“文件”。请仅使用你拥有或有权使用的音乐——无法添加 Apple Music 中的歌曲。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uit Bestanden. Gebruik alleen muziek waarvan je de rechten hebt — nummers uit Apple Music kunnen niet worden toegevoegd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Från Filer. Använd bara musik du äger eller har rättigheter till — låtar från Apple Music kan inte läggas till."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra Filer. Brug kun musik, du ejer eller har rettighederne til — sange fra Apple Music kan ikke tilføjes."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra Filer. Bruk bare musikk du eier eller har rettighetene til — sanger fra Apple Music kan ikke legges til."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "來自「檔案」。僅使用你擁有或有權使用的音樂 — 無法加入 Apple Music 的歌曲。"
          }
        }
      }
    },
