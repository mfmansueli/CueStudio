        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ý tưởng bạn ghi lại sẽ chờ ở đây cho đến khi bạn định hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记下的想法会在这里等你把它们成形。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
