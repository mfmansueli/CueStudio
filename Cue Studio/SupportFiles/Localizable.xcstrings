    "You’ve probably heard you need eight glasses a day. Let’s look at that." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما سمعت أنك تحتاج إلى ثمانية أكواب يوميًا. لنلقِ نظرة على ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har sikkert hørt, at du skal have otte glas om dagen. Lad os se på det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast sicher gehört, dass du acht Gläser am Tag brauchst. Schauen wir uns das an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguro que has oído que necesitas ocho vasos al día. Veamos eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez sûrement entendu qu’il faut boire huit verres par jour. Regardons ça de plus près."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने शायद सुना होगा कि दिन में आठ गिलास पानी चाहिए। आइए इसे देखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mungkin pernah dengar harus minum delapan gelas sehari. Yuk kita lihat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente hai sentito che servono otto bicchieri al giorno. Vediamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日8杯必要だと聞いたことがあるかもしれません。確かめてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 여덟 잔을 마셔야 한다는 말, 들어 보셨죠? 한번 살펴볼게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har sikkert hørt at du trenger åtte glass om dagen. La oss se på det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt vast gehoord dat je acht glazen per dag nodig hebt. Laten we dat bekijken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
