          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentornato. Cue accende il suo pianeta quando è online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おかえりなさい。公開されたらCueがその惑星を灯します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌아오셨네요. 게시되면 Cue가 그 행성을 밝혀요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen tilbake. Cue tenner planeten når den er live."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
