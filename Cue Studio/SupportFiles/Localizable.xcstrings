    "Every creator has a universe to share." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لكل صانع محتوى كونٌ يشاركه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Creator hat ein Universum zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada creador tiene un universo que compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque créateur a un univers à partager."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर क्रिएटर के पास साझा करने के लिए एक ब्रह्मांड है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap kreator punya semesta untuk dibagikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni creator ha un universo da condividere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリエイターには、それぞれ伝えたい宇宙があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 크리에이터에게는 나눌 우주가 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo criador tem um universo para compartilhar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครีเอเตอร์ทุกคนมีจักรวาลที่อยากแบ่งปัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her içerik üreticisinin paylaşacak bir evreni vardır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi nhà sáng tạo đều có một vũ trụ để chia sẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位创作者都有一个值得分享的宇宙。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke creator heeft een universum om te delen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje skapare har ett universum att dela."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver skaber har et univers at dele."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver skaper har et univers å dele."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每位創作者都有一個值得分享的宇宙。"
          }
        }
      }
    },
    "Write it, say it on camera, and send it further. Script, teleprompter, captions and edit in one place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتبه، قله أمام الكاميرا، وأرسله أبعد. نص وتلقين وترجمة وتحرير في مكان واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib es, sprich es in die Kamera und schick es weiter. Skript, Teleprompter, Untertitel und Schnitt an einem Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escríbelo, dilo a cámara y llévalo más lejos. Guion, teleprompter, subtítulos y edición en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écris-le, dis-le face caméra et envoie-le plus loin. Script, téléprompteur, sous-titres et montage au même endroit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे लिखें, कैमरे पर बोलें और आगे भेजें। स्क्रिप्ट, टेलीप्रॉम्प्टर, कैप्शन और एडिट, सब एक जगह।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis, ucapkan di depan kamera, lalu kirim lebih jauh. Naskah, teleprompter, teks otomatis, dan edit di satu tempat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivilo, dillo in camera e portalo più lontano. Copione, teleprompter, sottotitoli e montaggio in un unico posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書いて、カメラの前で話して、さらに遠くへ。台本、テレプロンプター、字幕、編集がひとつに。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰고, 카메라 앞에서 말하고, 더 멀리 보내세요. 대본, 텔레프롬프터, 자막, 편집을 한곳에서."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva, diga para a câmera e leve mais longe. Roteiro, teleprompter, legendas e edição em um só lugar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียน พูดหน้ากล้อง แล้วส่งต่อไปให้ไกลขึ้น สคริปต์ เทเลพรอมต์เตอร์ คำบรรยาย และตัดต่อ ในที่เดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yaz, kameraya söyle ve daha öteye gönder. Senaryo, telepromter, altyazı ve kurgu tek yerde."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viết, nói trước camera và gửi đi xa hơn. Kịch bản, teleprompter, phụ đề và dựng phim trong một nơi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写下来，对着镜头说出来，再传得更远。脚本、提词器、字幕和剪辑，一站搞定。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf het, zeg het voor de camera en stuur het verder. Script, teleprompter, ondertitels en bewerking op één plek."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv det, säg det framför kameran och skicka det vidare. Manus, teleprompter, undertexter och redigering på ett ställe."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv det, sig det foran kameraet, og send det videre. Manuskript, teleprompter, undertekster og redigering ét sted."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv det, si det foran kameraet og send det videre. Manus, teleprompter, undertekster og redigering på ett sted."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寫下來、對著鏡頭說出來，再傳送出去。腳本、提詞機、字幕與剪輯，一站搞定。"
          }
        }
      }
    },
