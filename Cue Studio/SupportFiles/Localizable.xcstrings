    "YouTube only allows mid-roll ads on videos 8 minutes or longer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح YouTube بإعلانات منتصف الفيديو فقط في الفيديوهات التي مدتها 8 دقائق أو أكثر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube tillader kun mid-roll-annoncer på videoer på 8 minutter eller mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube erlaubt Mid-Roll-Werbung nur bei Videos ab 8 Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube solo permite anuncios a mitad del vídeo en vídeos de 8 minutos o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube n’autorise les pubs en milieu de vidéo que pour les vidéos de 8 minutes ou plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube सिर्फ़ 8 मिनट या उससे लंबे वीडियो पर मिड-रोल ऐड की अनुमति देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube hanya mengizinkan iklan tengah video pada video berdurasi 8 menit atau lebih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube consente annunci a metà video solo per video di almeno 8 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTubeのミッドロール広告は8分以上の動画でのみ使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube는 8분 이상인 동영상에서만 중간 광고를 허용해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube tillater bare mid-roll-annonser på videoer på 8 minutter eller mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube staat mid-roll-advertenties alleen toe bij video’s van 8 minuten of langer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O YouTube só permite anúncios no meio do vídeo em vídeos de 8 minutos ou mais."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube tillåter bara mid-roll-annonser i videor på 8 minuter eller mer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube ให้ใส่โฆษณากลางคลิปได้เฉพาะวิดีโอที่ยาว 8 นาทีขึ้นไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube, video ortası reklamlara yalnızca 8 dakika veya daha uzun videolarda izin verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube chỉ cho phép quảng cáo giữa video với video dài từ 8 phút."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube 只允许 8 分钟及以上的视频插入中插广告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube 只允許在 8 分鐘以上的影片中插入中插廣告。"
          }
        }
      }
    },
