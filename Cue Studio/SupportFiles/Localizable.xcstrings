    "Free for %lld days, then %@/month. Cancel anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجانًا لمدة %1$lld يوم، ثم %2$@/شهر. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
