    "Find pauses and repetitions. You choose what stays." : {
      "comment" : "Introduction benefit (Clean Up)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعثر على الوقفات والتكرارات. أنت تختار ما يبقى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Find pauser og gentagelser. Du vælger, hvad der bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde Pausen und Wiederholungen. Du entscheidest, was bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra pausas y repeticiones. Tú eliges qué se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repérez pauses et répétitions. Vous choisissez ce qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ठहराव और दोहराव खोजें। क्या रहेगा, यह आप तय करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temukan jeda dan pengulangan. Kamu yang memilih apa yang dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova pause e ripetizioni. Scegli tu cosa resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間や言い直しを見つけます。残す部分はあなたが選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈춤과 반복을 찾아요. 무엇을 남길지는 직접 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finn pauser og gjentakelser. Du velger hva som blir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vind pauzes en herhalingen. Jij kiest wat blijft."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontre pausas e repetições. Você escolhe o que fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitta pauser och upprepningar. Du väljer vad som blir kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หาช่วงหยุดและคำซ้ำ คุณเลือกเองว่าจะเก็บอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duraklamaları ve tekrarları bul. Neyin kalacağını sen seçersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tìm khoảng dừng và đoạn lặp. Bạn chọn đoạn nào giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出停顿和重复，保留什么由你决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找出停頓和重複，保留什麼由你決定。"
          }
        }
      }
    },
