    "More removes shades of the screen that are further from its color." : {
      "comment" : "Quick edit › Background › Tolerance: what moving it up does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلما رفعته أزال درجات أبعد عن لون الشاشة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mere fjerner nuancer af skærmen, der ligger længere fra dens farve."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr entfernt auch Töne des Screens, die weiter von seiner Farbe entfernt sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al subirla, quita tonos de la pantalla más alejados de su color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus retire des nuances du fond plus éloignées de sa couleur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादा करने पर स्क्रीन के वे शेड भी हटते हैं जो उसके रंग से दूर हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lebih tinggi menghapus nuansa layar yang lebih jauh dari warnanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di più rimuove sfumature dello schermo più lontane dal suo colore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上げるほど、バックの色から離れた色合いも取り除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높일수록 스크린 색에서 더 먼 색조까지 지워요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer fjerner nyanser av skjermen som ligger lenger fra fargen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer verwijdert tinten van het scherm die verder van de kleur af liggen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores maiores removem tons da tela mais distantes da cor dela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mer tar bort nyanser av skärmen som ligger längre från dess färg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มากขึ้นจะลบเฉดของฉากที่ห่างจากสีของฉากมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artırınca perdenin rengine daha uzak tonlar da silinir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng lên sẽ xóa cả những sắc độ xa màu phông hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调高会去除离幕布颜色更远的色调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "調高會去除離幕布顏色更遠的色調。"
          }
        }
      }
    },
