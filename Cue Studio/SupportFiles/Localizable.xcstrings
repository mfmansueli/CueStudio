    "Nobody hands you a manual. Here are a few things worth knowing." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد يعطيك دليل استخدام. إليك بعض الأشياء التي تستحق المعرفة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen giver dig en manual. Her er et par ting, der er værd at vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand gibt dir eine Anleitung. Hier sind ein paar Dinge, die man wissen sollte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie te da un manual. Aquí van algunas cosas que vale la pena saber."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne vous donne de mode d’emploi. Voici quelques trucs bons à savoir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई आपको मैनुअल नहीं देता। ये कुछ बातें जानने लायक हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak ada yang kasih buku panduan. Ini beberapa hal yang perlu kamu tahu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ti dà un manuale. Ecco alcune cose che vale la pena sapere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も取扱説明書はくれません。知っておきたいことをいくつか。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무도 설명서를 주지 않아요. 알아 두면 좋은 몇 가지예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen gir deg en bruksanvisning. Her er noen ting som er verdt å vite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand geeft je een handleiding. Dit zijn een paar dingen die goed zijn om te weten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém te entrega um manual. Aqui vão algumas coisas que vale saber."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen ger dig en manual. Här är några saker som är bra att veta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครให้คู่มือมา นี่คือเรื่องที่ควรรู้ไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimse sana bir kullanım kılavuzu vermiyor. İşte bilmeye değer birkaç şey."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai đưa bạn sách hướng dẫn cả. Đây là vài điều đáng biết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没人会给你一本说明书。这几件事值得知道。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒人會給你一本說明書。這幾件事值得知道。"
          }
        }
      }
    },
    "Nobody speaks while it plays" : {
      "comment" : "Volume panel on a music clip: detail under \"Lower under voice\" saying who the music goes down under: no clip with sound and no voice-over plays while this music plays, so it never goes down",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد يتكلم أثناء تشغيلها"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen taler, mens den spiller"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand spricht, während sie läuft"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie habla mientras suena"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne ne parle pendant la lecture"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके चलते समय कोई नहीं बोलता"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang bicara saat musik diputar"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno parla mentre suona"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中に話す声はありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생 중에 말하는 사람이 없어요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen snakker mens den spilles"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand praat terwijl het speelt"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém fala enquanto ela toca"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen pratar medan den spelas"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครพูดระหว่างที่เพลงเล่น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çalarken kimse konuşmuyor"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai nói khi nhạc phát"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放期间无人说话"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放期間無人說話"
          }
        }
      }
    },
    "Nobody talks about this, so I will." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أحد يتحدث عن هذا، لذا سأفعل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen taler om det her, så det gør jeg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand redet darüber, also tu ich es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie habla de esto, así que lo haré yo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’en parle, alors je vais le faire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बारे में कोई बात नहीं करता, तो आज इस पर बात होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang membahas ini, jadi aku yang bahas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ne parla, quindi lo faccio io."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誰も言わないので、私が言います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무도 말 안 하니까 제가 할게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen snakker om dette, så det gjør jeg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand praat hierover, dus ik doe het."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém fala disso, então eu vou falar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen pratar om det här, så det gör jag."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครพูดเรื่องนี้ งั้นฉันพูดเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimse bundan bahsetmiyor, o yüzden ben bahsedeceğim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai nói chuyện này, nên mình sẽ nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没人说，那我来说。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒人談這件事，那我來說。"
          }
        }
      }
    },
