        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 翻译在你的 iPhone 上翻译。不会发送任何内容。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
