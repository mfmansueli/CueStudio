    "Open it to keep going. Record it when you’re ready." : {
      "comment" : "Reminder body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتحه لتتابع. سجّله عندما تكون مستعدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn det for at fortsætte. Optag det, når du er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne es, um weiterzumachen. Nimm es auf, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrelo para seguir. Grábalo cuando estés listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez-le pour continuer. Filmez-le quand vous êtes prêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगे बढ़ने के लिए खोलें। तैयार होने पर रिकॉर्ड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka untuk melanjutkan. Rekam saat kamu siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprilo per andare avanti. Registralo quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開いて続けましょう。準備ができたら録画を。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
