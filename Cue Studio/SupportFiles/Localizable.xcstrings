            "value" : "自分のペースで読みましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 속도로 읽으세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les i ditt eget tempo"
          }
        },
        "nl" : {
          "stringUnit" : {
