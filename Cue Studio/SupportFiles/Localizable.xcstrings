    "Track it if what it hides moves." : {
      "comment" : "Blur area status detail",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبّعها إن كان ما تخفيه يتحرّك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg det, hvis det, det skjuler, bevæger sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolge ihn, wenn sich das Verborgene bewegt."
          }
