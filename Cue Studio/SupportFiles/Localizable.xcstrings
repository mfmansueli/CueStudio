    "Tries it on the whole video. Apply keeps it." : {
      "comment" : "VoiceOver hint on a template card",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجربه على الفيديو كله. تطبيق يحتفظ به."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver den på hele videoen. Anvend beholder den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiert es am ganzen Video aus. Anwenden behält es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba en todo el video. Aplicar la mantiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’essaie sur toute la vidéo. Appliquer la garde."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे वीडियो पर आज़माता है। लागू करें इसे रखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencobanya di seluruh video. Terapkan menyimpannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo prova su tutto il video. Applica lo tiene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画全体で試します。「適用」で残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상 전체에 적용해 봐요. 적용하면 유지돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver den på hele videoen. Bruk beholder den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeert het op de hele video. Toepassen houdt het."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimenta no vídeo inteiro. Aplicar mantém."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provar den på hela videon. Använd behåller den."
