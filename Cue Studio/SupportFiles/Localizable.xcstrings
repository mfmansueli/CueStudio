        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekten lager sitt eget lys og sin egen skygge. Velg en stil uten den for å bruke bakgrunn eller kontur."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het effect maakt zijn eigen licht en schaduw. Kies een stijl zonder effect voor een achtergrond of omlijning."
