    "Tap again for “I never use”. Touch and hold an ending to make it the main one." : {
      "comment" : "My Cue Voice › endings, with two endings used: how to mark one never used and how to pick the main one",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المس مرة أخرى لـ «لا أستخدمه أبدًا». المس مطولًا خاتمة لتجعلها الرئيسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk igen for “Jeg bruger aldrig”. Hold fingeren på en afslutning for at gøre den til den vigtigste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe noch mal für „Nutze ich nie“. Halte ein Ende gedrückt, um es zum Hauptende zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca otra vez para «Nunca lo uso». Mantén pulsado un cierre para hacerlo el principal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez à nouveau pour « Je ne l’utilise jamais ». Maintenez une fin pour en faire la principale."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“मैं कभी इस्तेमाल नहीं करता/करती” के लिए फिर टैप करें। किसी अंत को मुख्य बनाने के लिए उसे दबाकर रखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk lagi untuk “Aku tidak pernah pakai”. Tekan lama sebuah penutup untuk menjadikannya yang utama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca di nuovo per «Non lo uso mai». Tieni premuto un finale per renderlo il principale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一度タップで「使わない」。締め方を長押しするとメインにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 더 탭하면 ‘절대 안 써요’. 마무리를 길게 누르면 기본으로 설정돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk igjen for «Jeg bruker aldri». Hold inne en avslutning for å gjøre den til hovedavslutningen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik nog eens voor ‘Gebruik ik nooit’. Houd een afsluiting ingedrukt om er de hoofdafsluiting van te maken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque de novo para “Nunca uso”. Toque e segure um fecho para torná-lo o principal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck igen för ”Jag använder aldrig”. Håll ned en avslutning för att göra den till huvudavslutningen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะอีกครั้งสำหรับ “ฉันไม่เคยใช้” แตะค้างที่การปิดท้ายเพื่อตั้งเป็นแบบหลัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Asla kullanmam” için tekrar dokun. Ana kapanış yapmak için bir kapanışa basılı tut."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm lần nữa để chọn “Tôi không bao giờ dùng”. Chạm và giữ một cách kết để đặt làm chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再点一次设为“我从不用”。长按一种结尾可设为主要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再點一次設為「我從不用」。長按一種結尾可設為主要。"
          }
        }
      }
    },
