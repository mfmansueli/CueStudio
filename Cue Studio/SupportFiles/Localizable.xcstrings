    "Too long for Apple Intelligence on this iPhone. Try a shorter script, or one part at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص طويل جدًا على Apple Intelligence في هذا الـ iPhone. جرّب نصًا أقصر، أو جزءًا واحدًا في كل مرة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For langt til Apple Intelligence på denne iPhone. Prøv et kortere manuskript, eller én del ad gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu lang für Apple Intelligence auf diesem iPhone. Versuch ein kürzeres Skript oder einen Teil nach dem anderen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demasiado largo para Apple Intelligence en este iPhone. Prueba con un guion más corto o una parte cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop long pour Apple Intelligence sur cet iPhone. Essayez un script plus court, ou une partie à la fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर Apple Intelligence के लिए यह बहुत लंबा है। छोटी स्क्रिप्ट आज़माएँ, या एक बार में एक हिस्सा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terlalu panjang untuk Apple Intelligence di iPhone ini. Coba naskah yang lebih pendek, atau satu bagian setiap kali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Troppo lungo per Apple Intelligence su questo iPhone. Prova un copione più corto, o una parte alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneのApple Intelligenceには長すぎます。短い台本にするか、一部ずつ試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 Apple Intelligence에는 너무 길어요. 더 짧은 대본이나 한 부분씩 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For langt for Apple Intelligence på denne iPhonen. Prøv et kortere manus, eller én del om gangen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te lang voor Apple Intelligence op deze iPhone. Probeer een korter script, of één deel tegelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longo demais para a Apple Intelligence neste iPhone. Tente um roteiro mais curto, ou uma parte de cada vez."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För långt för Apple Intelligence på den här iPhonen. Prova ett kortare manus, eller en del i taget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยาวเกินไปสำหรับ Apple Intelligence บน iPhone เครื่องนี้ ลองใช้สคริปต์ที่สั้นลง หรือทีละส่วน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’daki Apple Intelligence için çok uzun. Daha kısa bir senaryo dene ya da her seferinde bir bölüm."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá dài với Apple Intelligence trên iPhone này. Hãy thử kịch bản ngắn hơn, hoặc từng phần một."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对这台 iPhone 上的 Apple Intelligence 来说太长了。试试更短的脚本，或一次处理一部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這份腳本太長，這部 iPhone 上的 Apple Intelligence 處理不了。請試試較短的腳本，或一次處理一段。"
          }
        }
      }
    },
