    "Nothing leaves your iPhone: the picture is read here and never kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء يغادر iPhone: تُقرأ الصورة هنا ولا تُحفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts verlässt dein iPhone: Das Bild wird hier gelesen und nie gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sale de tu iPhone: la imagen se lee aquí y nunca se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ne quitte ton iPhone : l’image est lue ici et jamais conservée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी iPhone से बाहर नहीं जाता: तस्वीर यहीं पढ़ी जाती है और रखी नहीं जाती।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang keluar dari iPhone: gambar dibaca di sini dan tidak disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla lascia il tuo iPhone: l’immagine viene letta qui e non conservata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneの外には何も出ません。画像はここで読み取られ、保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 밖으로 나가는 것은 없어요. 사진은 여기서 읽고 저장하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sai do seu iPhone: a imagem é lida aqui e nunca é guardada."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีอะไรออกจาก iPhone ภาพถูกอ่านที่นี่และไม่ถูกเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone’undan hiçbir şey çıkmaz: görsel burada okunur ve saklanmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không gì rời khỏi iPhone: ảnh được đọc tại đây và không được lưu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内容不会离开你的 iPhone：图片在本机读取，不会保存。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er verlaat niets je iPhone: de afbeelding wordt hier gelezen en nooit bewaard."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget lämnar din iPhone: bilden läses här och sparas aldrig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet forlader din iPhone: billedet læses her og gemmes aldrig."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting forlater iPhonen din: bildet leses her og lagres aldri."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會有任何內容離開你的 iPhone：圖片在這裡讀取，且不會被保存。"
          }
        }
      }
    },
