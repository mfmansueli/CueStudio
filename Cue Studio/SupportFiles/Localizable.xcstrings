    "Your light. It grows with every video you share. No photo needed." : {
      "comment" : "Your universe: the core sheet (the creator's light and the next milestone). No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضوؤك. يكبر مع كل فيديو تشاركه، بلا حاجة إلى صورة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lys. Det vokser med hver video, du deler. Intet foto nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Licht. Es wächst mit jedem Video, das du teilst, ganz ohne Foto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu luz. Crece con cada video que compartes, sin necesidad de foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre lumière. Elle grandit à chaque vidéo partagée. Pas besoin de photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रोशनी। हर वीडियो शेयर करने पर यह बढ़ती है, फ़ोटो की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahayamu. Tumbuh dengan setiap video yang kamu bagikan, tanpa perlu foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua luce. Cresce a ogni video che condividi, senza bisogno di foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの光。動画を共有するたびに大きくなります。写真は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 빛. 영상을 공유할 때마다 커져요. 사진은 필요 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyset ditt. Det vokser for hver video du deler, uten at du trenger et bilde."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw licht. Het groeit met elke video die je deelt, zonder foto."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua luz. Ela cresce a cada vídeo que você compartilha, sem precisar de foto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt ljus. Det växer med varje video du delar, inget foto behövs."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสงของคุณ เติบโตทุกครั้งที่แชร์วิดีโอ ไม่ต้องใช้รูปถ่าย"
