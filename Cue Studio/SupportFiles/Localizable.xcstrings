        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ तब जब चरण 2 की स्क्रिप्ट प्लेटफ़ॉर्म की लंबाई से काफ़ी ज़्यादा हो: वह स्क्रिप्ट, लंबाई और आप कैसे बोलते हैं।"
