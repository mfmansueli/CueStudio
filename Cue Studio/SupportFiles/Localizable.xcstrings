    "List the steps in plain words, separated by commas. Cue turns them into a numbered walkthrough with a hook up top and a save-this ending." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب الخطوات بكلمات بسيطة مفصولة بفواصل. يحوّلها Cue إلى شرح مرقّم بافتتاحية في البداية ودعوة للحفظ في النهاية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenn die Schritte in einfachen Worten, durch Kommas getrennt. Cue macht daraus eine nummerierte Anleitung mit Hook am Anfang und „Speicher dir das“ am Ende."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enumera los pasos con palabras sencillas, separados por comas. Cue los convierte en una guía numerada con un gancho al principio y un “guárdalo” al final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listez les étapes simplement, séparées par des virgules. Cue en fait un tuto numéroté avec une accroche au début et un « enregistrez-le » à la fin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टेप्स आसान शब्दों में, कॉमा से अलग करके लिखें। Cue इन्हें ऊपर हुक और आख़िर में “इसे सेव करें” के साथ नंबर वाले गाइड में बदल देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis langkah-langkahnya dengan kata sederhana, dipisahkan koma. Cue mengubahnya jadi panduan bernomor dengan hook di awal dan ajakan menyimpan di akhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elenca i passaggi con parole semplici, separati da virgole. Cue li trasforma in una guida numerata con un gancio all’inizio e un “salvalo” alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手順をやさしい言葉で、カンマで区切って書いてください。Cueが冒頭にフック、最後に「保存してね」がある番号付きの手順にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단계를 쉬운 말로, 쉼표로 구분해 적으세요. Cue가 맨 앞에 훅, 끝에 ‘저장해 두세요’가 있는 번호 안내로 만들어 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste os passos com palavras simples, separados por vírgulas. O Cue transforma tudo num passo a passo numerado, com um gancho no começo e um “salva esse” no fim."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขียนขั้นตอนเป็นคำง่ายๆ คั่นด้วยจุลภาค Cue จะเปลี่ยนเป็นคู่มือแบบมีหมายเลข มีฮุกตอนต้นและชวนกดบันทึกตอนท้าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adımları virgülle ayırarak sade bir dille yaz. Cue bunları başta bir kanca ve sonda “kaydet” çağrısı olan numaralı bir rehbere dönüştürür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liệt kê các bước bằng lời đơn giản, cách nhau bằng dấu phẩy. Cue biến chúng thành hướng dẫn đánh số, có hook ở đầu và lời nhắc lưu lại ở cuối."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用简单的话列出步骤，以逗号分隔。Cue 会把它们变成带编号的教程，开头有钩子，结尾提醒收藏。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Som de stappen op in gewone woorden, gescheiden door komma’s. Cue maakt er een genummerde uitleg van met bovenaan een hook en onderaan een bewaar-dit-einde."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räkna upp stegen med vanliga ord, åtskilda av kommatecken. Cue gör en numrerad genomgång med en hook överst och ett spara-det-här-slut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opregn trinene i almindelige ord, adskilt med kommaer. Cue gør det til en nummereret gennemgang med et hook øverst og en gem-denne-afslutning."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "List opp stegene med vanlige ord, atskilt med komma. Cue gjør det til en nummerert gjennomgang med en hook øverst og en lagre-denne-avslutning."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用簡單的字詞列出步驟，以逗號分隔。Cue 會整理成編號教學，開頭是開場鉤子，結尾邀請收藏。"
          }
        }
      }
