          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写下你想说的话… 点按 [ ] 添加提示。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
