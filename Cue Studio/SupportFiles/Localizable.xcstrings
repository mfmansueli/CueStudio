    "You can change this anytime in Settings. Cue never records until you tap Record." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير هذا في أي وقت من الإعدادات. لا يسجّل Cue أبدًا قبل أن تضغط تسجيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ændre det her når som helst i Indstillinger. Cue optager aldrig, før du trykker på Optag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kannst du jederzeit in den Einstellungen ändern. Cue nimmt nie auf, bevor du auf Aufnehmen tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo cuando quieras en Ajustes. Cue nunca graba hasta que tocas Grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux le changer à tout moment dans Réglages. Cue n’enregistre jamais avant que tu touches Enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसे कभी भी सेटिंग्स में बदल सकते हैं। रिकॉर्ड दबाने तक Cue कभी रिकॉर्ड नहीं करता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu bisa mengubahnya kapan saja di Pengaturan. Cue tidak pernah merekam sampai kamu mengetuk Rekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiarlo in qualsiasi momento in Impostazioni. Cue non registra mai finché non tocchi Registra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でいつでも変更できます。「録画」をタップするまで、Cueが録画することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 언제든 바꿀 수 있어요. 녹화를 누르기 전에는 Cue가 절대 녹화하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan endre dette når som helst i Innstillinger. Cue tar aldri opp før du trykker på Ta opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit op elk moment wijzigen in Instellingen. Cue neemt nooit iets op totdat je op Opnemen tikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode mudar isso a qualquer momento em Ajustes. O Cue nunca grava até você tocar em Gravar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ändra det här när som helst i Inställningar. Cue spelar aldrig in förrän du trycker på Spela in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปลี่ยนได้ทุกเมื่อในการตั้งค่า Cue จะไม่บันทึกจนกว่าคุณจะแตะบันทึก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu istediğin zaman Ayarlar’dan değiştirebilirsin. Kaydet’e dokunmadan Cue asla kayıt yapmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể đổi bất cứ lúc nào trong Cài đặt. Cue không bao giờ quay cho đến khi bạn chạm Quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在“设置”中更改。点按“录制”之前，Cue 绝不会录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你隨時都能在「設定」中更改。在你點「錄影」之前，Cue 絕不會錄製任何內容。"
          }
        }
      }
    },
    "You decide what leaves" : {
