        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شيء تقوله دائمًا. يدمجه الذكاء الاصطناعي في النصوص الجديدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noget, du altid siger. AI’en væver det ind i nye manuskripter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwas, das du immer sagst. Die KI baut es in neue Skripte ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que siempre dices. La IA lo incluye en los guiones nuevos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une phrase que vous dites tout le temps. L’IA la glisse dans vos nouveaux scripts."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ ऐसा जो आप हमेशा कहते हैं। AI इसे नई स्क्रिप्ट में जोड़ देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalimat khasmu. AI akan menyelipkannya ke naskah baru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cosa che dici sempre. L’IA la inserisce nei nuovi copioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも言っているひとこと。AIが新しい台本に織り込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내가 늘 하는 말. AI가 새 대본에 자연스럽게 넣어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noe du alltid sier. AI-en veier det inn i nye manus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iets wat je altijd zegt. De AI verwerkt het in nieuwe scripts."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algo que você sempre fala. A IA encaixa nos roteiros novos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Något du alltid säger. AI:n väver in det i nya manus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำที่คุณพูดติดปาก AI จะใส่ไว้ในสคริปต์ใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
