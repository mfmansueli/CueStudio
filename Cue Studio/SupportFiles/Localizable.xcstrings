          }
        }
      }
    },
    "With these few things in your pantry, dinner is always possible." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بهذه الأشياء القليلة في مطبخك، يكون العشاء ممكنًا دائمًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med de her få ting i skabet kan du altid lave aftensmad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit diesen paar Dingen im Vorrat ist ein Abendessen immer drin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con estas pocas cosas en tu despensa, la cena siempre es posible."
          }
