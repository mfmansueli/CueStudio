          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschreven met Apple Intelligence. AI kan feiten fout hebben — controleer data, namen en cijfers voordat je opneemt."
          }
        },
        "sv" : {
          "stringUnit" : {
