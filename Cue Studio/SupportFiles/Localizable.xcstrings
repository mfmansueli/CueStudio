          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne optagelse har intet manuskript, så kun ord sagt to gange i træk findes som gentagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahme hat kein Skript, daher gelten nur zweimal hintereinander gesagte Wörter als Wiederholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta toma no tiene guion, así que solo se encuentran como repeticiones las palabras dichas dos veces seguidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette prise n’a pas de script : seuls les mots dits deux fois de suite sont trouvés comme répétitions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस टेक की कोई स्क्रिप्ट नहीं है, इसलिए दोहराव में सिर्फ़ लगातार दो बार बोले गए शब्द मिलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take ini tidak punya naskah, jadi hanya kata yang diucapkan dua kali berturut-turut yang ditemukan sebagai pengulangan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa ripresa non ha copione, quindi come ripetizioni si trovano solo le parole dette due volte di fila."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテイクには台本がないため、続けて2回言った言葉だけを繰り返しとして見つけます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 테이크에는 대본이 없어서, 연달아 두 번 말한 단어만 반복으로 찾아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette opptaket har ikke manus, så bare ord sagt to ganger på rad blir funnet som gjentakelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze take heeft geen script, dus alleen woorden die twee keer achter elkaar zijn gezegd, worden als herhaling gevonden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este take não tem roteiro, então só palavras ditas duas vezes seguidas aparecem como repetição."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här tagningen har inget manus, så bara ord som sägs två gånger i rad hittas som upprepningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เทคนี้ไม่มีสคริปต์ จึงพบคำพูดซ้ำได้เฉพาะคำที่พูดสองครั้งติดกัน"
