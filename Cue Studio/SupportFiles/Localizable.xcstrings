    "Drafted from your voice, so people can follow muted." : {
      "comment" : "Auto captions introduction",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسودة تُكتب من صوتك، ليتابعك الناس دون صوت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udkast ud fra din stemme, så folk kan følge med uden lyd."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus deiner Stimme entworfen, damit man auch stumm folgen kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un borrador hecho con tu voz, para que te sigan sin sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rédigés à partir de votre voix, pour suivre sans le son."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ से ड्राफ़्ट, ताकि लोग बिना आवाज़ के समझ सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draf dibuat dari suaramu, agar orang bisa mengikutinya meski suara dimatikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bozza dalla tua voce, così ti seguono anche senza audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの声から下書き。音なしでも伝わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리로 만든 초안이라 소리 없이도 따라올 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utkast laget fra stemmen din, så folk kan følge med uten lyd."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als concept gemaakt uit je stem, zodat mensen ook zonder geluid kunnen volgen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rascunhadas a partir da sua voz, para acompanhar sem som."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utkast utifrån din röst, så att alla kan följa med utan ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ร่างจากเสียงคุณ ให้คนดูตามได้แม้ปิดเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinden taslak olarak hazırlanır; ses kapalıyken de takip edilebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soạn nháp từ giọng bạn để người xem theo dõi khi tắt tiếng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据你的声音起草，静音也能看懂。"
          }
