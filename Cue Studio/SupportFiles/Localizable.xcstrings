    "Hard to read on bright scenes. Add a background, a thick outline or a halo." : {
      "comment" : "Warning in Caption style › Adjust when the look would fail contrast over a white picture.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصعب قراءته على المشاهد الساطعة. أضف خلفية أو حدًا خارجيًا سميكًا أو هالة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svær at læse på lyse scener. Tilføj en baggrund, en tyk kontur eller en halo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf hellen Szenen schwer lesbar. Füge einen Hintergrund, eine dicke Kontur oder einen Halo hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuesta leerlo en escenas claras. Añade un fondo, un contorno grueso o un halo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficile à lire sur les scènes claires. Ajoutez un arrière-plan, un contour épais ou un halo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चमकीले दृश्यों पर पढ़ना मुश्किल है। बैकग्राउंड, मोटी आउटलाइन या हेलो जोड़ें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sulit dibaca di adegan terang. Tambahkan latar, garis tepi tebal, atau halo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difficile da leggere sulle scene chiare. Aggiungi uno sfondo, un contorno spesso o un alone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明るい場面では読みにくくなります。背景、太い輪郭、またはハローを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밝은 장면에서는 읽기 어려워요. 배경, 두꺼운 외곽선 또는 후광을 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vanskelig å lese på lyse scener. Legg til en bakgrunn, en tykk kontur eller en halo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slecht leesbaar op lichte beelden. Voeg een achtergrond, een dikke omtrek of een halo toe."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Difícil de ler em cenas claras. Adicione um fundo, um contorno grosso ou um halo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svårläst på ljusa scener. Lägg till en bakgrund, en tjock kontur eller en halo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อ่านยากบนฉากที่สว่าง เพิ่มพื้นหลัง เส้นขอบหนา หรือรัศมี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlak sahnelerde okunması zor. Arka plan, kalın dış çizgi ya da hale ekle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khó đọc trên cảnh sáng. Hãy thêm nền, viền dày hoặc quầng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在明亮画面上难以阅读。请添加背景、粗描边或光环。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在明亮畫面上不易閱讀。請加上背景、粗外框或光環。"
          }
        }
      }
    },
