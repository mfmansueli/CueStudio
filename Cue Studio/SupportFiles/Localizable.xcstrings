    "Tap Done in the editor, or pick a best take — it lands here, ready to post." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «تم» في المحرر أو اختر أفضل لقطة — سيظهر هنا جاهزًا للنشر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Færdig i editoren, eller vælg en bedste optagelse — den lander her, klar til at blive postet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe im Editor auf „Fertig“ oder wähle einen besten Take — dann landet das Video hier, bereit zum Posten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca OK en el editor o elige una toma como la mejor: aparecerá aquí, lista para publicar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez OK dans l’éditeur ou choisissez une meilleure prise : la vidéo arrive ici, prête à publier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एडिटर में हो गया दबाएँ या बेस्ट टेक चुनें — वीडियो यहाँ पोस्ट के लिए तैयार दिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk Selesai di editor, atau pilih take terbaik — videonya muncul di sini, siap diposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Fine nell’editor o scegli una ripresa migliore: il video arriva qui, pronto da pubblicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エディタで「完了」をタップするか、ベストテイクを選ぶと、投稿の準備ができた動画がここに並びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집기에서 완료을(를) 누르거나 베스트 테이크를 고르면 게시할 준비가 된 영상이 여기에 나타나요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på Ferdig i editoren, eller velg et beste opptak — det havner her, klart til å postes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Gereed in de editor, of kies een beste opname — het komt hier terecht, klaar om te posten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em OK no editor ou escolha um melhor take: ele aparece aqui, pronto para postar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Klar i redigeraren, eller välj en bästa tagning — den hamnar här, redo att postas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเสร็จสิ้นในตัวตัดต่อ หรือเลือกเทคที่ดีที่สุด แล้ววิดีโอจะมาอยู่ที่นี่พร้อมโพสต์"
