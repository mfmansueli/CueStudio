        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec ces quelques produits dans votre placard, le dîner est toujours possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रसोई में ये कुछ चीज़ें हों, तो डिनर हमेशा बन सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan beberapa bahan ini di dapur, makan malam selalu bisa dibuat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con queste poche cose in dispensa, la cena è sempre possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これだけあれば、いつでも夕食は作れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것들만 있으면 언제든 저녁을 만들 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
