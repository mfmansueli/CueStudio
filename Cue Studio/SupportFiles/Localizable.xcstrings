    "Platform rules change — presets update automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قواعد المنصات تتغير — الإعدادات المسبقة تتحدث تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plattformregeln ändern sich – Presets werden automatisch aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas de las plataformas cambian — los preajustes se actualizan solos."
