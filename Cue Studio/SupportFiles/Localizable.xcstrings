    "Great, another morning routine. Except this one works." : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رائع، روتين صباحي آخر. إلا أن هذا ينجح فعلًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fedt, endnu en morgenrutine. Bortset fra at den her virker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super, noch eine Morgenroutine. Nur dass diese hier funktioniert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genial, otra rutina de mañana. Solo que esta sí funciona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super, encore une routine du matin. Sauf que celle-ci marche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वाह, एक और सुबह की दिनचर्या। फ़र्क बस इतना कि यह काम करती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagus, rutinitas pagi lagi. Bedanya, yang ini berhasil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantastico, un’altra routine mattutina. Solo che questa funziona davvero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "また朝のルーティンか、と思いますよね。でもこれは効きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또 아침 루틴이냐고요? 이건 진짜 효과가 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flott, enda en morgenrutine. Bortsett fra at denne funker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mooi, nog een ochtendroutine. Alleen werkt deze wel."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótimo, mais uma rotina de manhã. Só que esta funciona."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppen, ännu en morgonrutin. Förutom att den här funkar."
          }
