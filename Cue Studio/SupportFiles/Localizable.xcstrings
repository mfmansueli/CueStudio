    "Make it shorter, or record as is. You can trim later." : {
      "comment" : "Script page: the sheet when the script is longer than the platform's ideal. No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصره، أو سجّل كما هو، ويمكنك تشذيبه لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør det kortere, eller optag, som det er. Du kan trimme senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürze den Text oder nimm ihn so auf. Kürzen kannst du auch später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo más corto o grábalo así: puedes recortar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcissez-le ou filmez tel quel : vous pourrez raccourcir ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे छोटा करें या ऐसे ही रिकॉर्ड करें, बाद में ट्रिम कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persingkat, atau rekam apa adanya. Kamu bisa memangkasnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorcialo o registra così: potrai accorciare dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短くするか、このまま録画してください。あとでトリムできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 짧게 만들거나 그대로 녹화하세요. 나중에 다듬을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør det kortere, eller ta opp som det er. Du kan korte ned senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak het korter of neem het zo op. Je kunt later nog inkorten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe mais curto ou grave assim. Dá para aparar depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör det kortare eller spela in som det är. Du kan korta senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้สั้นลง หรืออัดไปเลย ค่อยตัดความยาวทีหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metni kısalt ya da olduğu gibi çek; videoyu sonra da kısaltabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút ngắn, hoặc quay luôn. Bạn có thể cắt bớt sau."
          }
        },
        "zh-Hans" : {
