        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب تغييرًا آخر، أو ألغِ وافتح اللقطة مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuch eine andere Änderung oder brich ab und öffne den Take erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba otro cambio, o cancela y vuelve a abrir la toma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez un autre changement, ou annulez et rouvrez la prise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई और बदलाव आज़माएँ, या रद्द करके टेक फिर से खोलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba perubahan lain, atau batalkan dan buka take-nya lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova un’altra modifica, oppure annulla e riapri la ripresa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の変更を試すか、キャンセルしてテイクを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 변경을 시도하거나, 취소하고 테이크를 다시 여세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tente outra mudança, ou cancele e abra o take de novo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเปลี่ยนแบบอื่น หรือยกเลิกแล้วเปิดเทคอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir değişiklik dene veya vazgeçip çekimi yeniden aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thử thay đổi khác, hoặc hủy và mở lại cảnh quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "换一种修改，或取消后重新打开镜头。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer een andere wijziging, of annuleer en open de opname opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova en annan ändring, eller avbryt och öppna tagningen igen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en anden ændring, eller annullér og åbn optagelsen igen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv en annen endring, eller avbryt og åpne opptaket på nytt."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試試其他變更，或取消後重新開啟鏡頭。"
          }
        }
      }
    },
