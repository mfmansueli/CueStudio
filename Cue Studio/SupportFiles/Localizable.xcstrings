    "Moves this smoothing to the new engine, which goes further and lets you refine its texture." : {
      "comment" : "VoiceOver hint of Update in Video editor › Skin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل هذا التنعيم إلى المحرك الجديد، الذي يذهب أبعد ويتيح لك تحسين الملمس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter denne udglatning til den nye motor, som går længere og lader dig finjustere teksturen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überträgt diese Glättung auf die neue Engine, die weiter geht und dich die Textur verfeinern lässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasa este suavizado al nuevo motor, que llega más lejos y te deja refinar la textura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe ce lissage au nouveau moteur, qui va plus loin et vous laisse affiner la texture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस स्मूदिंग को नए इंजन पर ले जाता है, जो ज़्यादा असर देता है और आपको टेक्सचर रिफ़ाइन करने देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memindahkan penghalusan ini ke mesin baru, yang lebih kuat dan memungkinkan kamu menyempurnakan teksturnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta questa levigatura sul nuovo motore, che va più a fondo e ti lascia rifinire la texture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このなめらか補正を新しいエンジンに移します。より強くかけられ、質感も微調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 보정을 새 엔진으로 옮깁니다. 더 강하게 적용되고 질감도 세부 조정할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytter denne utjevningen til den nye motoren, som går lenger og lar deg finjustere teksturen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet deze verzachting over naar de nieuwe engine, die verder gaat en je de textuur laat verfijnen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leva esta suavização para o novo motor, que vai mais longe e deixa você refinar a textura."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar den här utjämningen till den nya motorn, som går längre och låter dig finjustera texturen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ย้ายการปรับเรียบนี้ไปยังเอนจินใหม่ ซึ่งทำได้มากกว่าและให้คุณปรับพื้นผิวได้ละเอียด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yumuşatmayı daha ileri giden ve dokuya ince ayar yapmanı sağlayan yeni motora taşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyển lớp làm mịn này sang công cụ mới, mạnh hơn và cho bạn tinh chỉnh kết cấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此磨皮移到新引擎，效果更强，还能细调质感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將此磨皮移到新引擎，效果更強，還能細調質感。"
          }
        }
      }
    },
