    "You probably say it every day. Do you know where it comes from?" : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تقولها كل يوم. هل تعرف من أين أتت؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siger det sikkert hver dag. Ved du, hvor det kommer fra?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du sagst es wahrscheinlich jeden Tag. Weißt du, woher es kommt?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguro que lo dices todos los días. ¿Sabes de dónde viene?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous le dites sûrement tous les jours. Vous savez d’où ça vient ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप इसे शायद रोज़ बोलते हैं। क्या आप जानते हैं यह कहाँ से आया?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu mungkin mengucapkannya tiap hari. Tahu asalnya dari mana?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probabilmente lo dici ogni giorno. Sai da dove viene?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "たぶん毎日言っている言葉。どこから来たか知っていますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아마 매일 쓰는 말일 거예요. 어디서 왔는지 아세요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
