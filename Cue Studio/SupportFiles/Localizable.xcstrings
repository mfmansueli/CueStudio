    "Both devices need Cue and Wi-Fi or Bluetooth on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج الجهازان إلى Cue وتشغيل Wi-Fi أو Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge enheder skal have Cue og Wi-Fi eller Bluetooth slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide Geräte brauchen Cue und eingeschaltetes WLAN oder Bluetooth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ambos dispositivos necesitan Cue y Wi-Fi o Bluetooth activados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux appareils doivent avoir Cue et le Wi-Fi ou le Bluetooth activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों डिवाइस में Cue और Wi-Fi या Bluetooth चालू होना चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kedua perangkat butuh Cue dan Wi-Fi atau Bluetooth yang aktif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrambi i dispositivi hanno bisogno di Cue e di Wi-Fi o Bluetooth attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のデバイスにCueが必要で、Wi-FiまたはBluetoothをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 기기 모두 Cue가 있어야 하고 Wi-Fi 또는 Bluetooth가 켜져 있어야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begge enhetene trenger Cue og Wi-Fi eller Bluetooth på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beide apparaten hebben Cue nodig en wifi of Bluetooth aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dois dispositivos precisam do Cue e de Wi-Fi ou Bluetooth ligado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Båda enheterna behöver Cue och Wi-Fi eller Bluetooth påslaget."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทั้งสองอุปกรณ์ต้องมี Cue และเปิด Wi-Fi หรือ Bluetooth"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her iki cihazda da Cue ve Wi-Fi ya da Bluetooth açık olmalı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai thiết bị cần có Cue và bật Wi-Fi hoặc Bluetooth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两台设备都需要 Cue，并打开 Wi-Fi 或蓝牙。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "兩台裝置都需要 Cue，並開啟 Wi-Fi 或藍牙。"
          }
        }
      }
    },
