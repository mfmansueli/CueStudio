    "The export stopped when Cue left the screen. Keep Cue open and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التصدير عندما غادر Cue الشاشة. أبقِ Cue مفتوحًا وحاول مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporten stoppede, da Cue forlod skærmen. Hold Cue åben, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Export wurde gestoppt, als Cue den Bildschirm verlassen hat. Lass Cue geöffnet und versuch es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación se detuvo al salir de Cue. Mantén Cue abierto e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’exportation s’est arrêtée quand Cue a quitté l’écran. Gardez Cue ouvert et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue स्क्रीन से हटा तो एक्सपोर्ट रुक गया। Cue खुला रखें और फिर से कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekspor berhenti saat Cue meninggalkan layar. Biarkan Cue terbuka dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’esportazione si è fermata quando Cue ha lasciato lo schermo. Tieni aperta Cue e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueが画面から離れたため書き出しが止まりました。Cueを開いたまま、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 화면에서 벗어나 내보내기가 멈췄습니다. Cue를 연 채로 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksporten stoppet da Cue forlot skjermen. Hold Cue åpen og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De export stopte toen Cue het scherm verliet. Houd Cue open en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação parou quando o Cue saiu da tela. Mantenha o Cue aberto e tente de novo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporten stoppade när Cue lämnade skärmen. Håll Cue öppet och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การส่งออกหยุดเมื่อ Cue ออกจากหน้าจอ เปิด Cue ไว้แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ekrandan çıkınca dışa aktarma durdu. Cue’yu açık tut ve yeniden dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình xuất đã dừng khi Cue rời màn hình. Hãy giữ Cue mở và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 离开屏幕后导出已停止。请保持 Cue 打开并重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 離開畫面時匯出已中斷。請保持 Cue 開啟後再試一次。"
          }
        }
      }
    },
