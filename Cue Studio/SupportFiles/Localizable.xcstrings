    "They said it was the most real pitch all week" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالوا إنه كان أصدق عرض طوال الأسبوع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sagten, es war der ehrlichste Pitch der Woche"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeron que fue la propuesta más auténtica de la semana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ont dit que c’était le pitch le plus sincère de la semaine"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्होंने कहा यह पूरे हफ़्ते की सबसे सच्ची पिच थी"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka bilang ini pitch paling jujur minggu ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanno detto che era il pitch più autentico della settimana"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週いちばんリアルな提案だと言われました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 가장 진솔한 제안이었다고 했어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disseram que foi o pitch mais verdadeiro da semana"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขาบอกว่าเป็นการพรีเซนต์ที่จริงใจที่สุดของสัปดาห์"
