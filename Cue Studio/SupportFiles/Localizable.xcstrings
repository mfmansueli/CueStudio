    "Unlock with milestones. Some come with Pro." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتحها بالوصول إلى المراحل. بعضها يأتي مع Pro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lås op med milepæle. Nogle følger med Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Meilensteinen freischalten. Manche gibt es mit Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desbloquean con hitos. Algunos vienen con Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquez-les avec les jalons. Certains viennent avec Pro."
          }
