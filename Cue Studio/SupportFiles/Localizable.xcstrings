    "Your voice stays; each keeps its level for later" : {
      "comment" : "Split screen panel, Sound tab: detail under Mute all supports; the main video's voice still plays, and each support keeps its volume for when it's turned back on",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى صوتك؛ ويحتفظ كلٌّ بمستواه لوقت لاحق"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din stemme bliver; hvert indklip beholder sit niveau til senere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Stimme bleibt; jede behält ihre Lautstärke für später"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu voz se queda; cada uno guarda su nivel para después"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre voix reste. Chacun garde son niveau pour plus tard"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ बनी रहती है; हर एक का लेवल बाद के लिए रहता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaramu tetap; masing-masing menyimpan levelnya untuk nanti"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua voce resta; ognuno conserva il suo livello per dopo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの声はそのまま。それぞれの音量は後のために保たれます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리는 그대로예요. 각 음량은 나중을 위해 유지돼요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stemmen din blir; hvert innklipp beholder nivået til senere"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je stem blijft; elk houdt zijn niveau voor later"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua voz continua; cada um guarda o volume para depois"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din röst finns kvar; varje inklipp behåller sin nivå till senare"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงของคุณยังอยู่ แต่ละอันเก็บระดับเสียงไว้ใช้ภายหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesin kalır; her biri seviyesini sonrası için korur"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng bạn vẫn giữ; mỗi mục giữ mức âm lượng để dùng sau"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的声音保留；各自的音量会保留，方便以后恢复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的聲音保留；各自的音量會保留，方便之後恢復"
          }
        }
      }
    },
    "Your words appear here to review before you send." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر كلماتك هنا لتراجعها قبل الإرسال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine ord vises her, så du kan gennemse dem, før du sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Worte erscheinen hier, damit du sie vor dem Senden prüfen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus palabras aparecen aquí para que las revises antes de enviarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mots apparaissent ici pour que vous les relisiez avant d’envoyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शब्द यहाँ दिखते हैं, ताकि भेजने से पहले आप उन्हें जाँच सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata-katamu muncul di sini agar bisa kamu periksa sebelum dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue parole compaiono qui, così puoi rivederle prima di inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話した言葉がここに表示されます。送信する前に確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말한 내용이 여기에 표시되며, 보내기 전에 확인할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene dine vises her så du kan gå gjennom dem før du sender."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je woorden verschijnen hier zodat je ze kunt nalopen voordat je verstuurt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas palavras aparecem aqui para você revisar antes de enviar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina ord visas här så att du kan granska dem innan du skickar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำที่คุณพูดจะแสดงที่นี่ให้ตรวจดูก่อนส่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Söylediklerin burada görünür, göndermeden önce gözden geçirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lời bạn nói hiện ở đây để bạn xem lại trước khi gửi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说的话会显示在这里，发送前可以先检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你說的話會顯示在這裡，送出前可以先檢查。"
          }
        }
      }
    },
