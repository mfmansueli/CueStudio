    "Some money mistakes are easy to make in your twenties. Let’s avoid them." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض الأخطاء المالية سهلة الوقوع فيها في العشرينات. لنتجنبها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle pengefejl er nemme at begå i 20’erne. Lad os undgå dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Geldfehler passieren mit zwanzig ganz leicht. Lass sie uns vermeiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos errores de dinero son fáciles de cometer a los veintitantos. Evitémoslos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines erreurs d’argent sont faciles à faire à la vingtaine. Évitons-les."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीस की उम्र में पैसों की कुछ गलतियाँ आसानी से हो जाती हैं। चलिए उनसे बचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa kesalahan keuangan gampang terjadi di usia 20-an. Yuk hindari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni errori con i soldi sono facili da fare a vent’anni. Evitiamoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "20代でやりがちなお金の失敗があります。避けていきましょう。"
