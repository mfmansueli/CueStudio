    "Closer to the %@ goal · now %@" : {
      "comment" : "Toast when Fit to time or a platform version did not reach the length: the range asked (like “1:00 to 1:30”), then the length it has now. No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقرب إلى هدف %1$@ · الآن %2$@"
          }
        },
        "da" : {
