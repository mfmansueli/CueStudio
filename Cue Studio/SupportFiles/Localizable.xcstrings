    "“Let’s break down why.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«لنفكّك السبب.»"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Lad os gennemgå hvorfor.”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Schauen wir uns an, warum.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Veamos por qué.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Voyons pourquoi. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“चलिए देखते हैं क्यों।”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mari kita bahas kenapa.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vediamo perché.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「なぜなのか、見ていきましょう。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“왜 그런지 하나씩 볼게요.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La oss gå gjennom hvorfor.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Ik leg je uit waarom.”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos entender o porquê.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Låt oss gå igenom varför.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“มาดูกันว่าทำไม”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nedenini birlikte inceleyelim.”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Cùng phân tích vì sao nhé.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们来拆解一下原因。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我們來拆解原因。」"
          }
        }
      }
    },
    "“Let’s slow down for a second.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«لنهدأ قليلاً.»"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Lad os sætte tempoet lidt ned.”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Machen wir kurz mal langsam.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos a ir más despacio un segundo.”"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ralentissons une seconde. »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“एक पल रुककर धीमे चलते हैं।”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Pelan-pelan dulu sebentar.”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Rallentiamo un attimo.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ちょっとだけ、ゆっくりしよう。」"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“잠깐 천천히 가 볼게요.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«La oss senke tempoet et øyeblikk.»"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Laten we het even rustig aan doen.”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Vamos desacelerar um segundo.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Vi saktar ner en sekund.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“มาช้าลงสักนิดนะ”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Bir saniye yavaşlayalım.”"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mình chậm lại một chút nhé.”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“我们先放慢一下。”"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「我們先慢一下。」"
          }
        }
      }
    },
    "“My alarm and I are not friends.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أنا والمنبّه لسنا صديقين.»"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Mit vækkeur og jeg er ikke venner.”"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Mein Wecker und ich sind keine Freunde.“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Mi despertador y yo no somos amigos.”"
          }
