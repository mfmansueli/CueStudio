    "Forget the viral gadgets. These kitchen tricks just work." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسَ الأدوات الرائجة. حيل المطبخ هذه تنجح ببساطة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem de virale gadgets. De her køkkentricks virker bare."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergiss die viralen Gadgets. Diese Küchentricks funktionieren einfach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvida los gadgets virales. Estos trucos de cocina simplemente funcionan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oubliez les gadgets viraux. Ces astuces de cuisine marchent, tout simplement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वायरल गैजेट्स भूल जाइए। रसोई के ये ट्रिक्स बस काम करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lupakan gadget viral. Trik dapur ini memang berhasil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimentica i gadget virali. Questi trucchi in cucina funzionano e basta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話題のガジェットは忘れて。このキッチンの技はちゃんと使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유행하는 주방 기구는 잊으세요. 이 꿀팁들은 그냥 통해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glem de virale dingsene. Disse kjøkkentriksene bare funker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergeet de virale gadgets. Deze keukentrucs werken gewoon."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esqueça os gadgets virais. Esses truques de cozinha simplesmente funcionam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glöm de virala prylarna. De här köksknepen bara funkar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลืมอุปกรณ์ไวรัลไปได้เลย เคล็ดลับครัวพวกนี้ได้ผลจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viral aletleri unut. Bu mutfak püf noktaları gerçekten işe yarıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quên mấy món đồ viral đi. Những mẹo bếp này thực sự hiệu quả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘掉那些爆款小工具吧。这些厨房技巧真的管用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忘掉那些爆紅小工具吧。這些廚房技巧真的管用。"
          }
        }
      }
    },
