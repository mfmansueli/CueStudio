    "Fills the %@ of the one it replaces · place and settings stay" : {
      "comment" : "Note when picking the part of a video that replaces a photo or video over the take: it lasts as long as the one it replaces (a duration) and keeps its place and settings",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ %@ من العنصر الذي يحلّ محلّه · يبقى المكان والإعدادات"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fylder de %@ fra det, den erstatter · placering og indstillinger bevares"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füllt die %@ des ersetzten Inhalts · Platz und Einstellungen bleiben"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupa los %@ del que reemplaza · lugar y ajustes intactos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occupe les %@ de celui qu’il remplace · emplacement et réglages conservés"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिसे बदल रहा है उसके %@ भरता है · जगह और सेटिंग्ज़ वही रहती हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengisi %@ dari yang diganti · posisi dan pengaturan tetap"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Occupa i %@ di quello che sostituisce · posizione e impostazioni restano"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "置き換える素材の%@を埋めます · 位置と設定はそのまま"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바꿀 항목의 길이(%@)를 채워요 · 위치와 설정은 그대로"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyller de %@ til det den erstatter · plassering og innstillinger beholdes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vult de %@ van wat het vervangt · plek en instellingen blijven"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocupa os %@ do que ele substitui · lugar e ajustes mantidos"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyller de %@ som det ersatta hade · plats och inställningar är kvar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เติมเต็ม %@ ของรายการที่แทนที่ · ตำแหน่งและการตั้งค่าคงเดิม"
          }
        },
