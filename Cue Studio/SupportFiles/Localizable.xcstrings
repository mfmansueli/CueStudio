    "Before anything else: I'm sorry." : {
      "comment" : "A ready-made opening line or tone of a script format, shown as an example the creator can pick and read to camera. No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أي شيء: أنا آسف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allerførst: Jeg er ked af det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem anderen: Es tut mir leid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes que nada: lo siento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant tout, je suis désolé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे पहले, मुझे माफ़ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertama-tama, aku minta maaf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di tutto: mi dispiace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず最初に、ごめんなさい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇보다 먼저, 죄송합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før noe annet: Jeg beklager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor alles: het spijt me."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de tudo: me desculpem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan något annat: jag ber om ursäkt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนอื่นเลย ขอโทษนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şeyden önce: özür dilerim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước hết, mình xin lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先，对不起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先說最重要的：我很抱歉。"
          }
        }
      }
    },
    "Before you reach for your phone tomorrow, try this instead." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن تمد يدك إلى هاتفك غدًا، جرّب هذا بدلًا من ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du griber efter telefonen i morgen, så prøv det her i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du morgen zum Handy greifst, probier stattdessen das hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mañana, antes de tomar el teléfono, prueba esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de prendre votre téléphone demain, essayez plutôt ça."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कल फ़ोन उठाने से पहले, इसकी जगह यह आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum kamu meraih ponsel besok, coba ini dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di prendere il telefono domani, prova questo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日スマホに手を伸ばす前に、代わりにこれを試してみて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 휴대폰을 집기 전에, 대신 이걸 해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du griper etter telefonen i morgen, prøv dette i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor je morgen naar je telefoon grijpt, probeer eerst dit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de pegar o celular amanhã, tente isto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du sträcker dig efter mobilen i morgon, testa det här i stället."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พรุ่งนี้ก่อนจะหยิบมือถือ ลองทำสิ่งนี้แทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarın telefonuna uzanmadan önce bunu dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
