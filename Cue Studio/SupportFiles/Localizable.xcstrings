    "It may have been deleted or damaged. The original take isn't changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تم حذفه أو تلفه. اللقطة الأصلية لم تتغير."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kan være slettet eller beskadiget. Den originale optagelse er ikke ændret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde vielleicht gelöscht oder beschädigt. Der Original-Take bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que se haya eliminado o dañado. La toma original no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il a peut-être été supprimé ou endommagé. La prise d’origine ne change pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शायद यह डिलीट या ख़राब हो गया है। ओरिजिनल टेक नहीं बदलता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mungkin sudah dihapus atau rusak. Take aslinya tidak berubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forse è stato eliminato o danneggiato. La ripresa originale non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除されたか破損した可能性があります。元のテイクは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제되었거나 손상되었을 수 있어요. 원본 테이크는 바뀌지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
