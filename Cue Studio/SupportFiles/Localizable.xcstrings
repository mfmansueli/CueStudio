    "Without finding every section by hand. You choose what stays." : {
      "comment" : "Discovery notification body (Clean Up)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من دون البحث عن كل جزء يدويًا. أنت تختار ما يبقى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden at finde hvert stykke selv. Du vælger, hvad der bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne jede Stelle selbst zu suchen. Du entscheidest, was bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin buscar cada fragmento a mano. Tú eliges qué se queda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans chercher chaque passage à la main. Vous choisissez ce qui reste."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर हिस्सा हाथ से ढूँढे बिना। क्या रहेगा, यह आप तय करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa mencari setiap bagian satu per satu. Kamu yang memilih apa yang dipertahankan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza cercare ogni punto a mano. Scegli tu cosa resta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ひとつずつ探す必要はありません。残す部分はあなたが選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구간을 일일이 찾지 않아도 돼요. 무엇을 남길지는 직접 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uten å finne hver bit selv. Du velger hva som blir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder elk stukje zelf te zoeken. Jij kiest wat blijft."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem caçar cada trecho na mão. Você escolhe o que fica."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan att leta upp varje del själv. Du väljer vad som blir kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่ต้องหาทีละช่วงเอง คุณเลือกเองว่าจะเก็บอะไร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her bölümü elle bulmadan. Neyin kalacağını sen seçersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần tự tìm từng đoạn. Bạn chọn đoạn nào giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需手动逐段查找。保留什么由你决定。"
          }
