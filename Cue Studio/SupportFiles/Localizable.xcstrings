    "Text over your camera, right under the lens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص فوق الكاميرا، أسفل العدسة مباشرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text über deiner Kamera, direkt unter der Linse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto sobre tu cámara, justo debajo de la lente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte sur votre caméra, juste sous l’objectif."
