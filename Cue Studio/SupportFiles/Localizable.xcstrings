    "Pick what you talk about. Each topic becomes a world around you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما تتحدث عنه. كل موضوع يصبح عالمًا من حولك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, worüber du sprichst. Jedes Thema wird zu einer Welt um dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige de qué hablas. Cada tema se convierte en un mundo a tu alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisis de quoi tu parles. Chaque sujet devient un monde autour de toi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि आप किस बारे में बात करते हैं। हर विषय आपके चारों ओर एक दुनिया बन जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih apa yang kamu bahas. Setiap topik menjadi dunia di sekitarmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli di cosa parli. Ogni argomento diventa un mondo intorno a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話すテーマを選んでください。テーマごとにあなたの周りに世界が生まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어떤 이야기를 하는지 골라 보세요. 주제마다 당신 주변에 하나의 세계가 생겨요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha sobre o que você fala. Cada tema vira um mundo ao seu redor."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่คุณพูดถึง แต่ละหัวข้อจะกลายเป็นโลกรอบตัวคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neyden bahsettiğini seç. Her konu etrafında bir dünyaya dönüşür."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn chủ đề bạn nói đến. Mỗi chủ đề trở thành một thế giới quanh bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你聊的话题，每个话题都会成为你身边的一个世界。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies waarover je praat. Elk onderwerp wordt een wereld om je heen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vad du pratar om. Varje ämne blir en värld runt dig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvad du taler om. Hvert emne bliver en verden omkring dig."
