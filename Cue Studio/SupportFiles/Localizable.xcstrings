    "Scripts keep you on track and cut retakes. Pick one to read from." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النصوص تُبقيك على المسار وتقلل الإعادات. اختر نصًا للقراءة منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuskripter holder dig på sporet og skærer ned på omtagelser. Vælg et at læse fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte halten dich auf Kurs und sparen Wiederholungen. Wähl eins zum Lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los guiones te mantienen en el camino y reducen las repeticiones. Elige uno para leer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les scripts vous gardent sur les rails et réduisent les reprises. Choisissez-en un à lire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रिप्ट से आप भटकते नहीं और रीटेक कम होते हैं। पढ़ने के लिए एक चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskah membuatmu tetap fokus dan mengurangi rekam ulang. Pilih satu untuk dibaca."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I copioni ti tengono in carreggiata e riducono le ripetizioni. Scegline uno da leggere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台本があれば話がぶれず、撮り直しも減ります。読む台本を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본이 있으면 흐름을 잃지 않고 다시 찍을 일이 줄어요. 읽을 대본을 고르세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus holder deg på sporet og kutter omtak. Velg ett å lese fra."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts houden je op koers en beperken hernieuwde opnames. Kies er een om voor te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteiros te mantêm no rumo e cortam regravações. Escolha um para ler."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus håller dig på banan och minskar omtagningar. Välj ett att läsa från."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สคริปต์ช่วยให้คุณพูดตรงประเด็นและอัดใหม่น้อยลง เลือกหนึ่งอันเพื่ออ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaryolar seni yolda tutar ve tekrar çekimleri azaltır. Okumak için birini seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kịch bản giúp bạn đi đúng hướng và bớt phải quay lại. Chọn một kịch bản để đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有脚本不跑题，少重拍。选一个来读吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本讓你不會跑題，也減少重錄。選一份來朗讀。"
          }
        }
      }
    },
    "Scripts, rewrites, hooks and theme ideas are all written on this iPhone. No other AI service is involved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النصوص وإعادة الصياغة والافتتاحيات وأفكار المواضيع تُكتب كلها على هذا الـ iPhone. لا توجد أي خدمة ذكاء اصطناعي أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuskripter, omskrivninger, hooks og temaidéer skrives alle på denne iPhone. Ingen anden AI-tjeneste er involveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte, Umformulierungen, Hooks und Themenideen entstehen alle auf diesem iPhone. Kein anderer KI-Dienst ist beteiligt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los guiones, las reescrituras, los ganchos y las ideas de temas se escriben en este iPhone. No interviene ningún otro servicio de IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts, réécritures, accroches et idées de thèmes sont tous écrits sur cet iPhone. Aucun autre service d’IA n’intervient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रिप्ट, रीराइट, हुक और थीम आइडिया सब इसी iPhone पर लिखे जाते हैं। कोई दूसरी AI सर्विस शामिल नहीं है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskah, penulisan ulang, hook, dan ide tema semuanya ditulis di iPhone ini. Tidak ada layanan AI lain yang terlibat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copioni, riscritture, ganci e idee di temi vengono scritti tutti su questo iPhone. Nessun altro servizio IA è coinvolto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台本、書き直し、フック、テーマのアイデアはすべてこのiPhone上で書かれます。ほかのAIサービスは使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본, 다시 쓰기, 훅, 주제 아이디어는 모두 이 iPhone에서 작성돼요. 다른 AI 서비스는 사용하지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus, omskrivinger, hooks og temaideer skrives alle på denne iPhonen. Ingen annen AI-tjeneste er involvert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts, herschrijvingen, hooks en thema-ideeën worden allemaal op deze iPhone geschreven. Er is geen andere AI-dienst bij betrokken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteiros, reescritas, ganchos e ideias de tema são todos escritos neste iPhone. Nenhum outro serviço de IA é usado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus, omskrivningar, hooks och temaidéer skrivs alla på den här iPhonen. Ingen annan AI-tjänst är inblandad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สคริปต์ การเขียนใหม่ ฮุก และไอเดียหัวข้อ เขียนบน iPhone เครื่องนี้ทั้งหมด ไม่มีบริการ AI อื่นเกี่ยวข้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaryolar, yeniden yazmalar, kancalar ve konu fikirleri bu iPhone’da yazılır. Başka hiçbir yapay zekâ hizmeti kullanılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kịch bản, bản viết lại, hook và ý tưởng chủ đề đều được viết trên iPhone này. Không có dịch vụ AI nào khác tham gia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本、改写、钩子和主题创意都在这台 iPhone 上撰写。不使用其他任何 AI 服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腳本、改寫、開場鉤子與主題點子全都在這部 iPhone 上撰寫。不涉及其他任何 AI 服務。"
          }
        }
      }
    },
