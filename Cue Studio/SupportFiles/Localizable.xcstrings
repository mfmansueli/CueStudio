    "Start with a script.\nSound like you rehearsed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بنص.\nوتحدّث كأنك تدرّبت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
