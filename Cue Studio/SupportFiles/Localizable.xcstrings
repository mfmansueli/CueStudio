            "state" : "translated",
            "value" : "Til stråledelerglas"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Strahlteilerglas"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cristal beam-splitter"
          }
        },
        "fr" : {
          "stringUnit" : {
