    "Each in its own area, at the same time as you." : {
      "comment" : "Add photo or video › Split screen mode: one-line explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلٌّ في مساحته، في الوقت نفسه معك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver i sit eget felt, samtidig med dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes in seinem Bereich, gleichzeitig mit dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno en su zona, al mismo tiempo que tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun dans sa zone, en même temps que vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर एक अपनी जगह में, आपके साथ-साथ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masing-masing di areanya, bersamaan denganmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno nella sua area, insieme a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "それぞれの枠で、あなたと同時に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각자 자기 영역에, 나와 동시에."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver i sitt eget felt, samtidig med deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk in een eigen vlak, tegelijk met jou."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um na sua área, ao mesmo tempo que você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Var och en i sin yta, samtidigt som du."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละอันในพื้นที่ของตัวเอง พร้อมกับคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her biri kendi alanında, seninle aynı anda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi thứ một vùng riêng, cùng lúc với bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各占一块区域，与你同时出现。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各佔一塊區域，與你同時出現。"
          }
        }
      }
    },
    "Each script gets up to 3 of your phrases, taking turns. These are the next script’s." : {
      "comment" : "My Cue Voice › What Cue sends: note under the voice when the creator has 4 or 5 phrases they always say; the text above shows the next script's three",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل كل نص على 3 من عباراتك كحد أقصى، بالتناوب. هذه عبارات النص التالي."
          }
        },
