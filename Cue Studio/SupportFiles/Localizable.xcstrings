    "Before anything else — I'm sorry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أي شيء — أنا آسف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem anderen – es tut mir leid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de nada — lo siento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant tout — je suis désolé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे पहले — मुझे माफ़ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum apa pun — aku minta maaf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di tutto — mi dispiace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず最初に — ごめんなさい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇보다 먼저 — 죄송합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de tudo — me desculpem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนอื่นเลย — ขอโทษนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şeyden önce — özür dilerim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước hết — mình xin lỗi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首先 — 对不起。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor alles: het spijt me."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Först av allt — jag är ledsen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før alt andet — jeg er ked af det."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Først av alt — jeg beklager."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先說一件事 — 我很抱歉。"
          }
        }
