    "Compound interest sounds complicated. It’s simpler than you think." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدو الفائدة المركبة معقدة، لكنها أبسط مما تظن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
