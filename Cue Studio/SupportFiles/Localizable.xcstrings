        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marka kiti renklerini, yazı tiplerini, logonu ve stillerini bir arada tutar; hepsini tek adımda herhangi bir videoya uygularsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bộ thương hiệu gom màu, phông chữ, logo và kiểu của bạn lại một chỗ, để áp dụng cho bất kỳ video nào chỉ trong một bước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "品牌套件把你的颜色、字体、标志和样式放在一起，一步就能用到任何视频上。"
