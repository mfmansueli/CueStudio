    "The video is removed from Cue. Copies you saved to Photos stay there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إزالة الفيديو من Cue. تبقى النسخ التي حفظتها في الصور هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Video wird aus Cue entfernt. Kopien in Fotos bleiben dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo se quita de Cue. Las copias que guardaste en Fotos se quedan allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo est retirée de Cue. Les copies enregistrées dans Photos y restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो Cue से हट जाता है। फ़ोटो में सेव की गई कॉपी वहीं रहती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video dihapus dari Cue. Salinan yang kamu simpan di Foto tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il video viene tolto da Cue. Le copie salvate in Foto restano lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画はCueから削除されます。写真に保存したコピーは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상이 Cue에서 삭제돼요. 사진에 저장한 사본은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo sai do Cue. As cópias que você salvou no Fotos continuam lá."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอจะถูกลบออกจาก Cue สำเนาที่บันทึกในรูปภาพยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video Cue'dan kaldırılır. Fotoğraflar'a kaydettiğin kopyalar orada kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video sẽ bị xóa khỏi Cue. Các bản bạn đã lưu vào Ảnh vẫn còn đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频将从 Cue 中删除。已存储到“照片”的副本会保留。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De video wordt uit Cue verwijderd. Kopieën die je in Foto’s hebt opgeslagen blijven daar staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videon tas bort från Cue. Kopior du sparat i Bilder finns kvar där."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoen fjernes fra Cue. Kopier, du har gemt i Fotos, bliver der."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoen fjernes fra Cue. Kopier du har lagret i Bilder, blir der."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片會從 Cue 中移除。你儲存到「照片」的拷貝會保留在那裡。"
          }
        }
      }
    },
