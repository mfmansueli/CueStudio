    "With Reduce Motion on, the sky and the celebrations rest." : {
      "comment" : "Settings › Personalize: footer of the Feel section. Reduce Motion is the iOS accessibility setting (Apple's localized name)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل تقليل الحركة، تهدأ السماء والاحتفالات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reducer bevægelse er slået til, hviler himlen og fejringerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit „Bewegung reduzieren“ ruhen der Himmel und die Feiern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Reducir movimiento activado, el cielo y las celebraciones descansan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Réduire les animations activé, le ciel et les célébrations restent immobiles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गति कम करें चालू होने पर आसमान और जश्न थम जाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Kurangi Gerakan aktif, langit dan perayaan beristirahat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Riduci movimento attivo, il cielo e le celebrazioni riposano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「視差効果を減らす」がオンのときは、空とお祝いはお休みします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 줄이기가 켜져 있으면 하늘과 축하 효과가 멈춰요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Reduser bevegelse er på, hviler himmelen og feiringene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Verminder beweging aan rusten de hemel en de vieringen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com Reduzir Movimento ativado, o céu e as celebrações descansam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När Minska rörelse är på vilar himlen och firandena."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดลดการเคลื่อนไหว ท้องฟ้าและการเฉลิมฉลองจะหยุดพัก"
          }
        },
        "tr" : {
          "stringUnit" : {
