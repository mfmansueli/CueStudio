    },
    "This iPhone can’t find people in video, so the background can’t change here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ iPhone تحديد الأشخاص في الفيديو، لذا لا يمكن تغيير الخلفية هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann keine Personen im Video erkennen, daher lässt sich der Hintergrund hier nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede encontrar personas en vídeo, así que aquí no se puede cambiar el fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas repérer les personnes dans la vidéo : l’arrière-plan ne peut pas changer ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone वीडियो में लोगों को नहीं ढूँढ सकता, इसलिए यहाँ बैकग्राउंड नहीं बदल सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa menemukan orang di video, jadi latar belakang tidak bisa diubah di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non riesce a trovare persone nel video, quindi qui lo sfondo non può cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneはビデオ内の人物を認識できないため、ここでは背景を変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 비디오에서 사람을 찾을 수 없어 여기서는 배경을 바꿀 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não consegue encontrar pessoas no vídeo, então o fundo não pode mudar aqui."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone เครื่องนี้หาคนในวิดีโอไม่ได้ จึงเปลี่ยนพื้นหลังที่นี่ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone videoda kişileri bulamıyor, bu yüzden arka plan burada değişemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này không nhận ra người trong video nên không đổi được nền ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 无法识别视频中的人物，因此这里无法更改背景。"
          }
        }
      }
    },
    "This iPhone can’t find people in video. Use a color key with a green or blue screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ iPhone تحديد الأشخاص في الفيديو. استخدم مفتاح اللون مع شاشة خضراء أو زرقاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann keine Personen im Video erkennen. Nutze einen Farbschlüssel mit Green- oder Bluescreen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede encontrar personas en vídeo. Usa una clave de color con pantalla verde o azul."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas repérer les personnes dans la vidéo. Utilisez l’incrustation avec un fond vert ou bleu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone वीडियो में लोगों को नहीं ढूँढ सकता। ग्रीन या ब्लू स्क्रीन के साथ कलर की इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa menemukan orang di video. Gunakan kunci warna dengan layar hijau atau biru."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non riesce a trovare persone nel video. Usa il chroma key con uno schermo verde o blu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneはビデオ内の人物を認識できません。グリーンバックかブルーバックでカラーキーを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 비디오에서 사람을 찾을 수 없습니다. 그린 또는 블루 스크린으로 컬러 키를 사용하세요."
