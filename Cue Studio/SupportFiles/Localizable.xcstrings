    "Scrolls when you talk, waits when you stop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك النص عندما تتحدث ويتوقف عندما تصمت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller, når du taler, venter, når du stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt, wenn du sprichst, und wartet, wenn du aufhörst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanza cuando hablas y espera cuando paras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défile quand vous parlez, attend quand vous vous arrêtez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बोलते हैं तो स्क्रॉल होता है, रुकते हैं तो रुक जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergulir saat kamu bicara, berhenti saat kamu diam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorre quando parli, aspetta quando ti fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
