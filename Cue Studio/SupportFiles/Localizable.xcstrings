        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이야기 하나 할게요 — 네, 결말은 좋아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora da história — e sim, termina bem."
