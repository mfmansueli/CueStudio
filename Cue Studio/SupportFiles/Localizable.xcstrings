          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वहीं से आगे बढ़ें जहाँ वह वीडियो रुका था: अगला कदम या वह सवाल जो अधूरा रह गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
