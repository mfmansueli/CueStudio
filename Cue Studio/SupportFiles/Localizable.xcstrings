    "Apple Intelligence can’t suggest ideas in %@ yet. Here are starter ideas to write yourself." : {
      "comment" : "Find inspiration's note when the interface language is one Apple Intelligence can't write ideas in (%@ = that language's name, which may already contain the word for language, e.g. vi Tiếng Thái): the ideas shown are the built-in starters.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Apple Intelligence اقتراح أفكار باللغة %@ بعد. إليك أفكارًا أولية لتكتبها بنفسك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
