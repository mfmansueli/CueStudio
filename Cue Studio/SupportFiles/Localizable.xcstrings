    "Never over your face or your edit. Off with Reduce Motion." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يظهر أبدًا فوق وجهك أو تعديلك. يتوقف مع تقليل الحركة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldrig over dit ansigt eller din redigering. Slået fra med Reducer bevægelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie über deinem Gesicht oder deinem Schnitt. Aus bei „Bewegung reduzieren“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca sobre tu cara ni tu edición. Se apaga con Reducir movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jamais sur votre visage ni sur votre montage. Désactivé avec Réduire les animations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कभी आपके चेहरे या एडिट के ऊपर नहीं। मोशन कम करें के साथ बंद।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak pernah menutupi wajah atau suntinganmu. Mati dengan Kurangi Gerakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai sopra il tuo volto o il tuo montaggio. Disattivato con Riduci movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔や編集の上には表示されません。視差効果を減らすとオフになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼굴이나 편집 화면 위에는 절대 나타나지 않아요. 동작 줄이기를 켜면 꺼져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldri over ansiktet eller redigeringen din. Av med Reduser bevegelse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nooit over je gezicht of je bewerking. Uit met Beweging verminderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nunca sobre o seu rosto ou a sua edição. Desligado com Reduzir Movimento."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldrig över ditt ansikte eller din redigering. Av med Minska rörelser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่แสดงทับใบหน้าหรืองานตัดต่อ ปิดเมื่อเปิดลดการเคลื่อนไหว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzünün ya da kurgunun üstünde asla görünmez. Hareketi Azalt ile kapanır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không bao giờ che mặt hay bản dựng. Tắt khi bật Giảm chuyển động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绝不会盖住你的脸或剪辑画面。开启“减弱动态效果”时会关闭。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "絕不會蓋住你的臉或剪輯畫面。開啟「減少動態效果」時會關閉。"
          }
        }
      }
    },
