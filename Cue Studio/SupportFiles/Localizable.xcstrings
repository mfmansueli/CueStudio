        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबसे पहले — मुझे माफ़ करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum apa pun — aku minta maaf."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di tutto — mi dispiace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず最初に — ごめんなさい。"
          }
