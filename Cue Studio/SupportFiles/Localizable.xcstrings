        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quindici minuti la domenica possono rendere più calma tutta la settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日曜日の15分で、1週間がもっと穏やかになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일요일의 15분이 한 주 전체를 더 차분하게 만들 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kvarter på søndag kan gjøre hele uka roligere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kwartier op zondag kan je hele week rustiger maken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze minutos no domingo podem deixar a semana toda mais tranquila."
          }
        },
        "sv" : {
          "stringUnit" : {
