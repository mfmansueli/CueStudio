    "Voice Following listens in %@. Captions listen in the script’s language, %@. Pick the language spoken if it’s different." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبّع الصوت يستمع بـ%1$@. الترجمة النصية تستمع بلغة النص، %2$@. اختر اللغة المنطوقة إن كانت مختلفة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachfolge hört auf %1$@. Untertitel hören in der Sprache des Skripts, %2$@. Wähle die gesprochene Sprache, wenn es eine andere ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Voice Following listens in %1$@. Captions listen in the script’s language, %2$@. Pick the language spoken if it’s different."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguimiento de voz escucha en %1$@. Los subtítulos escuchan en el idioma del guion, %2$@. Elige el idioma hablado si es otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivi vocal écoute en %1$@. Les sous-titres écoutent dans la langue du script, %2$@. Choisissez la langue parlée si elle est différente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ ट्रैकिंग %1$@ में सुनती है। कैप्शन स्क्रिप्ट की भाषा, %2$@, में सुनते हैं। अगर बोली गई भाषा अलग है तो उसे चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti Suara mendengarkan dalam %1$@. Teks mendengarkan dalam bahasa naskah, %2$@. Pilih bahasa yang diucapkan jika berbeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui voce ascolta in %1$@. I sottotitoli ascoltano nella lingua del copione, %2$@. Scegli la lingua parlata se è un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声追従は%1$@で聞き取ります。字幕は台本の言語（%2$@）で聞き取ります。話した言語が違う場合は選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 따라가기는 %1$@로 들어요. 자막은 대본 언어인 %2$@로 들어요. 말한 언어가 다르면 골라 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir voz ouve em %1$@. As legendas ouvem no idioma do roteiro, %2$@. Escolha o idioma falado se for outro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ติดตามเสียงฟังเป็น%1$@ คำบรรยายฟังตามภาษาของสคริปต์ คือ%2$@ หากพูดภาษาอื่น ให้เลือกภาษาที่พูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Takibi %1$@ dinliyor. Altyazılar senaryonun dilinde, %2$@, dinliyor. Konuşulan dil farklıysa onu seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo giọng nói nghe bằng %1$@. Phụ đề nghe theo ngôn ngữ của kịch bản, %2$@. Hãy chọn ngôn ngữ được nói nếu khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音跟随以%1$@聆听。字幕以脚本的语言（%2$@）聆听。如果说的是其他语言，请选择说话的语言。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stem volgen luistert in %1$@. Ondertitels luisteren in de taal van het script, %2$@. Kies de gesproken taal als die anders is."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ rösten lyssnar på %1$@. Undertexter lyssnar på manusets språk, %2$@. Välj det språk som talas om det är ett annat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg stemmen lytter på %1$@. Undertekster lytter på manuskriptets sprog, %2$@. Vælg det talte sprog, hvis det er et andet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg stemmen lytter på %1$@. Undertekster lytter på språket i manuset, %2$@. Velg språket som snakkes hvis det er et annet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟隨語音」聆聽 %1$@。字幕則以腳本的語言 %2$@ 聆聽。如果說話的語言不同，請選擇該語言。"
          }
        }
      }
    },
    "Voice Following needs to download %@. Connect to the internet and try again." : {
      "localizations" : {
