    "It’s almost time: %@. Here’s one thing worth knowing." : {
      "comment" : "Find inspiration: the opening line of a starter tied to an occasion coming up, said on camera (%@ is the occasion's name)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ على الأبواب. إليكم شيئًا يستحق أن تعرفوه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snart er det %@. Her er én ting, der er værd at vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bald ist es so weit: %@. Hier ist etwas, das sich zu wissen lohnt."
          }
        },
        "es" : {
