    "So you can see yourself while you read" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لترى نفسك أثناء القراءة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så du kan se dig selv, mens du læser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit du dich beim Lesen siehst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verte mientras lees"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour te voir pendant que tu lis"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ताकि पढ़ते समय आप खुद को देख सकें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agar kamu bisa melihat dirimu saat membaca"
