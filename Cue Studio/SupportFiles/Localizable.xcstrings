            "state" : "translated",
            "value" : "你說話時以 %@ 捲動"
          }
        }
      }
    },
    "Scrolls when you talk, waits when you stop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك النص عندما تتحدث ويتوقف عندما تصمت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller, når du taler, venter, når du stopper."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt, wenn du sprichst, und wartet, wenn du aufhörst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avanza cuando hablas y espera cuando paras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défile quand vous parlez, attend quand vous vous arrêtez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बोलते हैं तो स्क्रॉल होता है, रुकते हैं तो रुक जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergulir saat kamu bicara, berhenti saat kamu diam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorre quando parli, aspetta quando ti fermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話すと進み、止まると待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하면 넘어가고, 멈추면 기다려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller når du snakker, venter når du slutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrolt als je praat, wacht als je stopt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rola quando você fala e espera quando você para."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrollar när du pratar, väntar när du slutar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความเลื่อนเมื่อคุณพูด และรอเมื่อคุณหยุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşunca kayar, durunca bekler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Văn bản cuộn khi bạn nói và chờ khi bạn dừng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说话时滚动，停下时等待。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
