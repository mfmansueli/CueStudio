        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하는 동안 Cue가 알아듣는 언어를 정해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
