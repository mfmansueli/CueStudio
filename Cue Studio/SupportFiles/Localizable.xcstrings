    "This text’s font, colors, background, shadow and glow replace your captions’ current style." : {
      "comment" : "Question before copying a text's look onto captions that already have a look of their own (copied before, or from an older version)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيحلّ خط هذا النص وألوانه وخلفيته وظله وتوهّجه محلّ النمط الحالي للترجمة النصية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne teksts skrifttype, farver, baggrund, skygge og glød erstatter underteksternes nuværende stil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrift, Farben, Hintergrund, Schatten und Leuchten dieses Texts ersetzen den aktuellen Stil deiner Untertitel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fuente, los colores, el fondo, la sombra y el brillo de este texto reemplazan el estilo actual de tus subtítulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La police, les couleurs, l’arrière-plan, l’ombre et la lueur de ce texte remplacent le style actuel de vos sous-titres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस टेक्स्ट का फ़ॉन्ट, रंग, बैकग्राउंड, शैडो और चमक आपके कैप्शन की मौजूदा स्टाइल की जगह ले लेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Font, warna, latar, bayangan, dan cahaya tulisan ini akan menggantikan gaya teksmu saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Font, colori, sfondo, ombra e bagliore di questo testo sostituiscono lo stile attuale dei tuoi sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このテキストのフォント、カラー、背景、影、グローが、字幕の今のスタイルに置き換わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 텍스트의 서체, 색상, 배경, 그림자, 글로우가 현재 자막 스타일을 대신해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifttypen, fargene, bakgrunnen, skyggen og gløden til denne teksten erstatter den nåværende stilen på undertekstene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lettertype, de kleuren, de achtergrond, de schaduw en de gloed van deze tekst vervangen de huidige stijl van je ondertitels."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte, as cores, o fundo, a sombra e o brilho deste texto substituem o estilo atual das suas legendas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här textens teckensnitt, färger, bakgrund, skugga och glöd ersätter undertexternas nuvarande stil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟอนต์ สี พื้นหลัง เงา และแสงเรืองของข้อความนี้จะมาแทนสไตล์ปัจจุบันของคำบรรยาย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu metnin yazı tipi, renkleri, arka planı, gölgesi ve parıltısı altyazılarının şu anki stilinin yerini alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phông chữ, màu, nền, bóng đổ và hiệu ứng phát sáng của chữ này sẽ thay thế kiểu hiện tại của phụ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这段文字的字体、颜色、背景、阴影和光晕将取代字幕当前的样式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段文字的字體、顏色、背景、陰影和光暈將取代字幕目前的風格。"
          }
        }
      }
    },
