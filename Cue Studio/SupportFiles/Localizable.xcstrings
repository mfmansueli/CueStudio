    "Ten minutes, one pan, and dinner is done." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشر دقائق، مقلاة واحدة، والعشاء جاهز."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti minutter, én pande, og aftensmaden er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zehn Minuten, eine Pfanne, und das Abendessen steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diez minutos, una sartén y la cena está lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dix minutes, une poêle, et le dîner est prêt."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दस मिनट, एक पैन, और डिनर तैयार।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepuluh menit, satu wajan, dan makan malam siap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieci minuti, una padella, e la cena è pronta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10分、フライパンひとつで夕食の完成。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10분, 팬 하나면 저녁 완성."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti minutter, én panne, og middagen er klar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tien minuten, één pan en het eten staat klaar."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dez minutos, uma panela e o jantar está pronto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tio minuter, en panna och middagen är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 นาที กระทะใบเดียว มื้อเย็นก็เสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On dakika, tek tava ve akşam yemeği hazır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mười phút, một cái chảo, và bữa tối đã xong."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十分钟，一口锅，晚饭搞定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十分鐘，一口鍋，晚餐搞定。"
          }
        }
      }
    },
    "Tell where a family recipe comes from while you cook it." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احكِ أصل وصفة عائلية وأنت تطبخها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl, hvor en familieopskrift kommer fra, mens du laver den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzähl, woher ein Familienrezept stammt, während du es kochst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta de dónde viene una receta familiar mientras la cocinas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racontez d’où vient une recette de famille pendant que vous la cuisinez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी पारिवारिक रेसिपी की कहानी बताएँ, उसे बनाते हुए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceritakan asal resep keluarga sambil kamu memasaknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconta da dove viene una ricetta di famiglia mentre la cucini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "家族のレシピの由来を、作りながら話す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가족 레시피의 유래를 요리하면서 이야기하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
