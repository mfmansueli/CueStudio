    "Scrolls at %@ while you talk" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك بسرعة %@ أثناء حديثك"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller med %@, mens du taler"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt mit %@, während du sprichst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desplaza a %@ mientras hablas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défile à %@ pendant que vous parlez"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके बोलते समय %@ पर स्क्रॉल होता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bergulir pada %@ saat kamu bicara"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scorre a %@ mentre parli"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話している間%@でスクロール"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하는 동안 %@로 스크롤"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruller med %@ mens du snakker"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrollt op %@ terwijl je praat"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rola a %@ enquanto você fala"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrollar med %@ medan du pratar"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลื่อนที่ %@ ขณะที่คุณพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen konuşurken %@ hızla kayar"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuộn ở %@ khi bạn nói"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说话时以 %@ 滚动"
