    },
    "At most one a day, never at night. Your reminders always arrive." : {
      "comment" : "Settings › Notifications: footer under From Cue",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واحد في اليوم على الأكثر، ولا شيء ليلًا. تذكيراتك تصل دائمًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højst én om dagen, aldrig om natten. Dine påmindelser kommer altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens eine am Tag, nie nachts. Deine Erinnerungen kommen immer an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como mucho una al día, nunca de noche. Tus recordatorios siempre llegan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une par jour au plus, jamais la nuit. Vos rappels arrivent toujours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिन में ज़्यादा से ज़्यादा एक, रात में कभी नहीं। आपके रिमाइंडर हमेशा आते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paling banyak satu sehari, tidak pernah di malam hari. Pengingatmu selalu datang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al massimo una al giorno, mai di notte. I tuoi promemoria arrivano sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くても1日1回、夜は送りません。あなたのリマインダーは必ず届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루에 최대 한 번, 밤에는 보내지 않아요. 직접 설정한 리마인더는 항상 도착해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyst én om dagen, aldri om natten. Påminnelsene dine kommer alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hooguit één per dag, nooit ’s nachts. Je herinneringen komen altijd aan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No máximo uma por dia, nunca à noite. Seus lembretes sempre chegam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högst en om dagen, aldrig på natten. Dina påminnelser kommer alltid."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่เกินวันละหนึ่งครั้ง และไม่ส่งตอนกลางคืน การเตือนของคุณจะมาถึงเสมอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günde en fazla bir tane, geceleri asla. Hatırlatıcıların her zaman gelir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tối đa một lần mỗi ngày, không bao giờ vào ban đêm. Lời nhắc của bạn luôn đến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天最多一条，夜间从不打扰。你设置的提醒总会准时送达。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天最多一則，夜間從不打擾。你設定的提醒總會準時送達。"
          }
        }
      }
    },
