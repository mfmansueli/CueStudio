    "Each topic keeps its colour in Scripts and in your universe." : {
      "comment" : "Settings › Personalize: footer under the topic chips (Scripts is the tab)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ كل موضوع بلونه في النصوص وفي كونك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert emne beholder sin farve i Manuskripter og i dit univers."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Thema behält seine Farbe in „Skripte“ und in deinem Universum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tema conserva su color en Guiones y en tu universo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque sujet garde sa couleur dans Scripts et dans votre univers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर विषय का रंग स्क्रिप्ट और आपके यूनिवर्स में एक जैसा रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap topik punya warna yang sama di Naskah dan di semestamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni argomento mantiene il suo colore in Copioni e nel tuo universo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トピックの色は、台本でもあなたの宇宙でも同じです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주제마다 대본과 내 유니버스에서 같은 색을 유지해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvert emne beholder fargen sin i Manus og i universet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk onderwerp houdt zijn kleur in Scripts en in je universum."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada tema mantém sua cor em Roteiros e no seu universo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje ämne behåller sin färg i Manus och i ditt universum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แต่ละหัวข้อคงสีเดิมไว้ในสคริปต์และในจักรวาลของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her konu, Senaryolar’da ve evreninde rengini korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi chủ đề giữ màu của mình trong Kịch bản và trong vũ trụ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个主题在脚本和你的宇宙中都保持同一颜色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個主題在腳本和你的宇宙中都保持同一顏色。"
          }
        }
      }
    },
