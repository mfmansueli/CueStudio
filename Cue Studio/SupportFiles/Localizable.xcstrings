        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“मेरा अलार्म और मैं दोस्त नहीं हैं।”"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Alarmku dan aku bukan teman.”"
