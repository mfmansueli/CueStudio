    "If a task takes less than two minutes, there’s a simple rule for it." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت المهمة تستغرق أقل من دقيقتين، فهناك قاعدة بسيطة لها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis en opgave tager under to minutter, findes der en enkel regel for den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Aufgabe weniger als zwei Minuten dauert, gibt es dafür eine einfache Regel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si una tarea toma menos de dos minutos, hay una regla sencilla para ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si une tâche prend moins de deux minutes, il existe une règle simple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कोई काम दो मिनट से कम का है, तो उसके लिए एक आसान नियम है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
