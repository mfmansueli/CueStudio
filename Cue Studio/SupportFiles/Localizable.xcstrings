        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el meal prep te suena a perder todo el domingo, prueba esta versión más pequeña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le batch cooking vous fait penser à un dimanche entier perdu, essayez cette version plus courte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर मील प्रेप पूरा रविवार गँवाने जैसा लगता है, तो यह छोटा वर्शन आज़माएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau meal prep terdengar menghabiskan seharian Minggu, coba versi kecil ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il meal prep ti sembra una domenica intera persa, prova questa versione ridotta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作り置きで日曜日が丸ごと消えると思うなら、この小さめ版を試して。"
