    "Pick a format. Cue builds the structure — you fill in bullets." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر شكلاً. يبني Cue الهيكل — وأنت تملأ النقاط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähl ein Format. Cue baut die Struktur – du füllst die Stichpunkte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un formato. Cue arma la estructura — tú rellenas los puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un format. Cue construit la structure — vous remplissez les points."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फ़ॉर्मैट चुनें। Cue ढाँचा बनाता है — आप पॉइंट्स भरें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih format. Cue menyusun strukturnya — kamu isi poin-poinnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un formato. Cue crea la struttura — tu riempi i punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォーマットを選んでください。Cueが構成を作り、あなたが要点を埋めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "포맷을 고르세요. Cue가 구조를 만들고 요점은 직접 채워요."
