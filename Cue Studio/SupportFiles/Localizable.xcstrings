    "+%lld exports for each friend who exports their first video with Cue." : {
      "comment" : "Card on 'Ready to travel' with one free export left (3 exports).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld عمليات تصدير عن كل صديق يصدّر أول فيديو له مع Cue."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld eksporter for hver ven, der eksporterer sin første video med Cue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld Exporte für jeden Freund, der sein erstes Video mit Cue exportiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld exportaciones por cada amigo que exporte su primer video con Cue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld exports pour chaque ami qui exporte sa première vidéo avec Cue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue से पहला वीडियो एक्सपोर्ट करने वाले हर दोस्त पर +%lld एक्सपोर्ट।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld ekspor untuk setiap teman yang mengekspor video pertamanya dengan Cue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%lld esportazioni per ogni amico che esporta il suo primo video con Cue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueで初めての動画を書き出した友だち1人につき、書き出し +%lld回。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue로 첫 영상을 내보낸 친구 1명당 내보내기 +%lld회."
          }
        },
