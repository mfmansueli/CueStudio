    "I believed this for years — until I checked." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صدقت هذا لسنوات — حتى تحققت منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg troede på det i årevis — indtil jeg tjekkede det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jahrelang habe ich das geglaubt – bis ich nachgeschaut habe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo creí durante años, hasta que lo comprobé."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’y ai cru pendant des années — jusqu’à ce que je vérifie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने सालों तक इसे माना — जब तक जाँचा नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku percaya ini bertahun-tahun — sampai aku mengeceknya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci ho creduto per anni, finché non ho controllato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何年も信じていた――確かめるまでは。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 년 동안 믿었어요 — 확인해 보기 전까지는요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg trodde på det i årevis — helt til jeg sjekket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik geloofde dit jarenlang — tot ik het nakeek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acreditei nisso por anos — até conferir."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag trodde på det i åratal — tills jag kollade."
