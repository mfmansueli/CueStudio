    "Show a short morning routine anyone can keep on busy days." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض روتينًا صباحيًا قصيرًا يمكن لأي شخص الالتزام به في الأيام المزدحمة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en kort morgenrutine, alle kan holde fast i på travle dage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig eine kurze Morgenroutine, die jeder auch an vollen Tagen schafft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra una rutina de mañana corta que cualquiera puede mantener en días ocupados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez une courte routine du matin que tout le monde peut tenir les jours chargés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटी सुबह की दिनचर्या दिखाएँ जिसे कोई भी व्यस्त दिनों में निभा सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan rutinitas pagi singkat yang bisa dijalani siapa saja di hari sibuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra una breve routine mattutina che chiunque può mantenere nei giorni pieni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忙しい日でも誰でも続けられる短い朝のルーティンを見せる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바쁜 날에도 누구나 지킬 수 있는 짧은 아침 루틴을 보여 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis en kort morgenrutine alle kan holde på travle dager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een korte ochtendroutine zien die iedereen op drukke dagen volhoudt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre uma rotina matinal curta que qualquer um mantém em dias corridos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa en kort morgonrutin som alla kan hålla även stressiga dagar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แนะนำกิจวัตรตอนเช้าสั้น ๆ ที่ใครก็ทำได้แม้ในวันที่ยุ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yoğun günlerde bile herkesin sürdürebileceği kısa bir sabah rutini göster."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giới thiệu một thói quen buổi sáng ngắn ai cũng giữ được kể cả ngày bận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展示一套忙碌时也人人能坚持的简短晨间习惯。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "展示一套忙碌時也人人能堅持的簡短晨間習慣。"
          }
        }
      }
    },
    "Show a quick warm-up anyone can do before training." : {
