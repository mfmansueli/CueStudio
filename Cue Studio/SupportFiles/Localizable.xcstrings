    "Warn viewers about one common travel mistake and how to avoid it." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نبّه المشاهدين إلى خطأ شائع في السفر وكيف يتجنبونه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar seerne om en almindelig rejsefejl, og hvordan man undgår den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warn die Zuschauer vor einem typischen Reisefehler und wie man ihn vermeidet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advierte a tu público sobre un error de viaje común y cómo evitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévenez le public d’une erreur de voyage courante et de la manière de l’éviter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्शकों को सफ़र की एक आम गलती और उससे बचने का तरीका बताएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingatkan penonton soal satu kesalahan perjalanan yang umum dan cara menghindarinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvisa chi guarda di un errore di viaggio comune e di come evitarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よくある旅の失敗と、その避け方を視聴者に伝える。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흔한 여행 실수 하나와 피하는 방법을 시청자에게 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advar seerne mot en vanlig reisefeil og hvordan man unngår den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuw kijkers voor een veelgemaakte reisfout en hoe je die voorkomt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alerte sobre um erro comum de viagem e como evitá-lo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varna tittarna för ett vanligt resemisstag och hur man undviker det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เตือนผู้ชมเรื่องข้อผิดพลาดที่พบบ่อยตอนเที่ยวและวิธีหลีกเลี่ยง"
