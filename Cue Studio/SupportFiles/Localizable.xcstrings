    "Pick the closest. Change it anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الأقرب. يمكنك تغييره في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Naheliegendste. Du kannst es jederzeit ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige lo más cercano. Puedes cambiarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
