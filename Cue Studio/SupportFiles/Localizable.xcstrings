    "Some words have a guessed time. Check where the line starts and ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض الكلمات بتوقيت تقديري. تحقّق من بداية السطر ونهايته."
