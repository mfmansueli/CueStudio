    "Kids can help more than we think. Here’s how to start." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع الأطفال المساعدة أكثر مما نظن. إليك كيف تبدأ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Børn kan hjælpe mere, end vi tror. Sådan kommer du i gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinder können mehr helfen, als wir denken. So fängst du an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los niños pueden ayudar más de lo que creemos. Así se empieza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enfants peuvent aider plus qu’on ne le pense. Voici comment commencer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बच्चे हमारी सोच से ज़्यादा मदद कर सकते हैं। ऐसे शुरू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anak bisa membantu lebih dari yang kita kira. Begini cara mulainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I bambini possono aiutare più di quanto pensiamo. Ecco come iniziare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子どもは思った以上に手伝えます。始め方はこちら。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이들은 생각보다 더 많이 도울 수 있어요. 이렇게 시작해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barn kan hjelpe mer enn vi tror. Slik kommer du i gang."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinderen kunnen meer helpen dan we denken. Zo begin je."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As crianças podem ajudar mais do que a gente pensa. Veja como começar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barn kan hjälpa till mer än vi tror. Så kommer du igång."
