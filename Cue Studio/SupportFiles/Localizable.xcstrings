          "stringUnit" : {
            "state" : "translated",
            "value" : "你不一定需要貴的那款。我們來比一比。"
          }
        }
      }
    },
    "You don’t need to be technical to get help from AI." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتاج إلى خبرة تقنية لتحصل على مساعدة من الذكاء الاصطناعي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behøver ikke være teknisk for at få hjælp af AI."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst kein Technikprofi sein, um dir von KI helfen zu lassen."
          }
