    "Finds the moments where Cue loses you, so you can look at them." : {
      "comment" : "Quick edit › Background › Check the cutout: what the check does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعثر على اللحظات التي يفقدك فيها Cue لتتمكن من مراجعتها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finder de øjeblikke, hvor Cue mister dig, så du kan se dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet die Stellen, an denen Cue dich verliert, damit du sie ansehen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra los momentos en que Cue te pierde para que los revises."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trouve les moments où Cue vous perd, pour que vous puissiez les revoir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वे पल ढूँढता है जहाँ Cue आपको खो देता है, ताकि आप उन्हें देख सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menemukan momen saat Cue kehilangan kamu, agar kamu bisa melihatnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova i momenti in cui Cue ti perde, così puoi guardarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueがあなたを見失う箇所を見つけて、確認できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 나를 놓치는 순간을 찾아 확인할 수 있게 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finner øyeblikkene der Cue mister deg, så du kan se på dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vindt de momenten waarop Cue je kwijtraakt, zodat je ze kunt bekijken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
