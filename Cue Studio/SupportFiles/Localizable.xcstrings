        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses erros de academia são tão comuns que a maioria nem percebe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här gymmisstagen är så vanliga att de flesta aldrig märker dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อผิดพลาดในยิมเหล่านี้พบบ่อยจนคนส่วนใหญ่ไม่เคยสังเกต"
