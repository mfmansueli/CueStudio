    "You don’t always need the expensive version. Let’s compare." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لست بحاجة دائمًا إلى النسخة الغالية. لنقارن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke altid brug for den dyre version. Lad os sammenligne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst nicht immer die teure Version. Vergleichen wir mal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No siempre necesitas la versión cara. Comparemos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas toujours besoin de la version chère. Comparons."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपको हमेशा महंगा वर्शन नहीं चाहिए। चलिए तुलना करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu nggak selalu butuh versi mahalnya. Yuk bandingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti serve sempre la versione costosa. Confrontiamo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも高いほうが必要なわけではありません。比べてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 비싼 게 필요한 건 아니에요. 비교해 볼게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger ikke alltid den dyre versjonen. La oss sammenligne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt niet altijd de dure versie nodig. Laten we vergelijken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sempre você precisa da versão cara. Vamos comparar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver inte alltid den dyra versionen. Vi jämför."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่จำเป็นต้องใช้ของแพงเสมอไป มาเทียบกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her zaman pahalı olanına ihtiyacın yok. Karşılaştıralım."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phải lúc nào cũng cần bản đắt tiền. Cùng so sánh nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
