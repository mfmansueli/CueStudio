    "Twenty screen-free minutes protect your focus." : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشرون دقيقة بلا شاشات تحمي تركيزك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyve skærmfrie minutter beskytter dit fokus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwanzig bildschirmfreie Minuten schützen deinen Fokus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veinte minutos sin pantallas protegen tu concentración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingt minutes sans écran protègent votre concentration."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बीस मिनट बिना स्क्रीन के आपका फ़ोकस बचाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dua puluh menit tanpa layar menjaga fokusmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Venti minuti senza schermi proteggono la tua concentrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を見ない20分が集中力を守ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 없는 20분이 집중력을 지켜 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjue skjermfrie minutter beskytter fokuset ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twintig minuten zonder scherm beschermen je focus."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vinte minutos sem tela protegem o seu foco."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjugo skärmfria minuter skyddar ditt fokus."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยี่สิบนาทีที่ไม่มีหน้าจอช่วยปกป้องสมาธิของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekransız yirmi dakika odağını korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai mươi phút không màn hình bảo vệ sự tập trung của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二十分钟不看屏幕，能保护你的专注力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "二十分鐘不看螢幕，能保護你的專注力。"
          }
        }
      }
    },
