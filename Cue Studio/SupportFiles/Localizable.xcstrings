          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편집본 위에 내레이션을 입히세요. 녹음 전에 Cue가 방법을 알려 줘요."
          }
        },
        "nb" : {
          "stringUnit" : {
