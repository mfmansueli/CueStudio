    "A platform can recommend another for a video — you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تقترح منصة إعدادًا آخر لفيديو — والقرار لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
