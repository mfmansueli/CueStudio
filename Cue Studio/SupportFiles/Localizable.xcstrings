    "Platforms can recommend another setup per video — you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للمنصات اقتراح إعداد آخر لكل فيديو — وأنت تختار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plattformen können pro Video ein anderes Setup empfehlen — du entscheidest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las plataformas pueden recomendar otro ajuste por vídeo: tú eliges."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plateformes peuvent recommander un autre réglage par vidéo — vous choisissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेटफ़ॉर्म हर वीडियो के लिए अलग सेटअप सुझा सकते हैं — चुनाव आपका।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform bisa merekomendasikan setelan lain per video — kamu yang memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le piattaforme possono consigliare un’altra impostazione per video: scegli tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラットフォームは動画ごとに別の設定を勧めることがありますが、選ぶのはあなたです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랫폼이 영상마다 다른 설정을 추천할 수 있어요 — 선택은 내가 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As plataformas podem recomendar outra configuração por vídeo — você escolhe."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แพลตฟอร์มอาจแนะนำการตั้งค่าอื่นสำหรับแต่ละวิดีโอ — คุณเป็นผู้เลือก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platformlar video başına başka bir ayar önerebilir — seçim senin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nền tảng có thể gợi ý thiết lập khác cho từng video — bạn quyết định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各平台可能为每个视频推荐不同设置 —— 由你决定。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platforms kunnen per video een andere instelling aanbevelen — jij kiest."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plattformar kan rekommendera en annan inställning per video — du väljer."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platforme kan anbefale en anden indstilling pr. video — du vælger."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plattformer kan anbefale et annet oppsett per video — du velger."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平台可能會針對每支影片建議不同的設定 — 由你決定。"
          }
        }
      }
    },
