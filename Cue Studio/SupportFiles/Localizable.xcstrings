    "Emphasis reads best on one or two words a line." : {
      "comment" : "Note under the word chips when more than two words of a caption line are marked for emphasis.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكون الإبراز أوضح على كلمة أو كلمتين في السطر."
