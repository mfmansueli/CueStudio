    "Unlocked by milestones in your universe. First Light, Deep Space and Constellation come with Pro." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفتح عبر محطات كونك. First Light وDeep Space وConstellation مع Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werden durch Meilensteine in deinem Universum frei. First Light, Deep Space und Constellation gehören zu Pro."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se desbloquean con hitos de tu universo. First Light, Deep Space y Constellation vienen con Pro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Débloquées par les étapes de ton univers. First Light, Deep Space et Constellation sont avec Pro."
