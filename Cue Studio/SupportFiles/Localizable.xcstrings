    "Share one tool or habit that makes a real difference, and how to start." : {
      "comment" : "Find inspiration: the angle of a starter made from the creator's own topic (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك أداة أو عادة تصنع فرقًا حقيقيًا، وكيف تبدأ بها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del et værktøj eller en vane, der gør en reel forskel, og hvordan man kommer i gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
