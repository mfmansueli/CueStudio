        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia sua mensagem em voz alta, como numa gravação de verdade."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs ditt meddelande högt, som en riktig inspelning."
          }
