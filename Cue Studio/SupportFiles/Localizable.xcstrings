    "Your take is read and put on the timeline in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقرأ لقطتك وتوضع على المخطط الزمني بعد لحظة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
