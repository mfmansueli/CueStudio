    "Let me tell you what I really think about %@." : {
      "comment" : "Find inspiration: the opening line of a starter made from the creator's own topic (%@ is the topic, as they typed it)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دعني أخبرك برأيي الحقيقي في %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad mig fortælle dig, hvad jeg virkelig mener om %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sag dir, was ich wirklich über %@ denke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déjame contarte lo que de verdad pienso sobre %@."
          }
