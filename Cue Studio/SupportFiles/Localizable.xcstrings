    "Skipped and snoozed questions come back. Your answers stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود الأسئلة المتخطاة والمؤجلة. تبقى إجاباتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversprungne og udskudte spørgsmål kommer tilbage. Dine svar bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übersprungene und verschobene Fragen kommen zurück. Deine Antworten bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las preguntas omitidas y pospuestas vuelven. Tus respuestas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les questions ignorées ou reportées reviennent. Tes réponses restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोड़े और टाले गए सवाल लौट आएँगे। आपके जवाब बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pertanyaan yang dilewati dan ditunda kembali. Jawabanmu tetap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le domande saltate o rimandate tornano. Le tue risposte restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキップや保留した質問が戻ります。回答はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건너뛰거나 미룬 질문이 다시 나와요. 답변은 그대로예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoppede over og utsatte spørsmål kommer tilbake. Svarene dine blir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overgeslagen en uitgestelde vragen komen terug. Je antwoorden blijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perguntas puladas e adiadas voltam. Suas respostas ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Överhoppade och uppskjutna frågor kommer tillbaka. Dina svar finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำถามที่ข้ามหรือเลื่อนไว้จะกลับมา คำตอบของคุณยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlanan ve ertelenen sorular geri gelir. Cevapların kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các câu hỏi đã bỏ qua hoặc hoãn sẽ quay lại. Câu trả lời của bạn vẫn giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳过和推迟的问题会再次出现，你的回答会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳過和延後的問題會再次出現，你的回答會保留。"
          }
        }
      }
    },
