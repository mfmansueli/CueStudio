    "Read your message out loud, like a real take." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ رسالتك بصوت عالٍ، كأنها لقطة حقيقية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs din besked højt, som en rigtig optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies deine Nachricht laut vor, wie bei einer echten Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee tu mensaje en voz alta, como en una toma real."
          }
