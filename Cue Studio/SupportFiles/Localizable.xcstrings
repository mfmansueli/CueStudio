        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“알람이랑 저는 친구가 아니에요.”"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Vekkerklokka og jeg er ikke venner.»"
