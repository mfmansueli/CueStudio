    "This edit keeps its first sound treatment until you change a setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ هذا التعديل بمعالجة الصوت الأولى حتى تغيّر إعدادًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Bearbeitung behält ihre erste Tonbearbeitung, bis du eine Einstellung änderst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta edición mantiene su primer tratamiento de sonido hasta que cambies un ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce montage garde son premier traitement du son jusqu’à ce que vous changiez un réglage."
