            "state" : "translated",
            "value" : "Sebentar lagi %@. Ini satu hal yang perlu kalian tahu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca poco: %@. Ecco una cosa che vale la pena sapere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もうすぐ%@。知っておきたいことをひとつ紹介します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, 이제 얼마 안 남았어요. 알아 두면 좋은 것 하나 알려 드릴게요."
          }
        },
        "nb" : {
