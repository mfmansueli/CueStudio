        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản chỉnh này giữ cách xử lý âm thanh đầu tiên cho đến khi bạn đổi một cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你更改设置之前，此剪辑保留最初的声音处理。"
          }
        }
      }
    },
    "This file has no text Cue can read. Scanned PDFs need text recognition first." : {
