    },
    "Allow Camera and Microphone for Cue in Settings to record takes. Studio mode works without them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Cue باستخدام الكاميرا والميكروفون من الإعدادات لتسجيل اللقطات. يعمل وضع Studio بدونهما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Cue in den Einstellungen Kamera und Mikrofon, um Takes aufzunehmen. Der Studio-Modus funktioniert auch ohne."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Cámara y Micrófono para Cue en Ajustes para grabar tomas. El modo Studio funciona sin ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’appareil photo et le micro pour Cue dans Réglages pour enregistrer des prises. Le mode Studio fonctionne sans."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक रिकॉर्ड करने के लिए सेटिंग्स में Cue को कैमरा और माइक्रोफ़ोन की अनुमति दें। Studio मोड इनके बिना भी चलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan Kamera dan Mikrofon untuk Cue di Pengaturan agar bisa merekam take. Mode Studio tetap bisa dipakai tanpa izin itu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti Fotocamera e Microfono per Cue in Impostazioni per registrare le riprese. La modalità Studio funziona anche senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テイクを録画するには、設定でCueのカメラとマイクを許可してください。Studioモードは許可なしでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "테이크를 녹화하려면 설정에서 Cue의 카메라와 마이크를 허용하세요. Studio 모드는 허용 없이도 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita Câmera e Microfone para o Cue em Ajustes para gravar takes. O modo Studio funciona sem eles."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาตกล้องและไมโครโฟนให้ Cue ในการตั้งค่าเพื่ออัดเทค โหมด Studio ใช้ได้โดยไม่ต้องอนุญาต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çekim kaydetmek için Ayarlar'da Cue'ya Kamera ve Mikrofon izni ver. Studio modu bunlar olmadan da çalışır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép Cue dùng Camera và Micrô trong Cài đặt để quay. Chế độ Studio vẫn hoạt động mà không cần chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Cue 使用相机和麦克风以录制镜头。Studio 模式无需这些权限也能使用。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta Camera en Microfoon toe voor Cue in Instellingen om opnames te maken. Studiomodus werkt zonder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt Kamera och Mikrofon för Cue i Inställningar för att spela in. Studioläget fungerar utan dem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillad Kamera og Mikrofon for Cue i Indstillinger for at optage. Studietilstand virker uden dem."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillat Kamera og Mikrofon for Cue i Innstillinger for å ta opp. Studiomodus fungerer uten dem."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Cue 使用相機與麥克風以錄製鏡頭。攝影棚模式無需這些權限。"
          }
        }
      }
    },
