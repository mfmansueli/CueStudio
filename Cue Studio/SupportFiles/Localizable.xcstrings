        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ecco perché i tuoi primi dieci minuti decidono la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
