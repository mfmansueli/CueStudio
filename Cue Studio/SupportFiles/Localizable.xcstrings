          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラアプリでコードをスキャンするか、下の文字を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 앱으로 코드를 스캔하거나, 아래 글자를 입력하세요."
          }
        },
        "nb" : {
