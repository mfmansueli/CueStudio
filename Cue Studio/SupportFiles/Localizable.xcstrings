    "%lld videos carried out into the world since %@. %@ can live on your Home Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld فيديو انطلقت إلى العالم منذ %2$@. يمكن لـ %3$@ أن يسكن شاشتك الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Videos seit %2$@ in die Welt getragen. %3$@ kann auf deinem Home-Bildschirm leben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld vídeos llevados al mundo desde %2$@. %3$@ puede vivir en tu pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld vidéos envoyées dans le monde depuis %2$@. %3$@ peut vivre sur ton écran d’accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ से अब तक %1$lld वीडियो दुनिया तक पहुँचे। %3$@ आपकी होम स्क्रीन पर रह सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld video terbawa ke dunia sejak %2$@. %3$@ bisa tinggal di layar utamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld video portati nel mondo da %2$@. %3$@ può vivere nella tua schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ から %1$lld本の動画が世界へ。%3$@ をホーム画面に置けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 이후 영상 %1$lld개가 세상에 나갔어요. %3$@ 아이콘을 홈 화면에 둘 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld vídeos levados ao mundo desde %2$@. %3$@ pode morar na sua Tela de Início."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งแต่ %2$@ มี %1$lld วิดีโอออกสู่โลก %3$@ อยู่บนหน้าจอโฮมของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ tarihinden beri %1$lld video dünyaya ulaştı. %3$@ ana ekranında yaşayabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Từ %2$@ đã có %1$lld video ra thế giới. %3$@ có thể ở trên Màn hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %2$@ 起已有 %1$lld 个视频走向世界。%3$@ 可以放在你的主屏幕上。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
