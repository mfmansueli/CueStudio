    "Start from an idea, a format or a blank page. Your universe has room for one more star." : {
      "comment" : "Notification body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بفكرة أو صيغة أو صفحة فارغة. في كونك متسع لنجمة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en idé, et format eller en tom side. Dit univers har plads til en stjerne mere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte mit einer Idee, einem Format oder einer leeren Seite. In deinem Universum ist Platz für einen weiteren Stern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una idea, un formato o una página en blanco. Tu universo tiene espacio para una estrella más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez d’une idée, d’un format ou d’une page blanche. Votre univers a de la place pour une étoile de plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी आइडिया, फ़ॉर्मैट या खाली पेज से शुरू करें। आपके यूनिवर्स में एक और तारे की जगह है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai dari ide, format, atau halaman kosong. Semestamu masih punya ruang untuk satu bintang lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti da un’idea, un formato o una pagina vuota. Nel tuo universo c’è posto per un’altra stella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイデア、フォーマット、白紙から始めましょう。あなたの宇宙には、もうひとつ星が入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이디어, 포맷 또는 빈 페이지에서 시작하세요. 내 유니버스에 별 하나가 더 들어갈 자리가 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start med en idé, et format eller en tom side. Universet ditt har plass til én stjerne til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin met een idee, een format of een lege pagina. Je universum heeft ruimte voor nog een ster."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma ideia, um formato ou uma página em branco. Seu universo tem espaço para mais uma estrela."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja med en idé, ett format eller en tom sida. Ditt universum har plats för en stjärna till."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มจากไอเดีย รูปแบบ หรือหน้าว่าง จักรวาลของคุณยังมีที่ให้ดาวอีกดวง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fikirle, bir formatla ya da boş bir sayfayla başla. Evreninde bir yıldıza daha yer var."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu từ một ý tưởng, một định dạng hoặc trang trắng. Vũ trụ của bạn còn chỗ cho thêm một ngôi sao."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从一个想法、一种形式或一张白纸开始。你的宇宙还容得下一颗星。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從一個想法、一種格式或一張白紙開始。你的宇宙還容得下一顆星。"
          }
        }
      }
    },
