    "Auto measures the picture and corrects its light and color. Your own adjustments stay on top." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقيس «تلقائي» الصورة ويصحح إضاءتها وألوانها. تبقى تعديلاتك فوقه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto misst das Bild und korrigiert Licht und Farbe. Deine eigenen Anpassungen bleiben darüber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto mide la imagen y corrige su luz y su color. Tus ajustes se quedan encima."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto mesure l’image et corrige sa lumière et ses couleurs. Tes réglages restent par-dessus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑटो तस्वीर को मापकर उसकी रोशनी और रंग ठीक करता है। आपके अपने एडजस्टमेंट उसके ऊपर रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatis mengukur gambar dan memperbaiki cahaya serta warnanya. Penyesuaianmu tetap berada di atasnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto misura l’immagine e corregge luce e colore. Le tue regolazioni restano sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」は映像を測定して、光と色を補正します。あなたの調整はその上にそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 화면을 측정해 빛과 색을 보정합니다. 직접 조정한 값은 그 위에 그대로 유지됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Auto mede a imagem e corrige a luz e a cor. Seus ajustes continuam por cima."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อัตโนมัติจะวัดภาพแล้วปรับแสงและสีให้ การปรับของคุณยังคงอยู่ด้านบน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otomatik görüntüyü ölçer, ışığını ve rengini düzeltir. Kendi ayarların üstte kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động đo hình ảnh và chỉnh ánh sáng, màu sắc. Các chỉnh sửa của bạn vẫn nằm bên trên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会测量画面并校正光线与色彩。你自己的调整仍保留在其上。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto meet het beeld en corrigeert licht en kleur. Je eigen aanpassingen blijven erbovenop staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto mäter bilden och korrigerar ljus och färg. Dina egna justeringar ligger kvar ovanpå."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto måler billedet og retter lys og farve. Dine egne justeringer ligger oven på."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto måler bildet og korrigerer lys og farge. Dine egne justeringer ligger oppå."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會測量畫面並校正光線與色彩。你自己的調整仍會保留在上方。"
          }
        }
      }
    },
