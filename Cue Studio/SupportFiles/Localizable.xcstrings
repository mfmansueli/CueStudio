    "Stopped. Your captions are as they were." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الإيقاف. الترجمة النصية كما كانت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestoppt. Deine Untertitel sind wie vorher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenido. Tus subtítulos quedan como estaban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté. Vos sous-titres sont inchangés."
          }
