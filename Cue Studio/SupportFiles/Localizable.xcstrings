    "Your mornings aren’t broken. Your first ten minutes are." : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صباحاتك ليست معطوبة. أول عشر دقائق هي المعطوبة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine morgener er ikke ødelagt. Dine første ti minutter er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Morgen sind nicht kaputt. Deine ersten zehn Minuten sind es."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus mañanas no están rotas. Tus primeros diez minutos sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos matins ne sont pas cassés. Vos dix premières minutes, si."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी सुबहें खराब नहीं हैं। पहले दस मिनट खराब हैं।"
          }
