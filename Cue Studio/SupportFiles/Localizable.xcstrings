          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan ve bulanıklık yalnızca önizlemeyi değiştirir — kaydı asla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nền và độ mờ chỉ thay đổi bản xem trước — không bao giờ thay đổi video quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景和模糊只改变预览 — 不影响录制。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
