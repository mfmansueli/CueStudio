            "value" : "Beberapa tulisan tidak dimasukkan ke kutipan: kata yang tidak dipelajari Apple Intelligence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni testi sono stati esclusi dagli estratti: parole da cui Apple Intelligence non impara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部のテキストは抜粋から除外されました。Apple Intelligenceが学習しない言葉が含まれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 글은 발췌에서 제외됐어요. Apple Intelligence가 학습하지 않는 단어가 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen tekster ble utelatt fra utdragene: ord Apple Intelligence ikke lærer av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige teksten zijn weggelaten uit de fragmenten: woorden waar Apple Intelligence niet van leert."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns textos ficaram de fora dos trechos: palavras com as quais a Apple Intelligence não aprende."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vissa texter utelämnades ur utdragen: ord som Apple Intelligence inte lär sig av."
          }
        },
