          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto em tela cheia, sem câmera."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความเต็มจอ ไม่มีกล้อง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
