        }
      }
    },
    "Drag and pinch it on the video. Every clip of this recording sits the same way; on the whole frame it stays as it is." : {
      "comment" : "Split screen panel, Framing tab: note when the main video's area is picked. Its framing applies to every clip of that recording in the split screen; when it fills the whole frame it isn't changed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحبه واضغط بإصبعين على الفيديو. تظهر كل مقاطع هذا التسجيل بالطريقة نفسها؛ وعندما يملأ الإطار كله يبقى كما هو."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk og knib på videoen. Alle klip fra denne optagelse placeres ens; i hele billedet forbliver den, som den er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh es im Video und zoome mit zwei Fingern. Alle Clips dieser Aufnahme sitzen gleich; im ganzen Bild bleibt es, wie es ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrástralo y pellizca en el video. Todos los clips de esta grabación quedan igual; cuando ocupa todo el cuadro, se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites-le glisser et pincez sur la vidéo. Tous les clips de cet enregistrement sont cadrés pareil. En plein cadre, rien ne change."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो पर इसे खींचें और पिंच करें। इस रिकॉर्डिंग की हर क्लिप एक जैसी दिखेगी; पूरे फ़्रेम में यह जैसा है वैसा रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret dan cubit di video. Semua klip dari rekaman ini ditata sama; saat memenuhi bingkai, tetap seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascinalo e pizzica sul video. Tutte le clip di questa registrazione restano uguali; a pieno quadro resta com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画上でドラッグやピンチをしてください。この録画のクリップはすべて同じ配置になります。画面全体に表示されるときはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영상 위에서 드래그하고 핀치하세요. 이 녹화의 모든 클립이 같은 모습이 돼요. 화면 전체에 나올 때는 그대로예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra og knip på videoen. Alle klipp fra dette opptaket plasseres likt; i hele bildet forblir den som den er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep en knijp op de video. Elke clip van deze opname staat hetzelfde; in het volle beeld blijft hij zoals hij is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste e faça pinça no vídeo. Todos os clipes desta gravação ficam do mesmo jeito; quando ele ocupa todo o quadro, fica como está."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra och nyp i videon. Alla klipp från den här inspelningen hamnar likadant; i helbild förblir den som den är."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากและจีบนิ้วบนวิดีโอ ทุกคลิปของการบันทึกนี้จะจัดวางแบบเดียวกัน เมื่อเต็มเฟรมจะคงเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoda sürükle ve sıkıştır. Bu kaydın tüm klipleri aynı şekilde durur; tüm karede olduğu gibi kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo và chụm trên video. Mọi clip của bản quay này đều được đặt giống nhau; khi lấp đầy cả khung hình thì giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在视频上拖移和捏合。这段录制的所有片段都会一样摆放；占满整个画面时保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在影片上拖移和捏合。這段錄影的所有片段都會一樣擺放；佔滿整個畫面時維持不變。"
          }
        }
      }
    },
    "Drag and pinch it on the video." : {
      "comment" : "Split screen panel, Framing tab: note when the support's area is picked",
      "localizations" : {
