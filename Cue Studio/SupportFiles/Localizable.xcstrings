    "Studio Voice works on your recording. You hear it before you keep it." : {
      "comment" : "Discovery notification body (Studio Voice)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل صوت الاستوديو على تسجيلك. تسمعه قبل أن تحتفظ به."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiostemme arbejder på din optagelse. Du hører det, før du beholder det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio-Stimme bearbeitet deine Aufnahme. Du hörst das Ergebnis, bevor du es behältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voz de estudio trabaja sobre tu grabación. La escuchas antes de quedártela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voix studio agit sur votre vidéo. Vous l’écoutez avant de la garder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्टूडियो आवाज़ आपकी रिकॉर्डिंग पर काम करती है। रखने से पहले सुन लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suara Studio bekerja pada rekamanmu. Kamu mendengarnya dulu sebelum memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voce da studio lavora sulla tua registrazione. La ascolti prima di tenerla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタジオ音声が録画の声を整えます。残す前に聞けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스튜디오 음성이 녹화 영상의 목소리를 다듬어요. 적용 전에 먼저 들어 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiostemme jobber med opptaket ditt. Du hører det før du beholder det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiostem werkt op je opname. Je hoort het voordat je het houdt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Voz de estúdio trabalha na sua gravação. Você ouve antes de manter."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studioröst arbetar på din inspelning. Du hör den innan du behåller den."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เสียงสตูดิโอปรับเสียงในวิดีโอของคุณ ได้ฟังก่อนเก็บไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stüdyo Sesi kaydın üzerinde çalışır. Saklamadan önce dinlersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giọng studio xử lý bản quay của bạn. Bạn nghe thử trước khi giữ lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音棚人声会处理你的录音，保留前可以先听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音室人聲會處理你的錄音，保留前可以先聽。"
          }
        }
      }
    },
