        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica por qué descansar ayuda a progresar en lugar de frenarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expliquez pourquoi le repos aide à progresser au lieu de ralentir."
