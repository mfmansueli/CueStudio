    "Your styles go here. Style the captions, then Save style." : {
      "comment" : "Empty state of the Mine filter; 'Save style' is the card's name.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر أنماطك هنا. نسّق الترجمة النصية، ثم اضغط «حفظ النمط»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine stilarter kommer her. Style underteksterne, og tryk så på Gem stil."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier landen deine Stile. Gestalte die Untertitel und tippe dann auf „Stil sichern“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí van tus estilos. Dale estilo a los subtítulos y luego toca Guardar estilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos styles apparaîtront ici. Mettez en forme les sous-titres, puis touchez Enregistrer le style."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके स्टाइल यहाँ आएँगे। कैप्शन को स्टाइल करें, फिर स्टाइल सेव करें पर टैप करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gayamu akan muncul di sini. Atur gaya teks, lalu ketuk Simpan gaya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui trovi i tuoi stili. Personalizza i sottotitoli, poi tocca Salva stile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のスタイルはここに表示されます。字幕を整えて「スタイルを保存」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나의 스타일은 여기에 표시돼요. 자막을 꾸민 다음 스타일 저장을 탭하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stilene dine havner her. Style undertekstene, og trykk så på Lagre stil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je stijlen komen hier. Geef de ondertitels stijl en tik dan op Bewaar stijl."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus estilos ficam aqui. Estilize as legendas e toque em Salvar estilo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina stilar hamnar här. Styla undertexterna och tryck sedan på Spara stil."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สไตล์ของคุณจะอยู่ที่นี่ ปรับแต่งคำบรรยาย แล้วแตะบันทึกสไตล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stillerin burada görünür. Altyazıları biçimlendir, sonra Stili kaydet’e dokun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểu của bạn sẽ ở đây. Tạo kiểu cho phụ đề, rồi chạm Lưu kiểu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的样式会显示在这里。设置好字幕样式后，轻点“存储样式”。"
