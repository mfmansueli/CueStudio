    "Translated on your iPhone with Apple’s Translation. Nothing is sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُترجم على الـ iPhone باستخدام الترجمة من Apple. لا يُرسل أي شيء إلى أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem iPhone mit Apples Übersetzen übersetzt. Nichts wird irgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traducido en tu iPhone con la Traducción de Apple. No se envía nada a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit sur votre iPhone avec Traduire d’Apple. Rien n’est envoyé nulle part."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple के Translation से आपके iPhone पर अनुवाद। कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diterjemahkan di iPhone-mu dengan Terjemahan Apple. Tidak ada yang dikirim ke mana pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradotto sul tuo iPhone con Traduci di Apple. Nulla viene inviato altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleのTranslationでiPhone上で翻訳します。どこにも送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 번역으로 iPhone에서 번역합니다. 어디에도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduzido no seu iPhone com o Tradutor da Apple. Nada é enviado a lugar nenhum."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลบน iPhone ของคุณด้วยการแปลของ Apple ไม่มีอะไรถูกส่งออกไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple’ın Çeviri’siyle iPhone’unda çevrilir. Hiçbir şey hiçbir yere gönderilmez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được dịch trên iPhone bằng Dịch thuật của Apple. Không gửi gì ra ngoài."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple 翻译在你的 iPhone 上完成翻译。不会发送到任何地方。"
          }
        }
      }
    },
    "Translating on your iPhone…" : {
      "localizations" : {
        "ar" : {
