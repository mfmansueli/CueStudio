        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Meu despertador e eu não somos amigos.”"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Min väckarklocka och jag är inte vänner.”"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“นาฬิกาปลุกกับฉันไม่ได้เป็นเพื่อนกัน”"
