    "If meal prep sounds like a whole Sunday gone, try this smaller version." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا بدا لك تحضير الوجبات وكأنه يأخذ يوم الأحد كله، جرّب هذه النسخة الأصغر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis madplanlægning lyder som en hel søndag, så prøv den her mindre version."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
