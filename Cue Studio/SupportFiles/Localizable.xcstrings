        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音跟随需要下载%@。请连接互联网后重试。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor Stem volgen moet %@ worden gedownload. Maak verbinding met internet en probeer het opnieuw."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Följ rösten behöver ladda ned %@. Anslut till internet och försök igen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Følg stemmen skal downloade %@. Opret forbindelse til internettet, og prøv igen."
