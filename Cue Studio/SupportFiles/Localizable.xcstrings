        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok सिर्फ़ एक मिनट से लंबे वीडियो पर Creator Rewards देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok hanya membayar Creator Rewards untuk video lebih dari satu menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok paga i Creator Rewards solo per i video più lunghi di un minuto."
          }
