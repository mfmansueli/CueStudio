          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du lägger det här i varukorgen, hör vad jag har att säga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนจะกดใส่ตะกร้า ฟังกันก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunları sepete eklemeden önce beni bir dinle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi cho mấy món này vào giỏ, nghe mình nói đã."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
