    "Explain why rest helps progress instead of slowing it." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرح لماذا تساعد الراحة على التقدم بدلًا من إبطائه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forklar, hvorfor hvile hjælper på fremskridtet i stedet for at bremse det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erklär, warum Pausen Fortschritt bringen, statt ihn zu bremsen."
