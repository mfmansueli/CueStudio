    "Most creators overthink the camera and underthink the first line." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفكر معظم صنّاع المحتوى في الكاميرا أكثر من اللازم، وفي الجملة الأولى أقل من اللازم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die meisten Creator denken zu viel über die Kamera nach und zu wenig über den ersten Satz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de creadores piensa demasiado en la cámara y demasiado poco en la primera frase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des créateurs pensent trop à la caméra et pas assez à la première phrase."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़्यादातर क्रिएटर कैमरे के बारे में ज़्यादा और पहली लाइन के बारे में कम सोचते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebanyakan kreator terlalu memikirkan kamera dan kurang memikirkan kalimat pertama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte dei creator pensa troppo alla fotocamera e troppo poco alla prima frase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くのクリエイターはカメラを気にしすぎて、最初のひとことを軽く考えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 크리에이터는 카메라는 너무 고민하고 첫 문장은 너무 대충 생각해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos criadores pensa demais na câmera e de menos na primeira frase."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ครีเอเตอร์ส่วนใหญ่คิดเรื่องกล้องมากเกินไป แต่คิดเรื่องประโยคแรกน้อยเกินไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çoğu içerik üreticisi kamerayı fazla, ilk cümleyi az düşünüyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hầu hết nhà sáng tạo nghĩ quá nhiều về camera và quá ít về câu đầu tiên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数创作者太在意相机，却没好好想第一句话。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meeste creators denken te veel na over de camera en te weinig over de eerste zin."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De flesta skapare grubblar för mycket på kameran och för lite på första raden."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste skabere tænker for meget over kameraet og for lidt over den første linje."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De fleste skapere tenker for mye på kameraet og for lite på første linje."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多數創作者把心思花在鏡頭上，卻忽略了第一句話。"
          }
        }
      }
    },
