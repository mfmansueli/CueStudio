        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store से कनेक्ट नहीं हो सका। कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
