    "Narrate over your edit. Cue explains it before you record." : {
      "comment" : "Discovery notification body (voice-over)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علّق صوتيًا على التعديل. يشرح Cue الأداة قبل أن تسجّل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtal en voiceover over din video. Cue forklarer hvordan, før du optager."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprich über deinen Schnitt. Cue erklärt es dir, bevor du aufnimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narra sobre tu edición. Cue te lo explica antes de grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commentez votre montage. Cue vous l’explique avant d’enregistrer."
