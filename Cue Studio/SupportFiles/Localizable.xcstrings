    "Read at your own pace" : {
      "comment" : "Discovery notification title (Voice Following)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ بإيقاعك"
          }
        },
