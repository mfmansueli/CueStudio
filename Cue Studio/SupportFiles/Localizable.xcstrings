    "Show how to find the quieter spots most visitors skip." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرض كيف تجد الأماكن الأهدأ التي يتخطاها أغلب الزوار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis, hvordan man finder de roligere steder, de fleste besøgende springer over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig, wie man die ruhigeren Orte findet, die die meisten Besucher auslassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cómo encontrar los rincones tranquilos que casi todos se saltan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montrez comment trouver les coins plus calmes que la plupart des visiteurs ratent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दिखाएँ कि वे शांत जगहें कैसे खोजें जिन्हें ज़्यादातर लोग छोड़ देते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunjukkan cara menemukan tempat yang lebih sepi yang dilewatkan kebanyakan pengunjung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra come trovare gli angoli più tranquilli che quasi tutti saltano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多くの人が素通りする静かな場所の見つけ方を見せる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 방문객이 지나치는 조용한 장소를 찾는 법을 보여 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
