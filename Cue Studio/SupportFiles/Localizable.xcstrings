    "Cue Pro exports without limit. Or invite friends: +%lld exports for each." : {
      "comment" : "Card on 'Ready to travel' when the free exports are gone (3 exports per friend).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع Cue Pro تصدّر بلا حدود. أو ادعُ أصدقاءك: +%lld عمليات تصدير عن كل صديق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Cue Pro eksporterer du uden grænser. Eller inviter venner: +%lld eksporter for hver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Cue Pro exportierst du ohne Limit. Oder lade Freunde ein: +%lld Exporte pro Freund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Cue Pro exportas sin límite. O invita amigos: +%lld exportaciones por cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Cue Pro, exportez sans limite. Ou invitez des amis : +%lld exports pour chacun."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro से बिना किसी सीमा के एक्सपोर्ट करें। या दोस्तों को इनवाइट करें: हर दोस्त पर +%lld एक्सपोर्ट।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengan Cue Pro, ekspor tanpa batas. Atau undang teman: +%lld ekspor untuk masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Cue Pro esporti senza limiti. Oppure invita amici: +%lld esportazioni per ognuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Proなら書き出しは無制限。または友だちを招待：1人につき書き出し +%lld回。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro는 내보내기가 무제한이에요. 또는 친구를 초대하세요: 1명당 내보내기 +%lld회."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Cue Pro eksporterer du uten grense. Eller inviter venner: +%lld eksporter for hver."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met Cue Pro exporteer je zonder limiet. Of nodig vrienden uit: +%lld exports per vriend."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Cue Pro, você exporta sem limite. Ou convide amigos: +%lld exportações por amigo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Med Cue Pro exporterar du utan gräns. Eller bjud in vänner: +%lld exporter för varje."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro ส่งออกได้ไม่จำกัด หรือชวนเพื่อน: ส่งออก +%lld ครั้งต่อคน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro ile sınırsız dışa aktar. Ya da arkadaşlarını davet et: her biri için +%lld dışa aktarma."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro xuất không giới hạn. Hoặc mời bạn bè: +%lld lượt xuất cho mỗi người."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro 导出不限次数。或者邀请朋友：每位 +%lld 次导出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue Pro 匯出不限次數。或者邀請朋友：每位 +%lld 次匯出。"
          }
        }
      }
    },
