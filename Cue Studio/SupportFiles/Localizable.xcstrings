        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartilhe seu primeiro vídeo e ele vira uma estrela aqui, ligada à plataforma para a qual viajou."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชร์วิดีโอแรกแล้วมันจะกลายเป็นดาวที่นี่ เชื่อมกับแพลตฟอร์มที่มันเดินทางไป"
