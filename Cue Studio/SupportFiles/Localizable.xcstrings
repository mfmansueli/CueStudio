    "Dictation can’t listen in %@ on this iPhone. You can type your idea instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع الإملاء الاستماع بلغة %@ على هذا الـ iPhone. يمكنك كتابة فكرتك بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird auf diesem iPhone nicht zum Diktieren unterstützt. Du kannst deine Idee stattdessen tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dictado no puede escuchar en %@ en este iPhone. Puedes escribir tu idea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dictée ne peut pas écouter en %@ sur cet iPhone. Vous pouvez écrire votre idée à la place."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर %@ में बोलकर लिखवाना संभव नहीं है। इसके बजाय आप अपना आइडिया लिख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dikte tidak bisa mendengarkan dalam %@ di iPhone ini. Kamu bisa mengetik idemu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dettatura non può ascoltare in %@ su questo iPhone. Puoi scrivere la tua idea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この iPhone では %@ の音声入力に対応していません。代わりにアイデアを入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서는 %@ 음성 입력을 사용할 수 없어요. 대신 아이디어를 직접 입력할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ditado não consegue ouvir em %@ neste iPhone. Você pode digitar sua ideia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone เครื่องนี้ยังไม่รองรับการพูดเป็นข้อความในภาษา %@ คุณพิมพ์ไอเดียแทนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’da sesle yazma %@ dilini dinleyemiyor. Bunun yerine fikrini yazabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này chưa thể nghe bằng %@ để đọc. Bạn có thể gõ ý tưởng của mình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 暂不支持用 %@ 语音输入。你可以改为直接输入想法。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dicteren kan op deze iPhone niet luisteren in %@. Je kunt je idee in plaats daarvan typen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering kan inte lyssna på %@ på den här iPhonen. Du kan skriva din idé i stället."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering kan ikke lytte på %@ på denne iPhone. Du kan skrive din idé i stedet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diktering kan ikke lytte på %@ på denne iPhonen. Du kan skrive ideen din i stedet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 iPhone 的口述功能無法聆聽 %@。你可以改為輸入你的想法。"
          }
        }
      }
    },
