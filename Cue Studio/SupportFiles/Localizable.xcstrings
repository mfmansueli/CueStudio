          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットしたい部分の最初の言葉をタップし、次に最後の言葉をタップします。取り消し線の言葉はカット済みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘라낼 부분의 첫 단어를 탭한 다음 마지막 단어를 탭하세요. 줄이 그어진 단어는 잘라낸 부분이에요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
