    "Cue can't hear you. Allow the microphone in Settings to record sound." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Cue سماعك. اسمح بالميكروفون من الإعدادات لتسجيل الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kann dich nicht hören. Erlaube das Mikrofon in den Einstellungen, um Ton aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue no te oye. Permite el micrófono en Ajustes para grabar sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ne vous entend pas. Autorisez le micro dans Réglages pour enregistrer le son."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue आपको सुन नहीं पा रहा। आवाज़ रिकॉर्ड करने के लिए सेटिंग्स में माइक्रोफ़ोन की अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue tidak bisa mendengarmu. Izinkan mikrofon di Pengaturan untuk merekam suara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue non ti sente. Consenti il microfono in Impostazioni per registrare l’audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueに声が届いていません。音声を録音するには設定でマイクを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 소리를 들을 수 없어요. 소리를 녹음하려면 설정에서 마이크를 허용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue não consegue te ouvir. Permita o microfone em Ajustes para gravar o som."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ไม่ได้ยินเสียงคุณ อนุญาตไมโครโฟนในการตั้งค่าเพื่ออัดเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue seni duyamıyor. Ses kaydetmek için Ayarlar'da mikrofona izin ver."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue không nghe được bạn. Hãy cho phép micrô trong Cài đặt để thu âm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 听不到你的声音。请在“设置”中允许麦克风以录制声音。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan je niet horen. Sta de microfoon toe in Instellingen om geluid op te nemen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan inte höra dig. Tillåt mikrofonen i Inställningar för att spela in ljud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan ikke høre dig. Tillad mikrofonen i Indstillinger for at optage lyd."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan ikke høre deg. Tillat mikrofonen i Innstillinger for å ta opp lyd."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 聽不到你的聲音。請在「設定」中允許使用麥克風以錄製聲音。"
          }
        }
      }
    },
    "Cue can't reach nearby devices. Turn on Local Network for Cue in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع Cue الوصول إلى الأجهزة القريبة. شغّل الشبكة المحلية لـ Cue من الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue erreicht keine Geräte in der Nähe. Aktiviere „Lokales Netzwerk“ für Cue in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue no llega a los dispositivos cercanos. Activa Red local para Cue en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ne peut pas joindre les appareils à proximité. Activez Réseau local pour Cue dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue आस-पास के डिवाइस तक नहीं पहुँच पा रहा। सेटिंग्स में Cue के लिए लोकल नेटवर्क चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue tidak bisa menjangkau perangkat di sekitar. Nyalakan Jaringan Lokal untuk Cue di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue non raggiunge i dispositivi vicini. Attiva Rete locale per Cue in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueが近くのデバイスに接続できません。設定でCueのローカルネットワークをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 주변 기기에 연결할 수 없어요. 설정에서 Cue의 로컬 네트워크를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue não alcança aparelhos por perto. Ative Rede Local para o Cue em Ajustes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue เข้าถึงอุปกรณ์ใกล้เคียงไม่ได้ เปิดเครือข่ายเฉพาะที่ให้ Cue ในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue yakındaki aygıtlara ulaşamıyor. Ayarlar'da Cue için Yerel Ağ'ı aç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue không thể kết nối thiết bị gần đó. Hãy bật Mạng cục bộ cho Cue trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 无法连接附近的设备。请在“设置”中为 Cue 打开“本地网络”。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan apparaten in de buurt niet bereiken. Zet Lokaal netwerk voor Cue aan in Instellingen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue når inte enheter i närheten. Slå på Lokalt nätverk för Cue i Inställningar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kan ikke nå enheder i nærheden. Slå Lokalt netværk til for Cue i Indstillinger."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue når ikke enheter i nærheten. Slå på Lokalt nettverk for Cue i Innstillinger."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 無法連到附近的裝置。請在「設定」中開啟 Cue 的「區域網路」。"
          }
        }
      }
    },
    "Cue can't save to Photos. Allow access in Settings › Privacy › Photos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
