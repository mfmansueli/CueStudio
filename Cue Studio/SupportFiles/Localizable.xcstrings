    "Tap Done in the editor, or pick a best take. It lands here, ready to post." : {
      "comment" : "Takes: what the Ready stage means. No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «تم» في المحرر أو اختر أفضل لقطة، وسيظهر هنا جاهزًا للنشر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Færdig i editoren, eller vælg en bedste optagelse. Den lander her, klar til at blive delt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe im Editor auf „Fertig“ oder wähle einen besten Take. Dann landet das Video hier, bereit zum Posten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca OK en el editor o elige una toma como la mejor: aparecerá aquí, lista para publicar."
