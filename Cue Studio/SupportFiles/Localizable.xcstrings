    "Applies to the whole video, not only to %@." : {
      "comment" : "Quick edit: toast the first time a tool with the whole video's badge is tapped on a picked item's toolbar. %@ is the item's name as the toolbar shows it (Clip 2, Photo, Hook, Music…), so no article before it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُطبَّق على الفيديو كله، وليس على %@ فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gælder hele videoen, ikke kun %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für das ganze Video, nicht nur für %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a todo el video, no solo a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’applique à toute la vidéo, pas seulement à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पूरे वीडियो पर लागू होता है, सिर्फ़ %@ पर नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berlaku untuk seluruh video, bukan hanya %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si applica a tutto il video, non solo a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@だけでなく、動画全体に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@만이 아니라 영상 전체에 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
