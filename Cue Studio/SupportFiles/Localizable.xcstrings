    "Pick what goes. The words, sound and timing stay." : {
      "comment" : "Paste look subtitle",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يُنقل. الكلمات والصوت والتوقيت تبقى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg, hvad der skal med. Ord, lyd og timing bevares."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was mitgeht. Worte, Ton und Timing bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué se copia. Las palabras, el sonido y los tiempos se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez ce qui est collé. Les mots, le son et le timing restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें क्या जाएगा। शब्द, आवाज़ और टाइमिंग वही रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih yang dibawa. Kata, suara, dan waktu tetap."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli cosa copiare. Parole, audio e tempi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移すものを選んでください。言葉・音・タイミングはそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옮길 항목을 고르세요. 단어, 소리, 타이밍은 그대로예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg hva som følger med. Ord, lyd og timing beholdes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies wat meegaat. Woorden, geluid en timing blijven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha o que vai. As palavras, o som e o tempo ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj vad som följer med. Ord, ljud och timing finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกสิ่งที่จะนำไป ข้อความ เสียง และจังหวะคงเดิม"
          }
        },
        "tr" : {
          "stringUnit" : {
