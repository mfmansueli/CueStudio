    "If you only change one thing tomorrow, make it this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إن غيّرت شيئًا واحدًا غدًا، فليكن هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du morgen nur eine Sache änderst, dann diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si mañana solo cambias una cosa, que sea esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous ne changez qu’une chose demain, que ce soit celle-là."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर कल सिर्फ़ एक चीज़ बदलें, तो यह बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau besok kamu cuma mengubah satu hal, ubah yang ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se domani cambi una sola cosa, che sia questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明日ひとつだけ変えるなら、これ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내일 딱 하나만 바꾼다면, 이거예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se for mudar uma coisa só amanhã, que seja esta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าพรุ่งนี้จะเปลี่ยนแค่อย่างเดียว ให้เป็นอันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yarın tek bir şeyi değiştireceksen, bu olsun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu mai chỉ đổi một điều, hãy đổi điều này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明天如果只改一件事，就改这个。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je morgen maar één ding verandert, laat het dit zijn."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du bara ändrar en sak imorgon, låt det vara det här."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du kun ændrer én ting i morgen, så lad det være det her."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du bare endrer én ting i morgen, la det være dette."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果明天你只改變一件事，就改這件。"
          }
        }
      }
    },
