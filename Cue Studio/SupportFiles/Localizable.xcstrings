        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इफ़ेक्ट अपनी रोशनी और छाया खुद बनाता है। बैकग्राउंड या आउटलाइन के लिए इसके बिना वाला स्टाइल चुनें।"
