        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorun değil, yine de alıştırma yapabilirsin. Metin sabit hızda kayacak. Sesini takip etmesi için Ayarlar’dan mikrofonu aç."
          }
