    "The camera works with one app at a time. Use Cue in full screen to record." : {
      "comment" : "Detail under 'The camera is paused' on iPad in Split View or Slide Over",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الكاميرا مع تطبيق واحد في كل مرة. استخدم Cue بملء الشاشة للتسجيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet virker med én app ad gangen. Brug Cue i fuld skærm for at optage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera funktioniert mit einer App gleichzeitig. Nutze Cue im Vollbild, um aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cámara funciona con una app a la vez. Usa Cue a pantalla completa para grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caméra fonctionne avec une seule app à la fois. Utilisez Cue en plein écran pour enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैमरा एक समय में एक ही ऐप के साथ काम करता है। रिकॉर्ड करने के लिए Cue को फ़ुल स्क्रीन में इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera bekerja dengan satu app dalam satu waktu. Gunakan Cue dalam layar penuh untuk merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fotocamera funziona con un’app alla volta. Usa Cue a schermo intero per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラは一度に1つのアプリでしか使えません。録画するには Cue をフルスクリーンで使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라는 한 번에 한 앱에서만 작동해요. 녹화하려면 Cue를 전체 화면으로 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraet fungerer med én app om gangen. Bruk Cue i fullskjerm for å ta opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De camera werkt met één app tegelijk. Gebruik Cue schermvullend om op te nemen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A câmera funciona com um app por vez. Use o Cue em tela cheia para gravar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameran fungerar med en app i taget. Använd Cue i helskärm för att spela in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้องใช้ได้ทีละแอป ใช้ Cue แบบเต็มหน้าจอเพื่ออัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera aynı anda tek bir uygulamayla çalışır. Kaydetmek için Cue’yu tam ekran kullanın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera chỉ hoạt động với một ứng dụng mỗi lúc. Hãy dùng Cue toàn màn hình để quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相机一次只能用于一个 App。请全屏使用 Cue 来录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相機一次只能用於一個 App。請全螢幕使用 Cue 來錄影。"
          }
        }
      }
    },
