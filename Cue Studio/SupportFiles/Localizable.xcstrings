    "Your words appear here to review before you send." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر كلماتك هنا لتراجعها قبل الإرسال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine ord vises her, så du kan gennemse dem, før du sender."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Worte erscheinen hier, damit du sie vor dem Senden prüfen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus palabras aparecen aquí para que las revises antes de enviarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mots apparaissent ici pour que vous les relisiez avant d’envoyer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शब्द यहाँ दिखते हैं, ताकि भेजने से पहले आप उन्हें जाँच सकें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
