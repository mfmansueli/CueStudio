    "Five minutes, a few products, and you’re ready to go." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خمس دقائق، بضعة منتجات، وتكون جاهزًا للخروج."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem minutter, et par produkter, og du er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf Minuten, ein paar Produkte, und du bist startklar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco minutos, unos pocos productos y ya puedes salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq minutes, quelques produits, et c’est parti."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाँच मिनट, कुछ प्रोडक्ट्स, और आप तैयार।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lima menit, beberapa produk, dan kamu siap berangkat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque minuti, pochi prodotti, e si parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5分、少しのアイテムで、もう出かけられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5분, 제품 몇 개면 바로 나갈 준비 끝."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem minutter, noen få produkter, og du er klar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vijf minuten, een paar producten en je bent klaar."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco minutos, poucos produtos e já dá para sair."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem minuter, några produkter och du är redo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 นาที ใช้ไม่กี่ชิ้น ก็พร้อมออกจากบ้าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beş dakika, birkaç ürün ve hazırsın."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năm phút, vài sản phẩm, và bạn đã sẵn sàng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "五分钟，几样产品，就可以出门了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "五分鐘，幾樣產品，就可以出門了。"
