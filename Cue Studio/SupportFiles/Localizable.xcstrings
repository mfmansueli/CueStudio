          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक आकृति चुनें: फ़ोटो या वीडियो का सिर्फ़ उसके अंदर वाला हिस्सा दिखेगा, आसपास नीचे वाला वीडियो।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
