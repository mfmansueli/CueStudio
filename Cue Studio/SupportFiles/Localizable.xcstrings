    "Only changes scripts in languages with a formal “you”." : {
      "comment" : "My Cue Voice › Speak to viewers, under More questions: where the choice has an effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يغيّر إلا النصوص بلغات فيها صيغة رسمية للمخاطَب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændrer kun manuskripter på sprog med en formel tiltaleform."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert nur Skripte in Sprachen mit einem förmlichen „Sie“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia los guiones en idiomas con un “usted”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne change que les scripts dans les langues qui ont un « vous » de politesse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ उन भाषाओं की स्क्रिप्ट बदलता है जिनमें औपचारिक “आप” होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya mengubah naskah dalam bahasa yang punya sapaan formal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambia solo i copioni nelle lingue che hanno un “Lei” di cortesia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "丁寧な呼びかけがある言語の台本だけに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "높임말이 있는 언어의 대본에만 적용돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endrer bare manus på språk med en høflig tiltaleform."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verandert alleen scripts in talen met een beleefd ‘u’."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só muda roteiros em idiomas com um “você” formal."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändrar bara manus på språk med ett artigt tilltal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีผลเฉพาะสคริปต์ในภาษาที่มีคำเรียกแบบสุภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca resmi bir “siz” hitabı olan dillerdeki senaryoları değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ thay đổi kịch bản ở những ngôn ngữ có cách xưng hô trang trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只影响有敬称“您”的语言的脚本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只影響有敬稱「您」的語言的腳本。"
          }
        }
      }
    },
