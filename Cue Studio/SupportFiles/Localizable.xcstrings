        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समझाएँ कि आराम प्रगति को धीमा नहीं, बल्कि मदद क्यों करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan kenapa istirahat membantu kemajuan, bukan memperlambatnya."
