    "A first pass with what you pick. Nothing else changes, and Undo takes it all back." : {
      "comment" : "Auto edit subtitle before running",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمريرة أولى بما تختاره. لا يتغير شيء آخر، و«تراجع» يعيد كل شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En første gennemgang med det, du vælger. Intet andet ændres, og Fortryd tager det hele tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein erster Durchgang mit dem, was du wählst. Sonst ändert sich nichts, und Widerrufen nimmt alles zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una primera pasada con lo que elijas. No cambia nada más y Deshacer lo revierte todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un premier passage avec ce que vous choisissez. Rien d'autre ne change, et Annuler revient sur tout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी चुनी चीज़ों के साथ पहली बार में काम। बाक़ी कुछ नहीं बदलता, और पूर्ववत करें सब वापस ले लेता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langkah pertama dengan pilihanmu. Tidak ada yang lain berubah, dan Urungkan mengembalikan semuanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una prima passata con ciò che scegli. Nient'altro cambia e Annulla riporta tutto indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ内容で最初の編集をします。ほかは変わらず、取り消すとすべて元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고른 것만으로 첫 편집을 해요. 다른 건 바뀌지 않고, 실행 취소하면 모두 되돌아가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En første runde med det du velger. Ingenting annet endres, og Angre tar alt tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eerste ronde met wat je kiest. Verder verandert er niets, en Ongedaan maken draait alles terug."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma primeira passada com o que você escolher. Nada mais muda, e Desfazer volta tudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En första omgång med det du väljer. Inget annat ändras, och Ångra tar tillbaka allt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รอบแรกตามที่คุณเลือก ส่วนอื่นไม่เปลี่ยน และเลิกทำจะย้อนกลับทั้งหมด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçtiklerinle ilk geçiş. Başka hiçbir şey değişmez; Geri Al hepsini geri alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lượt đầu với những gì bạn chọn. Không gì khác thay đổi, và Hoàn tác trả lại tất cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按你的选择做第一遍处理。其他都不会变，撤销即可全部恢复。"
