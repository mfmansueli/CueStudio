    "Phone stays face down for twenty minutes. Total game changer." : {
      "comment" : "My Cue Voice sample script (mornings): the line for 'Some slang' words; keep it casual, with everyday slang of the language",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموبايل مقلوب أول عشرين دقيقة. فرق كبير، صدقني."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilen ligger med skærmen nedad i tyve minutter. Kæmpe forskel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handy bleibt zwanzig Minuten mit dem Display nach unten. Gamechanger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El móvil boca abajo los primeros veinte minutos. Cambia todo, en serio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téléphone face cachée pendant vingt minutes. Ça change tout, franchement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले बीस मिनट फ़ोन उल्टा रखो। सच में, गेम चेंजर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HP ditelungkupin dua puluh menit pertama. Beneran ngubah semuanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefono a faccia in giù per venti minuti. Cambia tutto, giuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の20分はスマホを伏せておく。これ、マジで変わる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처음 20분은 폰 뒤집어 두기. 진짜 완전 달라져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mobilen ligger med skjermen ned i tjue minutter. Skikkelig game changer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefoon twintig minuten met het scherm naar beneden. Echt een gamechanger."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
