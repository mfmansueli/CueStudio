    "Marks the clear pauses, hesitations and earlier tries. Remove takes them out." : {
      "comment" : "VoiceOver hint for Quick pass",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد التوقفات والترددات والمحاولات السابقة الواضحة. «إزالة» يحذفها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerer tydelige pauser, tøven og tidligere forsøg. Fjern tager dem ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert eindeutige Pausen, Zögern und frühere Versuche. Entfernen nimmt sie heraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca las pausas, dudas e intentos anteriores claros. Quitar los recorta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque les pauses, hésitations et essais précédents clairs. Retirer les enlève."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साफ़ ठहराव, अटकनें और पिछली कोशिशें चुनता है। हटाएँ उन्हें निकाल देता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menandai jeda, keraguan, dan percobaan sebelumnya yang jelas. Hapus memotongnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna pause, esitazioni e tentativi precedenti chiari. Rimuovi li toglie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はっきりした間、言いよどみ、前のテイクを選びます。削除で取り除きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확실한 쉼, 머뭇거림, 이전 시도를 표시해요. 제거하면 빠져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerer tydelige pauser, nøling og tidligere forsøk. Fjern tar dem ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeert duidelijke pauzes, aarzelingen en eerdere pogingen. Verwijderen haalt ze weg."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca as pausas, hesitações e tentativas anteriores claras. Remover tira tudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markerar tydliga pauser, tvekanden och tidigare försök. Ta bort tar ut dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำเครื่องหมายช่วงเงียบ คำลังเล และครั้งก่อนที่ชัดเจน ลบจะตัดออก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Net duraklamaları, duraksamaları ve önceki denemeleri işaretler. Kaldır bunları çıkarır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đánh dấu các khoảng lặng, ngập ngừng và lần nói trước rõ ràng. Xóa sẽ bỏ chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标记明确的停顿、迟疑和之前的尝试。删除会去掉它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標記明確的停頓、遲疑和之前的嘗試。刪除會去掉它們。"
          }
        }
      }
    },
