          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっとこの話をしてもいいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠깐 이 얘기 좀 할까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan vi snakke litt om dette?"
