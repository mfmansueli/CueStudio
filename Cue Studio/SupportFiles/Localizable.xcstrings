    "Studio Voice keeps working underneath." : {
      "comment" : "Voice effects panel: one-line note under the effect tiles. The creative effect is applied on top of Studio Voice (Quick edit's voice enhancement and noise reduction), which keeps working under it",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظل صوت الاستوديو يعمل تحت المؤثر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiostemme virker fortsat nedenunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio-Stimme wirkt darunter weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Voz de estudio sigue actuando por debajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voix studio reste active en dessous."
          }
