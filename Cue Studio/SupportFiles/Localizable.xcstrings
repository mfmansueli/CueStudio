    "Control your teleprompter from another device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحكّم في الملقّن من جهاز آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuere deinen Teleprompter von einem anderen Gerät aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla tu teleprompter desde otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôlez votre téléprompteur depuis un autre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने टेलीप्रॉम्प्टर को किसी दूसरे डिवाइस से कंट्रोल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kendalikan teleprompter dari perangkat lain."
