          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zinseszins klingt kompliziert. Er ist einfacher, als du denkst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
