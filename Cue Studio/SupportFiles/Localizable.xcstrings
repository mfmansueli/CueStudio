    "Removes your scripts, takes, edits and My Cue Voice from this iPhone. Videos saved to Photos stay there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل نصوصك ولقطاتك وتعديلاتك وMy Cue Voice من هذا الـ iPhone. تبقى الفيديوهات المحفوظة في الصور."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner dine manuskripter, optagelser, redigeringer og My Cue Voice fra denne iPhone. Videoer gemt i Fotos bliver der."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt deine Skripte, Takes, Bearbeitungen und My Cue Voice von diesem iPhone. In Fotos gesicherte Videos bleiben dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita tus guiones, tomas, ediciones y My Cue Voice de este iPhone. Los vídeos guardados en Fotos se quedan allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime vos scripts, prises, montages et My Cue Voice de cet iPhone. Les vidéos enregistrées dans Photos y restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone से आपकी स्क्रिप्ट, टेक, एडिट और My Cue Voice हट जाते हैं। Photos में सेव वीडियो वहीं रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus naskah, take, suntingan, dan My Cue Voice dari iPhone ini. Video yang disimpan di Foto tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove da questo iPhone script, riprese, montaggi e My Cue Voice. I video salvati in Foto restano lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneからスクリプト、テイク、編集、My Cue Voiceを削除します。写真に保存した動画はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 스크립트, 테이크, 편집, My Cue Voice를 삭제해요. 사진에 저장한 영상은 그대로 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner manus, opptak, redigeringer og My Cue Voice fra denne iPhonen. Videoer lagret i Bilder blir værende."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert je scripts, opnamen, bewerkingen en My Cue Voice van deze iPhone. Video’s die in Foto’s staan blijven daar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove seus roteiros, takes, edições e My Cue Voice deste iPhone. Vídeos salvos em Fotos continuam lá."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort dina manus, tagningar, redigeringar och My Cue Voice från den här iPhonen. Videor sparade i Bilder finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบสคริปต์ เทค การตัดต่อ และ My Cue Voice ออกจาก iPhone เครื่องนี้ วิดีโอที่บันทึกใน รูปภาพ จะยังอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metinlerini, çekimlerini, düzenlemelerini ve My Cue Voice'u bu iPhone'dan kaldırır. Fotoğraflar'a kaydedilen videolar orada kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa kịch bản, cảnh quay, bản chỉnh sửa và My Cue Voice khỏi iPhone này. Video đã lưu vào Ảnh vẫn còn ở đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从这台 iPhone 移除你的脚本、镜头、剪辑和 My Cue Voice。已存入“照片”的视频会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將從這台 iPhone 移除你的腳本、鏡頭、剪輯和 My Cue Voice。已存入「照片」的影片會保留。"
          }
        }
      }
    },
    "Renews monthly at %@. Cancel anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد شهريًا بسعر %@. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes månedligt til %@. Opsig når som helst i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich monatlich für %@. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva cada mes por %@. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement mensuel à %@. Résiliable à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर महीने %@ पर रिन्यू होता है। सेटिंग्स में कभी भी रद्द करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang tiap bulan seharga %@. Batalkan kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova ogni mese a %@. Annulli quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月%@で自動更新。設定からいつでも解約できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매월 %@에 갱신돼요. 설정에서 언제든 해지할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes månedlig for %@. Si opp når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlengt maandelijks voor %@. Altijd opzegbaar in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova todo mês por %@. Cancele quando quiser em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas månadsvis för %@. Avsluta när du vill i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่ออายุทุกเดือนที่ %@ ยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ay %@ ücretle yenilenir. İstediğin zaman Ayarlar'dan iptal et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia hạn hằng tháng với giá %@. Hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月以 %@ 续订。可随时在“设置”中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月以 %@ 自動續訂。可隨時在「設定」中取消。"
          }
        }
      }
    },
