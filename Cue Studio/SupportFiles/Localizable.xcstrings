        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence bu kelimelerden öğrenmez. Bunları sansürle (f***) ya da başka bir örnek seç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có từ mà Apple Intelligence sẽ không học. Hãy che chúng (f***) hoặc chọn ví dụ khác."
          }
        },
        "zh-Hans" : {
