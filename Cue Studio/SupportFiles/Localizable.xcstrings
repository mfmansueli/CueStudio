    "%@ Cue will build a structured draft from your bullets instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سيُنشئ Cue بدلاً من ذلك مسودة منظّمة من نقاطك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue baut stattdessen aus deinen Stichpunkten einen strukturierten Entwurf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue armará un borrador estructurado a partir de tus puntos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue créera plutôt un brouillon structuré à partir de vos points."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इसके बजाय Cue आपके पॉइंट्स से एक स्ट्रक्चर्ड ड्राफ़्ट बनाएगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue akan membuat draf terstruktur dari poin-poinmu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue creerà invece una bozza strutturata dai tuoi punti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 代わりに、Cueが箇条書きから構成済みの下書きを作ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 대신 Cue가 요점을 바탕으로 구조를 갖춘 초안을 만들어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ O Cue vai montar um rascunho estruturado a partir dos seus tópicos."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue จะสร้างร่างที่มีโครงสร้างจากหัวข้อย่อยของคุณแทน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue bunun yerine maddelerinden yapılandırılmış bir taslak hazırlayacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Thay vào đó, Cue sẽ dựng bản nháp có cấu trúc từ các ý của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Cue 会改为根据你的要点生成结构化草稿。"
          }
        }
      }
    },
