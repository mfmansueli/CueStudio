    "Compare affordable picks with the expensive ones people buy." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن بين خيارات معقولة السعر والمنتجات الغالية التي يشتريها الناس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign billige valg med de dyre, folk køber."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche günstige Alternativen mit den teuren, die alle kaufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara opciones accesibles con las caras que la gente compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez des choix abordables avec les produits chers que les gens achètent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सस्ते विकल्पों की तुलना उन महंगे प्रोडक्ट्स से करें जो लोग खरीदते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan pilihan terjangkau dengan yang mahal yang biasa dibeli orang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta alternative accessibili con quelle costose che la gente compra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手頃なアイテムと、みんなが買う高価なものを比べる。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저렴한 제품과 사람들이 사는 비싼 제품을 비교하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign rimelige valg med de dyre folk kjøper."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk betaalbare keuzes met de dure die mensen kopen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare opções acessíveis com as caras que as pessoas compram."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför prisvärda val med de dyra som folk köper."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบของราคาย่อมเยากับของแพงที่คนนิยมซื้อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygun fiyatlı seçenekleri insanların aldığı pahalılarla karşılaştır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh lựa chọn giá mềm với những món đắt tiền mọi người hay mua."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把平价之选和大家常买的贵价产品做个对比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把平價之選和大家常買的貴價產品做個對比。"
          }
        }
      }
    },
    "Compare both orders and who each one suits." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن بين الترتيبين ولمن يناسب كل منهما."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign begge rækkefølger, og hvem hver passer til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche beide Reihenfolgen und für wen welche passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara ambos órdenes y para quién sirve cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez les deux ordres et à qui chacun convient."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोनों क्रमों की तुलना करें और बताएँ कि कौन-सा किसके लिए सही है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandingkan kedua urutan dan cocok untuk siapa masing-masing."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta i due ordini e a chi è adatto ciascuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方の順番を比べ、それぞれ誰に合うかを伝える。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 순서를 비교하고 각각 누구에게 맞는지 알려 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign begge rekkefølgene og hvem hver passer for."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk beide volgordes en voor wie elk past."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare as duas ordens e para quem cada uma serve."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jämför båda ordningarna och vem var och en passar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปรียบเทียบทั้งสองลำดับ และแต่ละแบบเหมาะกับใคร"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İki sırayı karşılaştır ve hangisinin kime uygun olduğunu söyle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sánh hai thứ tự và mỗi cách phù hợp với ai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比较两种顺序，以及各自适合什么人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較兩種順序，以及各自適合什麼人。"
          }
        }
      }
    },
    "Compare where quality matters and where cheap is fine." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن بين ما تهم فيه الجودة وما لا بأس فيه بالرخيص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
