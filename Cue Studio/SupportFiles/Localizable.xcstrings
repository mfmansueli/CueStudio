        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माइलस्टोन से अनलॉक करें। कुछ Pro के साथ मिलते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka dengan pencapaian. Beberapa datang bersama Pro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sbloccano con i traguardi. Alcune arrivano con Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイルストーンで解放されます。一部はProに含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마일스톤을 달성하면 열려요. 일부는 Pro에 포함돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låses opp med milepæler. Noen følger med Pro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendel met mijlpalen. Sommige horen bij Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desbloqueie com marcos. Alguns vêm com o Pro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låses upp med milstolpar. Vissa ingår i Pro."
          }
        },
