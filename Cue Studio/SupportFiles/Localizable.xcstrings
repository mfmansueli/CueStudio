    "Read at your own pace: the text moves when you speak and waits when you pause." : {
      "comment" : "Introduction benefit (Voice Following)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ بإيقاعك: يتحرك النص عندما تتكلم وينتظر عندما تتوقف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs i dit eget tempo: teksten bevæger sig, når du taler, og venter, når du holder pause."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies in deinem Tempo: Der Text läuft, wenn du sprichst, und wartet, wenn du pausierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee a tu ritmo: el texto avanza cuando hablas y espera cuando haces una pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez à votre rythme : le texte avance quand vous parlez et attend quand vous faites une pause."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी रफ़्तार से पढ़ें: बोलने पर टेक्स्ट चलता है और रुकने पर इंतज़ार करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baca sesuai tempomu: teks bergerak saat kamu bicara dan menunggu saat kamu jeda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggi al tuo ritmo: il testo scorre quando parli e aspetta quando fai una pausa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のペースで：話すとテキストが進み、止まると待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 속도로: 말하면 텍스트가 움직이고 멈추면 기다려요."
          }
        },
        "nb" : {
          "stringUnit" : {
