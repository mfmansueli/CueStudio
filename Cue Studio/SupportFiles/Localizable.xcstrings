    "Renews monthly at %@. Cancel anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد شهريًا بسعر %@. يمكنك الإلغاء في أي وقت من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes månedligt til %@. Opsig når som helst i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich monatlich für %@. Jederzeit in den Einstellungen kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva cada mes por %@. Cancela cuando quieras en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement mensuel à %@. Résiliable à tout moment dans Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर महीने %@ पर रिन्यू होता है। सेटिंग्ज़ में कभी भी रद्द करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diperpanjang tiap bulan seharga %@. Batalkan kapan saja di Pengaturan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova ogni mese a %@. Annulla quando vuoi in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎月%@で自動更新。設定からいつでもキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매월 %@에 갱신돼요. 설정에서 언제든 취소할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fornyes månedlig for %@. Si opp når som helst i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlengt maandelijks voor %@. Altijd opzegbaar in Instellingen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renova todo mês por %@. Cancele quando quiser em Ajustes."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förnyas varje månad för %@. Avsluta när du vill i Inställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต่ออายุทุกเดือนที่ %@ ยกเลิกได้ทุกเมื่อในการตั้งค่า"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her ay %@ ücretle yenilenir. İstediğin zaman Ayarlar’dan iptal et."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gia hạn hằng tháng với giá %@. Hủy bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月以 %@ 续订。可随时在“设置”中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每月以 %@ 自動續訂。可隨時在「設定」中取消。"
          }
        }
      }
    },
