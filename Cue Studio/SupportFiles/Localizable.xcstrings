    "Turn on Enhance voice or Reduce noise to compare." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل تحسين الصوت أو تقليل الضوضاء للمقارنة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Stimme verbessern“ oder „Rauschen reduzieren“, um zu vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Mejorar voz o Reducir ruido para comparar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Améliorer la voix ou Réduire le bruit pour comparer."
