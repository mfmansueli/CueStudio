    "Open with the POV line, set the scene in a few words, and end on a twist. Short and visual." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بسطر POV، وصف المشهد بكلمات قليلة، وانتهِ بمفاجأة. قصير وبصري."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn med POV-linjen, sæt scenen med få ord, og slut med en vending. Kort og visuelt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte mit der POV-Zeile, beschreibe die Szene in wenigen Worten und ende mit einer Wendung. Kurz und visuell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre con la línea POV, sitúa la escena en pocas palabras y cierra con un giro. Corto y visual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez avec la ligne POV, posez la scène en quelques mots et finissez sur un rebondissement. Court et visuel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POV लाइन से शुरू करें, कुछ शब्दों में दृश्य बताएँ और मोड़ पर ख़त्म करें। छोटा और विज़ुअल।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka dengan kalimat POV, gambarkan suasana dalam beberapa kata, lalu tutup dengan kejutan. Singkat dan visual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri con la riga POV, descrivi la scena in poche parole e chiudi con un colpo di scena. Breve e visivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POVの一言で始め、数語で場面を作り、どんでん返しで締めます。短く、映像的に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POV 문장으로 시작해 몇 마디로 장면을 만들고 반전으로 끝내요. 짧고 시각적으로."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne med POV-linjen, sett scenen med få ord og avslutt med et vri. Kort og visuelt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open met de POV-regel, zet de scène neer in een paar woorden en eindig met een wending. Kort en beeldend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra com a linha POV, monte a cena em poucas palavras e termine com uma reviravolta. Curto e visual."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna med POV-raden, sätt scenen med några ord och avsluta med en vändning. Kort och visuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดด้วยบรรทัด POV เล่าฉากด้วยไม่กี่คำ แล้วจบด้วยจุดหักมุม สั้นและเห็นภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POV cümlesiyle aç, sahneyi birkaç sözcükle kur ve bir sürprizle bitir. Kısa ve görsel."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mở bằng câu POV, dựng cảnh trong vài từ rồi kết bằng một bước ngoặt. Ngắn và giàu hình ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句 POV 开场，几个词交代场景，最后来个反转。短而有画面感。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句 POV 開場，幾個詞交代場景，最後來個反轉。短而有畫面感。"
          }
        }
      }
    },
