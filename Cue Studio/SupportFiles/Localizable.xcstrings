    "Plan the hooks, pick one outfit, set one light, film in order" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطّط الافتتاحيات، اختر زيًا واحدًا، ضع إضاءة واحدة، صوّر بالترتيب"
          }
        },
        "de" : {
          "stringUnit" : {
