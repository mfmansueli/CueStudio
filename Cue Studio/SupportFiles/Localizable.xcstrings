    "One: no phone for the first twenty minutes. I leave it in the kitchen." : {
      "comment" : "Settings › Prompter preview: second line of the sample script scrolling in the preview.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أولاً: لا هاتف في أول عشرين دقيقة. أتركه في المطبخ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
