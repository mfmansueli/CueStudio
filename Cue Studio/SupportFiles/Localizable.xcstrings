    "Invite viewers to a simple challenge and explain each step." : {
      "comment" : "Find inspiration: the angle of a starter made from the creator's own topic (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادعُ المشاهدين إلى تحدٍّ بسيط واشرح كل خطوة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviter seerne til en enkel udfordring, og forklar hvert trin."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad dein Publikum zu einer einfachen Challenge ein und erklär jeden Schritt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a tu audiencia a un reto sencillo y explica cada paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez votre public à un défi simple et expliquez chaque étape."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्शकों को एक आसान चैलेंज के लिए बुलाएँ और हर कदम समझाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajak penonton ikut tantangan sederhana dan jelaskan tiap langkahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita chi guarda a una sfida semplice e spiega ogni passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
