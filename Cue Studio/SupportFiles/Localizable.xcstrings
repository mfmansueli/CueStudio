    "After posting, tap ◀ Cue at the top left. We'll come back to finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد النشر، اضغط ◀ Cue في أعلى اليسار. سنعود لننهي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har slået op, tryk ◀ Cue øverst til venstre. Vi vender tilbage for at afslutte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe nach dem Posten oben links auf ◀ Cue. Wir kommen zurück, um abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de publicar, toca ◀ Cue arriba a la izquierda. Volveremos para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la publication, touchez ◀ Cue en haut à gauche. Nous reviendrons pour terminer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट करने के बाद ऊपर बाईं ओर ◀ Cue पर टैप करें। हम खत्म करने के लिए लौट आएँगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah memposting, ketuk ◀ Cue di kiri atas. Kami akan kembali untuk menyelesaikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver pubblicato, tocca ◀ Cue in alto a sinistra. Torneremo per finire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿したら、左上の ◀ Cue をタップ。最後にここへ戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시한 후 왼쪽 위의 ◀ Cue를 탭하세요. 마무리하러 돌아올게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter at du har postet, trykk ◀ Cue øverst til venstre. Vi kommer tilbake for å fullføre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik na het posten linksboven op ◀ Cue. We komen terug om af te ronden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de postar, toque em ◀ Cue no canto superior esquerdo. Vamos voltar para terminar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har postat, tryck på ◀ Cue högst upp till vänster. Vi kommer tillbaka för att avsluta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังโพสต์ ให้แตะ ◀ Cue ที่มุมซ้ายบน แล้วเราจะกลับมาเพื่อจบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaştıktan sonra sol üstteki ◀ Cue’ya dokun. Bitirmek için geri döneceğiz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi đăng, chạm ◀ Cue ở góc trên bên trái. Chúng tôi sẽ quay lại để kết thúc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布后，点按左上角的 ◀ Cue。我们会回来收尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發布後，輕點左上角的 ◀ Cue。我們會回來收尾。"
          }
        }
      }
    },
    "After posting, tap ◀ Cue at the top left. We'll open %@ next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد النشر، اضغط ◀ Cue في أعلى اليسار. سنفتح %@ بعد ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har slået op, tryk ◀ Cue øverst til venstre. Så åbner vi %@ næste gang."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe nach dem Posten oben links auf ◀ Cue. Als Nächstes öffnen wir %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de publicar, toca ◀ Cue arriba a la izquierda. Abriremos %@ a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la publication, touchez ◀ Cue en haut à gauche. Nous ouvrirons ensuite %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट करने के बाद ऊपर बाईं ओर ◀ Cue पर टैप करें। हम आगे %@ खोलेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah memposting, ketuk ◀ Cue di kiri atas. Kami akan membuka %@ berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver pubblicato, tocca ◀ Cue in alto a sinistra. Poi apriremo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿したら、左上の ◀ Cue をタップ。次は%@を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시한 후 왼쪽 위의 ◀ Cue를 탭하세요. 다음은 %@을(를) 열게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etter at du har postet, trykk ◀ Cue øverst til venstre. Vi åpner %@ neste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik na het posten linksboven op ◀ Cue. Daarna openen we %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de postar, toque em ◀ Cue no canto superior esquerdo. Abriremos %@ em seguida."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har postat, tryck på ◀ Cue högst upp till vänster. Vi öppnar %@ härnäst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังโพสต์ ให้แตะ ◀ Cue ที่มุมซ้ายบน แล้วเราจะเปิด %@ ต่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaştıktan sonra sol üstteki ◀ Cue’ya dokun. Sıradaki: %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi đăng, chạm ◀ Cue ở góc trên bên trái. Tiếp theo chúng tôi sẽ mở %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布后，点按左上角的 ◀ Cue。接下来我们会打开 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發布後，輕點左上角的 ◀ Cue。接下來我們會開啟 %@。"
          }
        }
      }
    },
