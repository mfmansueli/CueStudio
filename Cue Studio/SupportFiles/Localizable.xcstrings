    "Scripts that sound more like you. Four questions, and you can change any answer." : {
      "comment" : "Introduction benefit (My Cue Voice)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصوص تشبه أسلوبك أكثر. أربعة أسئلة، ويمكنك تغيير أي إجابة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuskripter, der lyder mere som dig. Fire spørgsmål, og du kan ændre alle svar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skripte, die mehr nach dir klingen. Vier Fragen, und du kannst jede Antwort ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guiones que suenan más como tú. Cuatro preguntas, y puedes cambiar cualquier respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des scripts qui vous ressemblent davantage. Quatre questions, et chaque réponse reste modifiable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी स्क्रिप्ट जो आपकी तरह लगें। चार सवाल, और कोई भी जवाब बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskah yang terdengar lebih seperti kamu. Empat pertanyaan, dan semua jawaban bisa diubah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copioni che ti somigliano di più. Quattro domande, e puoi cambiare ogni risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もっと自分らしい台本に。質問は4つ、答えはいつでも変えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 나다운 대본. 질문은 네 개뿐이고 답은 언제든 바꿀 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus som høres mer ut som deg. Fire spørsmål, og du kan endre alle svar."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scripts die meer als jou klinken. Vier vragen, en je kunt elk antwoord wijzigen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roteiros com mais a sua cara. Quatro perguntas, e você pode mudar qualquer resposta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manus som låter mer som du. Fyra frågor, och du kan ändra alla svar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สคริปต์ที่เป็นตัวคุณมากขึ้น ตอบสี่คำถาม และเปลี่ยนคำตอบได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha çok sana benzeyen senaryolar. Dört soru, her yanıtı değiştirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kịch bản giống giọng bạn hơn. Bốn câu hỏi, và bạn có thể đổi mọi câu trả lời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让脚本更像你。只需四个问题，答案随时可改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓腳本更像你。只需四個問題，答案隨時可改。"
          }
        }
      }
    },
