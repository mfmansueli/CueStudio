    "Top left of the screen. Cue takes you to the next network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى يسار الشاشة. ينقلك Cue إلى الشبكة التالية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øverst til venstre på skærmen. Cue tager dig videre til det næste netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben links auf dem Bildschirm. Cue bringt dich zum nächsten Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba a la izquierda de la pantalla. Cue te lleva a la siguiente red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En haut à gauche de l’écran. Cue vous emmène vers le réseau suivant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के ऊपर बाईं ओर। Cue आपको अगले नेटवर्क पर ले जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di kiri atas layar. Cue membawamu ke jaringan berikutnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In alto a sinistra sullo schermo. Cue ti porta alla rete successiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の左上です。Cueが次のネットワークへ案内します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 왼쪽 위에 있어요. Cue가 다음 네트워크로 안내해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øverst til venstre på skjermen. Cue tar deg til neste nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linksboven op het scherm. Cue brengt je naar het volgende netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
