          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue sẽ cuộn chữ ngay dưới ống kính. Camera của bạn giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
