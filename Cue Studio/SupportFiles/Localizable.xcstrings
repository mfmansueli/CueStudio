    "There are two common ways to approach %@. Let’s compare them." : {
      "comment" : "Find inspiration: the opening line of a starter made from the creator's own topic, said on camera (%@ is the topic, as they typed it)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك طريقتان شائعتان للتعامل مع %@. لنقارن بينهما."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er to almindelige måder at gribe %@ an på. Lad os sammenligne dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei %@ gibt es zwei gängige Wege. Vergleichen wir sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay dos formas comunes de encarar %@. Vamos a compararlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il y a deux façons courantes d’aborder %@. Comparons-les."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के लिए दो आम तरीके हैं। चलिए, दोनों की तुलना करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada dua cara umum untuk %@. Yuk, kita bandingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono due modi comuni di affrontare %@. Mettiamoli a confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@には、よくある2つのやり方があります。比べてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 흔한 방법이 두 가지 있어요. 비교해 볼게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er to vanlige måter å gripe an %@ på. La oss sammenligne dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er zijn twee gangbare manieren om %@ aan te pakken. Laten we ze vergelijken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem dois jeitos comuns de encarar %@. Vamos comparar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns två vanliga sätt att ta sig an %@. Vi jämför dem."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ มีอยู่ 2 วิธีที่คนนิยม มาเทียบกันดู"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ konusunda iki yaygın yaklaşım var. Hadi karşılaştıralım."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có hai cách phổ biến để tiếp cận %@. Cùng so sánh nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@有两种常见的做法，我们来比一比。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@有兩種常見的做法，我們來比一比。"
          }
        }
      }
    },
    "There are unfinished changes. You can keep editing or export the original video." : {
