    "Controls the language Cue listens for while you speak." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد اللغة التي يستمع إليها Cue أثناء حديثك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt fest, auf welche Sprache Cue beim Sprechen hört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla el idioma que Cue escucha mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définit la langue que Cue écoute pendant que vous parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तय करता है कि बोलते समय Cue किस भाषा को सुनेगा।"
          }
        },
        "id" : {
