          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynd at skrive, hvad du vil sige… Tryk på [ ] for at tilføje instruktioner."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynn å skrive det du vil si… Trykk på [ ] for å legge til instruksjoner."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
