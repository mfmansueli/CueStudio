    "Share one prediction for the year ahead and the reason behind it." : {
      "comment" : "Find inspiration: the angle of a starter made from the creator's own topic (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك توقعًا واحدًا للعام القادم والسبب وراءه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Del én forudsigelse for det kommende år og grunden bag."
          }
        },
        "de" : {
          "stringUnit" : {
