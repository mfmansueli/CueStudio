        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今はフリースタイル — カメラからいつでも台本を追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 자유 녹화 — 카메라에서 언제든 대본을 추가하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
