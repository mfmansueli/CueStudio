      "comment" : "Find inspiration: the opening line of a starter made from the creator's own topic, said on camera (%@ is the topic, as they typed it)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لو استطعت الاحتفاظ بعادة واحدة فقط في %@، فستكون هذه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis jeg kun måtte beholde én vane med %@, ville det være den her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ich bei %@ nur eine Gewohnheit behalten dürfte, wäre es diese."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si solo pudiera quedarme con un hábito de %@, sería este."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si je ne devais garder qu’une habitude pour %@, ce serait celle-ci."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर %@ की सिर्फ़ एक आदत रख सकूँ, तो वह यही होगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalau aku cuma boleh mempertahankan satu kebiasaan %@, ini dia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se potessi tenere una sola abitudine per %@, sarebbe questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の習慣をひとつだけ残すなら、これです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 습관을 딱 하나만 남긴다면, 바로 이거예요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis jeg bare kunne beholde én vane med %@, ville det vært denne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als ik maar één gewoonte rond %@ mocht houden, was het deze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eu pudesse manter só um hábito de %@, seria este."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om jag bara fick behålla en vana kring %@ skulle det vara den här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าเก็บนิสัยเรื่อง%@ ไว้ได้แค่อย่างเดียว ก็คืออันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
