    "Softens the skin of faces. Eyes, lips, hair and beard stay sharp." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنعّم بشرة الوجوه. تبقى العيون والشفاه والشعر واللحية واضحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blødgør huden i ansigter. Øjne, læber, hår og skæg forbliver skarpe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glättet die Haut in Gesichtern. Augen, Lippen, Haare und Bart bleiben scharf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza la piel de los rostros. Los ojos, los labios, el pelo y la barba siguen nítidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adoucit la peau des visages. Les yeux, les lèvres, les cheveux et la barbe restent nets."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चेहरों की त्वचा को मुलायम बनाता है। आँखें, होंठ, बाल और दाढ़ी साफ़ रहते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghaluskan kulit wajah. Mata, bibir, rambut, dan jenggot tetap tajam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leviga la pelle dei volti. Occhi, labbra, capelli e barba restano nitidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顔の肌をなめらかにします。目、唇、髪、ひげはくっきりしたままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "얼굴 피부를 부드럽게 만듭니다. 눈, 입술, 머리카락, 수염은 선명하게 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør huden i ansikter jevnere. Øyne, lepper, hår og skjegg forblir skarpe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt de huid van gezichten zachter. Ogen, lippen, haar en baard blijven scherp."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suaviza a pele dos rostos. Olhos, lábios, cabelo e barba continuam nítidos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mjukar upp huden i ansikten. Ögon, läppar, hår och skägg förblir skarpa."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้ผิวบนใบหน้าเรียบเนียนขึ้น ดวงตา ริมฝีปาก ผม และหนวดเครายังคงคมชัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüzlerdeki cildi yumuşatır. Gözler, dudaklar, saç ve sakal net kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Làm mịn da trên khuôn mặt. Mắt, môi, tóc và râu vẫn sắc nét."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔化人脸上的皮肤。眼睛、嘴唇、头发和胡须保持清晰。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "柔化人臉上的皮膚。眼睛、嘴唇、頭髮和鬍鬚保持清晰。"
          }
        }
      }
    }
