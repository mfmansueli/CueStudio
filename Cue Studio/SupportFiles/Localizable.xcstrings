        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อาจถูกลบหรือเสียหาย เทคต้นฉบับไม่เปลี่ยน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
