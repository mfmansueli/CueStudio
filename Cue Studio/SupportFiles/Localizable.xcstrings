    "A split-screen area already has its shape · Show it as a window or full screen to use a mask" : {
      "comment" : "Toast: Mask can't go on a split screen's support",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منطقة الشاشة المقسّمة لها شكلها بالفعل · اعرضه في نافذة أو بملء الشاشة لاستخدام قناع"
          }
