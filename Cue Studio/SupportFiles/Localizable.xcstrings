    "Open the draft to write it yourself." : {
      "comment" : "Sponsored ad brief, after the reason when Apple Intelligence can't draft in the idea's language: the button reads Open the draft, to write the ad by hand.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح المسودة لتكتبه بنفسك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn udkastet, og skriv det selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Entwurf und schreib ihn selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el borrador y escríbelo tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez le brouillon pour l’écrire vous-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ड्राफ़्ट खोलकर खुद लिखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buka draf untuk menulisnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la bozza e scrivila tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下書きを開いて自分で書いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초안을 열어 직접 써 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
