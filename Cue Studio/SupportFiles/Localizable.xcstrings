    "Deletes your scripts, takes, edits and My Cue Voice from this iPhone. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف نصوصك ولقطاتك وتعديلاتك وMy Cue Voice من هذا الـ iPhone. لا يمكن التراجع عن ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter dine manuskripter, optagelser, redigeringer og My Cue Voice fra denne iPhone. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Skripte, Takes, Bearbeitungen und My Cue Voice von diesem iPhone. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina tus guiones, tomas, ediciones y My Cue Voice de este iPhone. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime vos scripts, prises, montages et My Cue Voice de cet iPhone. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone से आपकी स्क्रिप्ट, टेक, एडिट और My Cue Voice हट जाएँगे। इसे वापस नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus naskah, take, suntingan, dan My Cue Voice dari iPhone ini. Tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina da questo iPhone script, riprese, modifiche e My Cue Voice. Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneからスクリプト、テイク、編集内容、My Cue Voiceを削除します。元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서 스크립트, 테이크, 편집 내용, My Cue Voice를 삭제해요. 되돌릴 수 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletter manusene, opptakene, redigeringene og My Cue Voice fra denne iPhonen. Kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert je scripts, takes, bewerkingen en My Cue Voice van deze iPhone. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga seus roteiros, takes, edições e o My Cue Voice deste iPhone. Não dá para desfazer."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raderar dina manus, tagningar, redigeringar och My Cue Voice från den här iPhonen. Det går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบสคริปต์ เทค งานตัดต่อ และ My Cue Voice ของคุณออกจาก iPhone เครื่องนี้ ย้อนกลับไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone’daki metinlerini, çekimlerini, düzenlemelerini ve My Cue Voice’u siler. Geri alınamaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa kịch bản, take, bản chỉnh sửa và My Cue Voice khỏi iPhone này. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将从此 iPhone 删除你的脚本、拍摄、剪辑和 My Cue Voice。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將從此 iPhone 刪除你的腳本、拍攝、剪輯和 My Cue Voice。此操作無法復原。"
          }
        }
      }
    },
