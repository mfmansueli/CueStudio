    "Your first video is out in the world. %@ can live on your Home Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فيديوك الأول صار في العالم. يمكن لـ %@ أن يسكن شاشتك الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erstes Video ist draußen in der Welt. %@ kann auf deinem Home-Bildschirm leben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primer vídeo ya está en el mundo. %@ puede vivir en tu pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta première vidéo est partie dans le monde. %@ peut vivre sur ton écran d’accueil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पहला वीडियो दुनिया में पहुँच गया। %@ आपकी होम स्क्रीन पर रह सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video pertamamu sudah sampai ke dunia. %@ bisa tinggal di layar utamamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo primo video è nel mondo. %@ può vivere nella tua schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の動画が世界へ旅立ちました。%@ をホーム画面に置けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "첫 영상이 세상에 나갔어요. %@ 아이콘을 홈 화면에 둘 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu primeiro vídeo já está no mundo. %@ pode morar na sua Tela de Início."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วิดีโอแรกของคุณออกสู่โลกแล้ว %@ อยู่บนหน้าจอโฮมของคุณได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk videon dünyaya çıktı. %@ ana ekranında yaşayabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video đầu tiên của bạn đã ra thế giới. %@ có thể ở trên Màn hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的第一个视频已经走向世界。%@ 可以放在你的主屏幕上。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je eerste video is de wereld in. %@ kan op je beginscherm staan."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din första video är ute i världen. %@ kan finnas på din hemskärm."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din første video er ude i verden. %@ kan bo på din hjemmeskærm."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din første video er ute i verden. %@ kan bo på hjemmeskjermen din."
          }
        },
