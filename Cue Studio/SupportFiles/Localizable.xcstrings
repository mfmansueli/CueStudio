    "Come with me through a day of %@, from morning to night." : {
      "comment" : "Find inspiration: the opening line of a starter made from the creator's own topic, said on camera (%@ is the topic, as they typed it)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعال معي في يوم من %@، من الصباح حتى المساء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom med mig gennem en dag med %@, fra morgen til aften."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm mit durch einen Tag rund um %@, von morgens bis abends."
