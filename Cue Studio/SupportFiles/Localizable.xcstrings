        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configurazione creator è tornata ai valori di Cue"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリエイター設定をCueの初期設定に戻しました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크리에이터 설정을 Cue 기본값으로 되돌렸어요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A configuração de criador voltou ao padrão do Cue"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าครีเอเตอร์กลับเป็นค่าเริ่มต้นของ Cue แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçerik Üretici Ayarları Cue varsayılanlarına döndü"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết lập nhà sáng tạo đã về mặc định của Cue"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创作者设置已恢复为 Cue 默认设置"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creator-instelling staat weer op de standaardwaarden van Cue"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaparinställningen är tillbaka till Cues standardvärden"
          }
