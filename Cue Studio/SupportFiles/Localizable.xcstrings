    "Add a keyframe, move the playhead, then drag the photo or video — Cue moves it between keyframes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف إطارًا رئيسيًا، وحرّك رأس التشغيل، ثم اسحب الصورة أو الفيديو — يحرّكه Cue بين الإطارات الرئيسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en keyframe, flyt afspilningshovedet, og træk så fotoet eller videoen — Cue flytter det mellem keyframes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ein Keyframe hinzu, bewege den Abspielposition und zieh dann das Foto oder Video – Cue bewegt es zwischen den Keyframes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un fotograma clave, mueve el cursor y arrastra la foto o el video: Cue lo mueve entre fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une image clé, déplacez la tête de lecture, puis faites glisser la photo ou la vidéo — Cue la déplace entre les images clés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीफ़्रेम जोड़ें, प्लेहेड हिलाएँ, फिर फ़ोटो या वीडियो खींचें — Cue उसे कीफ़्रेम के बीच चलाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan keyframe, geser playhead, lalu seret foto atau video — Cue menggerakkannya di antara keyframe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un keyframe, sposta l’indicatore, poi trascina la foto o il video: Cue lo muove tra i keyframe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーフレームを追加して再生ヘッドを動かし、写真や動画をドラッグ — Cueがキーフレーム間を動かします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키프레임을 추가하고 재생 헤드를 옮긴 뒤 사진이나 영상을 드래그하세요 — Cue가 키프레임 사이를 움직입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en keyframe, flytt avspillingshodet og dra deretter bildet eller videoen — Cue flytter det mellom keyframes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een keyframe toe, verplaats de afspeelkop en sleep dan de foto of video — Cue beweegt hem tussen de keyframes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um quadro-chave, mova o cursor e arraste a foto ou o vídeo — o Cue faz o movimento entre os quadros-chave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en keyframe, flytta uppspelningsmarkören och dra sedan fotot eller videon — Cue flyttar det mellan keyframes."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มคีย์เฟรม เลื่อนหัวเล่น แล้วลากรูปหรือวิดีโอ — Cue จะเคลื่อนให้ระหว่างคีย์เฟรม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir anahtar kare ekle, oynatma çubuğunu taşı, sonra fotoğrafı veya videoyu sürükle — Cue onu anahtar kareler arasında hareket ettirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm khung hình chính, di chuyển đầu phát rồi kéo ảnh hoặc video — Cue sẽ di chuyển nó giữa các khung hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加关键帧，移动播放头，然后拖动照片或视频——Cue 会在关键帧之间移动它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新增一個關鍵影格，移動播放頭，再拖曳照片或影片 — Cue 會在關鍵影格之間移動它。"
          }
        }
      }
    },
