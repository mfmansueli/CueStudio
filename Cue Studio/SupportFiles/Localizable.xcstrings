          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogelijk is hij verwijderd of beschadigd. De originele opname is niet gewijzigd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
