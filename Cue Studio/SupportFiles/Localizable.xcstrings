    "Pick up where that video stopped: the next step or the question it left open." : {
      "comment" : "Find inspiration: the angle of a starter that follows up a video the creator shared (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل من حيث توقف ذلك الفيديو: الخطوة التالية أو السؤال الذي تركه مفتوحًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt, hvor den video slap: det næste skridt eller spørgsmålet, den lod stå åbent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach da weiter, wo das Video aufgehört hat: mit dem nächsten Schritt oder der offenen Frage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma donde se quedó ese video: el siguiente paso o la pregunta que dejó abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
