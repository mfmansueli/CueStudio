    "Before anything else — I'm sorry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أي شيء — أنا آسف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før alt andet — jeg er ked af det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vor allem anderen – es tut mir leid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de nada — lo siento."
          }
