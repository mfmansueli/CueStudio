    "Steal my system — it's simpler than you think." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خذ طريقتي — إنها أبسط مما تظن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjæl mit system — det er enklere, end du tror."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klau dir mein System – es ist einfacher, als du denkst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópiame el sistema — es más fácil de lo que crees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piquez-moi ma méthode — c’est plus simple que vous ne le pensez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा तरीका अपनाइए — यह आपकी सोच से आसान है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiru saja caraku — lebih mudah dari yang kamu kira."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rubami il sistema — è più semplice di quanto pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私のやり方をマネして — 思ったより簡単です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제 방법 그대로 가져가세요 — 생각보다 쉬워요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjel systemet mitt — det er enklere enn du tror."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steel mijn systeem — het is simpeler dan je denkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia meu sistema — é mais simples do que parece."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjäl mitt system — det är enklare än du tror."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอาระบบของฉันไปใช้เลย — ง่ายกว่าที่คิด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistemimi kap — sandığından daha basit."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lấy luôn hệ thống của mình — đơn giản hơn bạn nghĩ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接抄我的方法 — 比你想的简单。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "快學走我的方法 — 比你想的簡單。"
          }
        }
      }
    },
    "Step %@: %@." : {
      "localizations" : {
