          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vorher nach. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide confirmación. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande confirmation. Action irréversible."
          }
        },
