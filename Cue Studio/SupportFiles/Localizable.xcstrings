    "Play, pause and change speed from a second iPhone or iPad." : {
      "comment" : "Settings › Remote: subtitle under “No remote yet”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل وأوقف وغيّر السرعة من iPhone أو iPad ثانٍ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil, sæt på pause og skift hastighed fra en anden iPhone eller iPad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, pausiere und ändere das Tempo von einem zweiten iPhone oder iPad aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce, pausa y cambia la velocidad desde un segundo iPhone o iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez, mettez en pause et changez la vitesse depuis un second iPhone ou iPad."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे iPhone या iPad से चलाएँ, रोकें और स्पीड बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar, jeda, dan ubah kecepatan dari iPhone atau iPad kedua."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, metti in pausa e cambia velocità da un secondo iPhone o iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2台目のiPhoneやiPadから、再生、一時停止、速度の変更ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번째 iPhone이나 iPad에서 재생, 일시정지, 속도 변경을 할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av, pause og endre hastighet fra en annen iPhone eller iPad."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel af, pauzeer en wijzig de snelheid vanaf een tweede iPhone of iPad."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza, pause e mude a velocidade a partir de um segundo iPhone ou iPad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela upp, pausa och ändra hastighet från en andra iPhone eller iPad."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่น หยุด และเปลี่ยนความเร็วจาก iPhone หรือ iPad เครื่องที่สอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinci bir iPhone veya iPad’den oynat, duraklat ve hızı değiştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát, tạm dừng và đổi tốc độ từ một iPhone hoặc iPad thứ hai."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台 iPhone 或 iPad 上播放、暂停和调整速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從第二部 iPhone 或 iPad 播放、暫停和調整速度。"
          }
        }
      }
    },
    "Play, pause, change speed and move through the script from a second iPhone or iPad. Both need Cue, and Wi-Fi on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل وأوقف وغيّر السرعة وتنقّل في النص من iPhone أو iPad ثانٍ. يحتاج كلاهما إلى Cue مع تشغيل Wi-Fi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afspil, sæt på pause, skift hastighed og naviger i manuskriptet fra en anden iPhone eller iPad. Begge skal have Cue og Wi-Fi slået til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte, pausiere, ändere das Tempo und bewege dich durchs Skript: alles von einem zweiten iPhone oder iPad aus. Beide brauchen Cue und WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce, pausa, cambia la velocidad y muévete por el guion desde un segundo iPhone o iPad. Los dos necesitan Cue y el Wi-Fi activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez, mettez en pause, changez la vitesse et parcourez le script depuis un second iPhone ou iPad. Les deux ont besoin de Cue, et du Wi-Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे iPhone या iPad से स्क्रिप्ट चलाएँ, रोकें, स्पीड बदलें और आगे-पीछे करें। दोनों में Cue और Wi-Fi चालू होना चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Putar, jeda, ubah kecepatan, dan gulir naskah dari iPhone atau iPad kedua. Keduanya butuh Cue, dan Wi-Fi menyala."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia, metti in pausa, cambia velocità e scorri il copione da un secondo iPhone o iPad. Serve Cue su entrambi, con il Wi-Fi attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2台目のiPhoneやiPadから、再生、一時停止、速度の変更、台本の移動ができます。両方のデバイスにCueを入れ、Wi-Fiをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 번째 iPhone이나 iPad에서 재생, 일시정지, 속도 변경, 대본 이동을 할 수 있어요. 두 기기 모두 Cue가 필요하고 Wi-Fi를 켜야 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spill av, pause, endre hastighet og naviger i manuset fra en annen iPhone eller iPad. Begge trenger Cue og Wi-Fi på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speel af, pauzeer, wijzig de snelheid en navigeer door het script vanaf een tweede iPhone of iPad. Beide hebben Cue nodig, en wifi aan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduza, pause, mude a velocidade e navegue pelo roteiro a partir de um segundo iPhone ou iPad. Os dois precisam do Cue e do Wi-Fi ligado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spela upp, pausa, ändra hastighet och navigera i manuset från en andra iPhone eller iPad. Båda behöver Cue och Wi-Fi på."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่น หยุด เปลี่ยนความเร็ว และเลื่อนสคริปต์จาก iPhone หรือ iPad เครื่องที่สอง ทั้งสองเครื่องต้องมี Cue และเปิด Wi-Fi"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İkinci bir iPhone veya iPad’den oynat, duraklat, hızı değiştir ve senaryoda ilerle. İkisinde de Cue olmalı, Wi-Fi açık olmalı."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phát, tạm dừng, đổi tốc độ và di chuyển trong kịch bản từ một iPhone hoặc iPad thứ hai. Cả hai cần có Cue và bật Wi-Fi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台 iPhone 或 iPad 上播放、暂停、调整速度和翻动脚本。两台设备都需要安装 Cue，并打开无线局域网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從第二部 iPhone 或 iPad 播放、暫停、調整速度並在腳本中移動。兩部裝置都需要 Cue 並開啟 Wi-Fi。"
          }
        }
      }
    },
