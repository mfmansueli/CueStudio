    "A week, one small bag, and nothing you’ll miss." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسبوع كامل، حقيبة صغيرة واحدة، ولن ينقصك شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uge, én lille taske, og intet, du kommer til at savne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Woche, eine kleine Tasche, und nichts, was dir fehlen wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una semana, una bolsa pequeña y nada que te haga falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une semaine, un petit sac, et rien qui vous manquera."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक हफ़्ता, एक छोटा बैग, और कुछ भी छूटेगा नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seminggu, satu tas kecil, dan nggak ada yang bakal kamu rindukan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una settimana, una borsa piccola, e niente che ti mancherà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1週間、小さなバッグひとつ。それで何も困りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일주일, 작은 가방 하나, 아쉬운 건 하나도 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En uke, én liten bag, og ingenting du kommer til å savne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een week, één kleine tas en niets wat je zult missen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma semana, uma bolsa pequena e nada de que você vá sentir falta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En vecka, en liten väska och inget du kommer att sakna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หนึ่งสัปดาห์ กระเป๋าใบเล็กใบเดียว และไม่ขาดอะไรเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir hafta, küçük bir çanta ve özleyeceğin hiçbir şey yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một tuần, một chiếc túi nhỏ, và chẳng thiếu thứ gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一周时间，一个小包，什么都不会缺。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一週時間，一個小包，什麼都不會缺。"
          }
        }
      }
    },
