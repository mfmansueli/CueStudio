            "state" : "translated",
            "value" : "เยี่ยมเลย รูทีนตอนเช้าอีกแล้ว แต่อันนี้ได้ผลจริง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika, bir sabah rutini daha. Ama bu işe yarıyor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuyệt, lại thêm một thói quen buổi sáng. Nhưng cái này hiệu quả thật."
