    "Steal my system. It's simpler than you think." : {
      "comment" : "A ready-made opening line or tone of a script format, shown as an example the creator can pick and read to camera. No dashes in any language.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خذ طريقتي، إنها أبسط مما تظن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjæl mit system. Det er enklere, end du tror."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klau dir mein System. Es ist einfacher, als du denkst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cópiame el sistema: es más fácil de lo que crees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piquez-moi ma méthode : c’est plus simple que vous ne le pensez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा तरीका अपनाइए, यह आपकी सोच से आसान है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
