    "Aim for lengths that earn: TikTok 1:00+, YouTube 8:00+ for mid-roll ads" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استهدف مدداً تحقق أرباحاً: TikTok من 1:00، وYouTube من 8:00 لإعلانات منتصف الفيديو"
          }
        },
        "de" : {
          "stringUnit" : {
