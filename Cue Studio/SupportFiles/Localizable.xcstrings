        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本番のつもりで、メッセージを声に出して読んでみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 촬영처럼 메시지를 소리 내어 읽어 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les meldingen din høyt, som i et ekte opptak."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees je bericht hardop voor, als een echte opname."
          }
