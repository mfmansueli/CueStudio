    "Try recording it with the teleprompter. Your first star is one take away." : {
      "comment" : "Notification body",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب تسجيله مع الملقّن. نجمتك الأولى على بُعد لقطة واحدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv at optage det med teleprompteren. Din første stjerne er én optagelse væk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probier, es mit dem Teleprompter aufzunehmen. Dein erster Stern ist nur einen Take entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba a grabarlo con el teleprompter. Tu primera estrella está a una toma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez de le filmer avec le téléprompteur. Votre première étoile n’est qu’à une prise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे टेलीप्रॉम्प्टर के साथ रिकॉर्ड करके देखें। आपका पहला तारा बस एक टेक दूर है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba rekam dengan teleprompter. Bintang pertamamu tinggal satu take lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a registrarlo con il teleprompter. La tua prima stella è a una ripresa di distanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロンプターで録画してみましょう。最初の星まであとテイク1回です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프롬프터로 녹화해 보세요. 첫 번째 별까지 테이크 하나면 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å ta det opp med teleprompteren. Den første stjernen din er ett opptak unna."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neem het eens op met de teleprompter. Je eerste ster is één opname verwijderd."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente gravar com o teleprompter. Sua primeira estrela está a um take."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova att spela in det med telepromptern. Din första stjärna är bara en tagning bort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองอัดด้วยเทเลพรอมป์เตอร์ ดาวดวงแรกของคุณอยู่ห่างแค่เทคเดียว"
