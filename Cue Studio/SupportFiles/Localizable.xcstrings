    "Serious mode: no hooks, jokes, hype or “follow for more”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوضع الجاد: لا افتتاحيات ولا مزاح ولا مبالغة ولا \"تابعني للمزيد\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ernster Modus: keine Hooks, Witze, kein Hype und kein „Folg mir für mehr“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo serio: sin ganchos, chistes, bombo ni “sígueme para más”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode sérieux : pas d’accroche, de blague, d’emphase ni de « abonnez-vous »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गंभीर मोड: कोई हुक, मज़ाक, हाइप या “और के लिए फ़ॉलो करें” नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode serius: tanpa hook, lelucon, hype, atau “follow untuk konten lainnya”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modalità seria: niente ganci, battute, enfasi o “seguimi per altri video”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シリアスモード：フック、冗談、誇張、「フォローしてね」はなし。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "진지한 모드: 훅, 농담, 과장, ‘팔로우해 주세요’ 없음."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modo sério: sem ganchos, piadas, hype ou “me segue para mais”."
          }
        },
