    "My idea gets to sound like me and reach the people I made it for." : {
      "comment" : "Practice script read aloud in the first flight: the call to action (spoken, first person)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتبدو فكرتي بصوتي أنا، وتصل إلى من صنعتها لهم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min idé kommer til at lyde som mig og når ud til dem, jeg lavede den til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So klingt meine Idee nach mir und erreicht die Menschen, für die ich sie gemacht habe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi idea suena como yo y llega a las personas para las que la hice."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon idée me ressemble et touche les personnes pour qui je l’ai faite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा आइडिया मेरी तरह सुनाई देता है और उन लोगों तक पहुँचता है जिनके लिए यह बना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideku terdengar seperti aku dan sampai ke orang-orang yang kutuju."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mia idea mi somiglia e arriva alle persone per cui l’ho creata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私のアイデアが私らしく響いて、届けたい人に届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 아이디어가 나답게 들리고, 전하고 싶은 사람들에게 닿아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideen min får høres ut som meg og nå de jeg laget den for."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn idee klinkt zoals ik en bereikt de mensen voor wie ik het maakte."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha ideia soa do meu jeito e chega às pessoas para quem eu a fiz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min idé får låta som jag och nå de människor jag gjorde den för."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไอเดียของเราจะฟังดูเป็นตัวเรา และไปถึงคนที่เราตั้งใจทำให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikrim benim gibi duyulur ve onu kimler için yaptıysam onlara ulaşır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ý tưởng của tôi mang đúng giọng của tôi và đến được với những người tôi muốn gửi tới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的想法听起来就像我，也能传达给我想打动的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的想法聽起來就像我，也能傳達給我想打動的人。"
          }
        }
      }
    },
