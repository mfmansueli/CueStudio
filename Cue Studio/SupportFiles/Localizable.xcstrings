    "Studio uses these too. The screen stays on while the prompter is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدمها Studio أيضًا. تبقى الشاشة مضاءة أثناء فتح الملقّن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio bruger også disse. Skærmen forbliver tændt, mens teleprompteren er åben."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio nutzt diese ebenfalls. Der Bildschirm bleibt an, solange der Prompter offen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio también los usa. La pantalla sigue encendida mientras el teleprompter está abierto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio les utilise aussi. L’écran reste allumé tant que le prompteur est ouvert."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio भी इन्हें इस्तेमाल करता है। प्रॉम्प्टर खुला रहने तक स्क्रीन चालू रहती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio juga memakainya. Layar tetap menyala selama prompter terbuka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche Studio li usa. Lo schermo resta acceso finché il teleprompter è aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studioでも使われます。プロンプターを開いている間、画面は点灯したままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio에서도 사용해요. 프롬프터가 열려 있는 동안 화면이 켜져 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio bruker disse også. Skjermen forblir på mens teleprompteren er åpen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio gebruikt deze ook. Het scherm blijft aan zolang de prompter open is."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Studio também usa essas opções. A tela fica acesa enquanto o prompter estiver aberto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio använder dem också. Skärmen förblir på medan telepromptern är öppen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio ใช้ค่าเหล่านี้ด้วย หน้าจอจะติดอยู่ตลอดเวลาที่เปิดพรอมป์เตอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio da bunları kullanır. Prompter açıkken ekran açık kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio cũng dùng các mục này. Màn hình luôn sáng khi teleprompter đang mở."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio 也会使用这些设置。提词器打开期间屏幕保持常亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studio 也會使用這些設定。提詞機開啟期間螢幕保持常亮。"
          }
        }
      }
    },
    "Studio Voice" : {
