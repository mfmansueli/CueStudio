    "Tap a graphic on the cover to change it. Drag to move, pinch or use the corner to resize and turn." : {
      "comment" : "Cover Studio: graphics hint",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على رسم في الغلاف لتغييره. اسحب للتحريك، واضغط بإصبعين أو استخدم الزاوية لتغيير الحجم والتدوير."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på en grafik på coveret for at ændre den. Træk for at flytte, knib eller brug hjørnet for at ændre størrelse og dreje."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Grafik im Cover, um sie zu ändern. Zum Bewegen ziehen, zum Skalieren und Drehen zusammenziehen oder die Ecke nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un gráfico de la portada para cambiarlo. Arrastra para moverlo; pellizca o usa la esquina para cambiar el tamaño y girarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez un graphisme pour le modifier. Faites glisser pour déplacer, pincez ou utilisez le coin pour redimensionner et faire pivoter."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बदलने के लिए कवर पर किसी ग्राफ़िक को टैप करें। हिलाने के लिए खींचें, आकार बदलने और घुमाने के लिए पिंच करें या कोना इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk grafis di sampul untuk mengubahnya. Seret untuk memindahkan, cubit atau pakai sudut untuk mengubah ukuran dan memutar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un grafico sulla copertina per cambiarlo. Trascina per spostarlo, pizzica o usa l’angolo per ridimensionarlo e ruotarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カバー上のグラフィックをタップして変更。ドラッグで移動、ピンチか角でサイズ変更と回転。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "커버의 그래픽을 탭해 바꿔요. 드래그로 이동하고, 핀치하거나 모서리로 크기와 회전을 바꿔요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på en grafikk på omslaget for å endre den. Dra for å flytte, knip eller bruk hjørnet for å endre størrelse og rotere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een graphic op de cover om hem te wijzigen. Sleep om te verplaatsen, knijp of gebruik de hoek om het formaat en de draaiing te wijzigen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque num gráfico da capa para mudá-lo. Arraste para mover; faça pinça ou use o canto para redimensionar e girar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en grafik på omslaget för att ändra den. Dra för att flytta, nyp eller använd hörnet för att ändra storlek och vrida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะกราฟิกบนปกเพื่อแก้ไข ลากเพื่อย้าย จีบนิ้วหรือใช้มุมเพื่อปรับขนาดและหมุน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değiştirmek için kapaktaki bir grafiğe dokun. Taşımak için sürükle; boyutlandırmak ve döndürmek için sıkıştır ya da köşeyi kullan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm vào đồ họa trên ảnh bìa để thay đổi. Kéo để di chuyển, chụm hoặc dùng góc để đổi cỡ và xoay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点封面上的图形即可修改。拖移可移动，捏合或拖动角落可调整大小和旋转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下封面上的圖形即可修改。拖移可移動，捏合或拖動角落可調整大小和旋轉。"
          }
        }
      }
    },
