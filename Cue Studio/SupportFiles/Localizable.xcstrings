    "Your %lld free scripts are written. Cue Pro adds %lld a month." : {
      "comment" : "Ultra AI's calm Pro: the line under the title; the first number is the free scripts (3), the second Pro's monthly ones (30)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كُتبت نصوصك المجانية الـ %1$lld. يضيف Cue Pro %2$lld نصًا شهريًا."
          }
        },
        "da" : {
