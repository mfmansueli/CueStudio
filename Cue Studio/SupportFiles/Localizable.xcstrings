        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine der häufigsten Fragen im Gym. Klären wir das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una de las preguntas más comunes del gimnasio. Vamos a resolverla."
          }
