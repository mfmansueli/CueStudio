    "Freestyle now — add a script anytime from the camera." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل حر الآن — أضف نصًا في أي وقت من الكاميرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst mal Freestyle – füg jederzeit über die Kamera ein Skript hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libre por ahora — añade un guion cuando quieras desde la cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
