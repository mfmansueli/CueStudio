    "Some basics are worth spending more on, and some really aren’t." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض الأساسيات تستحق أن تنفق عليها أكثر، وبعضها لا يستحق أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle basisvarer er værd at bruge flere penge på, og nogle er det slet ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für manche Basics lohnt sich mehr Geld, für andere wirklich nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En algunos básicos vale la pena gastar más, y en otros para nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains basiques valent de mettre le prix, d’autres vraiment pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ बेसिक्स पर ज़्यादा ख़र्च करना ठीक है, और कुछ पर बिल्कुल नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beberapa pakaian dasar layak dibeli lebih mahal, dan beberapa sama sekali tidak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su alcuni capi base vale la pena spendere di più, su altri proprio no."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
