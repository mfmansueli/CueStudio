          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep een punt omhoog om te versnellen, omlaag om te vertragen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste um ponto para cima para acelerar e para baixo para desacelerar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra en punkt uppåt för snabbare, nedåt för långsammare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากจุดขึ้นเพื่อเร่ง ลงเพื่อชะลอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hızlandırmak için noktayı yukarı, yavaşlatmak için aşağı sürükle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
