          }
        }
      }
    },
    "It goes into the composer. Make it yours first." : {
      "comment" : "Find inspiration: what 'Start with it' does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذهب إلى حقل الكتابة. اجعلها لك أولًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kommer i skrivefeltet. Gør den til din først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie kommt ins Eingabefeld. Mach sie erst zu deiner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
