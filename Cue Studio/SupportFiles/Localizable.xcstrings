          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Tingkatkan suara atau Kurangi derau untuk membandingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Migliora la voce o Riduci il rumore per confrontare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較するには「声を補正」か「ノイズを軽減」をオンにしてください。"
