        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per vederti mentre leggi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読みながら自分の姿を確認できます"
