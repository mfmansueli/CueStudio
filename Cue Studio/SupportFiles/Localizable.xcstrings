    "You can change this anytime in Settings. Cue never records until you tap Record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير هذا في أي وقت من الإعدادات. لا يسجّل Cue أبدًا قبل أن تضغط تسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kannst du jederzeit in den Einstellungen ändern. Cue nimmt nie auf, bevor du auf Aufnehmen tippst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo cuando quieras en Ajustes. Cue nunca graba hasta que tocas Grabar."
