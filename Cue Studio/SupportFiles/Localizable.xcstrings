    "This is during your quiet hours. Cue will remind you anyway, since you chose this time." : {
      "comment" : "Note under a reminder time inside quiet hours",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الوقت ضمن ساعات الهدوء. سيذكّرك Cue على أي حال لأنك اخترته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er i dine stille timer. Cue minder dig om det alligevel, fordi du har valgt tidspunktet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das liegt in deiner Ruhezeit. Cue erinnert dich trotzdem, weil du diese Uhrzeit gewählt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está dentro de tus horas de silencio. Cue te lo recordará igualmente, porque elegiste esta hora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est pendant vos heures calmes. Cue vous le rappellera quand même, puisque vous avez choisi cette heure."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह आपके शांत समय में है। Cue फिर भी याद दिलाएगा, क्योंकि यह समय आपने चुना है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini di jam tenangmu. Cue tetap akan mengingatkan, karena kamu memilih waktu ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È durante le tue ore di silenzio. Cue te lo ricorderà comunque, perché hai scelto tu quest’ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かな時間に入っています。この時間を選んだので、Cueはそれでもお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 시간에 해당해요. 직접 고른 시간이라 Cue가 그대로 알려 드려요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette er i de stille timene dine. Cue minner deg på det likevel, siden du valgte tidspunktet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit valt in je stille uren. Cue herinnert je er toch aan, omdat je deze tijd hebt gekozen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso fica dentro do seu horário de silêncio. O Cue vai lembrar mesmo assim, porque você escolheu esse horário."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är under dina tysta timmar. Cue påminner dig ändå, eftersom du valde tiden."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เวลานี้อยู่ในช่วงเงียบของคุณ Cue จะยังเตือนเพราะคุณเลือกเวลานี้เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, sessiz saatlerinin içinde. Bu saati sen seçtiğin için Cue yine de hatırlatacak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời điểm này nằm trong giờ yên lặng của bạn. Cue vẫn sẽ nhắc vì bạn đã chọn giờ này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是你的安静时段。由于是你选择的时间，Cue 仍会提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這是你的安靜時段。由於是你選擇的時間，Cue 仍會提醒你。"
          }
        }
      }
