    "They decide the words Cue uses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هم من يحدد الكلمات التي يستخدمها Cue."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestemmer de ord, Cue bruger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie bestimmen, welche Wörter Cue nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ellos deciden las palabras que usa Cue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils déterminent les mots que Cue utilise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही तय करते हैं कि Cue कौन से शब्द इस्तेमाल करे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merekalah yang menentukan kata yang dipakai Cue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decidono le parole che usa Cue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その人たちに合わせて、Cueが使う言葉が決まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그들에 맞춰 Cue가 쓰는 말이 정해져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De bestemmer ordene Cue bruker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zij bepalen de woorden die Cue gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles definem as palavras que o Cue usa."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De avgör vilka ord Cue använder."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พวกเขาเป็นตัวกำหนดคำที่ Cue ใช้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue’nun kullanacağı kelimeleri onlar belirler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ quyết định từ ngữ mà Cue dùng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们决定 Cue 使用的措辞。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們決定 Cue 使用的字詞。"
          }
        }
      }
    },
    "They said it was the most real pitch all week" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالوا إنه كان أصدق عرض طوال الأسبوع"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sagde, at det var ugens mest ægte pitch"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sagten, es war der ehrlichste Pitch der Woche"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeron que fue la propuesta más auténtica de la semana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ont dit que c’était le pitch le plus sincère de la semaine"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उन्होंने कहा यह पूरे हफ़्ते की सबसे सच्ची पिच थी"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereka bilang ini pitch paling jujur minggu ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanno detto che era il pitch più autentico della settimana"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今週いちばんリアルな提案だと言われました"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 주 가장 진솔한 제안이었다고 했어요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sa at det var ukens mest ekte pitch"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze zeiden dat het de meest echte pitch van de week was"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disseram que foi o pitch mais verdadeiro da semana"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sa att det var veckans mest äkta pitch"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เขาบอกว่าเป็นการพรีเซนต์ที่จริงใจที่สุดของสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haftanın en samimi sunumu olduğunu söylediler"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Họ nói đó là màn chào hàng chân thật nhất tuần"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们说这是本周最真诚的提案"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他們說這是整週最真誠的提案"
          }
        }
      }
    },
