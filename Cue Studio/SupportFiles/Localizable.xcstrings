    "Captions can’t listen in %@ on this iPhone. Pick the language spoken or write the lines yourself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستطيع الترجمة النصية الاستماع بـ%@ على هذا الـ iPhone. اختر اللغة المنطوقة أو اكتب السطور بنفسك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untertitel können auf diesem iPhone nicht auf %@ zuhören. Wähle die gesprochene Sprache oder schreib die Zeilen selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos no pueden escuchar en %@ en este iPhone. Elige el idioma hablado o escribe las líneas tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sous-titres ne peuvent pas écouter en %@ sur cet iPhone. Choisissez la langue parlée ou écrivez les lignes vous-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर कैप्शन %@ नहीं सुन सकते। बोली गई भाषा चुनें या लाइनें ख़ुद लिखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks tidak bisa mendengarkan %@ di iPhone ini. Pilih bahasa yang diucapkan atau tulis barisnya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I sottotitoli non possono ascoltare in %@ su questo iPhone. Scegli la lingua parlata o scrivi tu le righe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでは字幕が%@を聞き取れません。話している言語を選ぶか、行を自分で入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서는 자막이 %@을(를) 들을 수 없습니다. 말한 언어를 고르거나 줄을 직접 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As legendas não conseguem ouvir em %@ neste iPhone. Escolha o idioma falado ou escreva as linhas você mesmo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายฟัง%@บน iPhone เครื่องนี้ไม่ได้ เลือกภาษาที่พูด หรือเขียนบรรทัดเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazılar bu iPhone’da %@ dinleyemiyor. Konuşulan dili seç ya da satırları kendin yaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề không nghe được tiếng %@ trên iPhone này. Hãy chọn ngôn ngữ được nói hoặc tự viết các dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 上的字幕无法识别%@。请选择所说的语言，或自己写字幕行。"
          }
        }
      }
    },
