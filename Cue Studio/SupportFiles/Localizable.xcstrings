    "A smaller wardrobe can make getting dressed so much easier." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خزانة أصغر قد تجعل ارتداء الملابس أسهل بكثير."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre garderobe kan gøre det meget nemmere at klæde sig på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kleinerer Kleiderschrank kann das Anziehen so viel leichter machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un armario más pequeño puede hacer que vestirte sea mucho más fácil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec moins de vêtements, s’habiller devient tellement plus simple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा वॉर्डरोब तैयार होने को कहीं ज़्यादा आसान बना सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lemari yang lebih kecil bisa bikin berpakaian jauh lebih mudah."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un guardaroba più piccolo può rendere vestirsi molto più facile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服を減らすと、着替えがずっと楽になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "옷장이 작아지면 옷 입기가 훨씬 쉬워질 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre garderobe kan gjøre det mye enklere å kle på seg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een kleinere garderobe kan aankleden zoveel makkelijker maken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um guarda-roupa menor pode deixar a hora de se vestir bem mais fácil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En mindre garderob kan göra det mycket enklare att klä sig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตู้เสื้อผ้าที่เล็กลงทำให้การแต่งตัวง่ายขึ้นมาก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daha küçük bir gardırop giyinmeyi çok daha kolaylaştırabilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tủ đồ gọn hơn có thể giúp việc mặc đồ dễ dàng hơn nhiều."
