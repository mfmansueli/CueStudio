    "Keyboards, foot pedals and presentation remotes are coming next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوحات المفاتيح ودواسات القدم وأجهزة التحكم بالعروض قادمة قريبًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturen, Fußpedale und Präsentations-Fernbedienungen kommen als Nächstes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclados, pedales y mandos de presentación llegarán después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claviers, pédales et télécommandes de présentation arrivent ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड, फ़ुट पेडल और प्रेज़ेंटेशन रिमोट जल्द आ रहे हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyboard, pedal kaki, dan remote presentasi akan segera hadir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastiere, pedali e telecomandi per presentazioni arriveranno presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード、フットペダル、プレゼン用リモコンにも今後対応予定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키보드, 풋 페달, 프레젠테이션 리모컨도 곧 지원할 예정이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teclados, pedais e controles de apresentação vêm em seguida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์บอร์ด แป้นเหยียบ และรีโมตพรีเซนต์จะมาในอนาคต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klavyeler, ayak pedalları ve sunum kumandaları sırada."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bàn phím, bàn đạp chân và điều khiển trình chiếu sẽ có sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "键盘、脚踏板和演示遥控器即将支持。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toetsenborden, voetpedalen en presentatieafstandsbedieningen volgen binnenkort."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangentbord, fotpedaler och presentationsfjärrar kommer härnäst."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturer, fodpedaler og præsentationsfjernbetjeninger kommer næste gang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturer, fotpedaler og presentasjonsfjernkontroller kommer neste gang."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵盤、腳踏板與簡報遙控器即將支援。"
          }
        }
      }
