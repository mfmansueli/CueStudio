    "Or drag the ⌟ handle on the recorder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو اسحب المقبض ⌟ على شاشة التسجيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller træk i ⌟-håndtaget i optageren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder zieh den ⌟-Griff im Recorder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arrastra el control ⌟ en el grabador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou faites glisser la poignée ⌟ dans l’enregistreur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या रिकॉर्डर पर ⌟ हैंडल को खींचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau seret gagang ⌟ di perekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure trascina la maniglia ⌟ nel registratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または録画画面で ⌟ ハンドルをドラッグします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "또는 녹화 화면에서 ⌟ 핸들을 드래그하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller dra i ⌟-håndtaket i opptakeren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of sleep de ⌟-greep in de recorder."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou arraste a alça ⌟ no gravador."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller dra i ⌟-handtaget i inspelaren."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือลากที่จับ ⌟ บนหน้าจออัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veya kaydedicide ⌟ tutamacını sürükle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoặc kéo tay nắm ⌟ trên màn hình quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "或在录制界面拖动 ⌟ 手柄。"
