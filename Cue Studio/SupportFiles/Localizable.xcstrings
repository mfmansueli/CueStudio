    "Can we talk about this for a second?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يمكننا التحدث عن هذا لحظة؟"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Können wir kurz darüber reden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Podemos hablar de esto un segundo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On peut en parler une seconde ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या हम एक सेकंड इस पर बात कर सकते हैं?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boleh kita bahas ini sebentar?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Possiamo parlarne un attimo?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっとこの話をしてもいいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠깐 이 얘기 좀 할까요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podemos falar sobre isso um segundo?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขอคุยเรื่องนี้สักครู่ได้ไหม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu bir saniye konuşabilir miyiz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình nói chuyện này một chút được không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们能聊一下这个吗？"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunnen we hier even over praten?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan vi prata om det här en stund?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan vi tale lidt om det her?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan vi snakke litt om dette?"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們可以聊一下這件事嗎？"
          }
        }
      }
    },
