    "Scan the code with the Camera app, or enter the letters under it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امسح الرمز بتطبيق الكاميرا، أو أدخل الحروف التي تحته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scan koden med Kamera-appen, eller indtast bogstaverne under den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne den Code mit der Kamera-App oder gib die Buchstaben darunter ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea el código con la app Cámara o escribe las letras de debajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez le code avec l’app Appareil photo, ou saisissez les lettres dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोड को कैमरा ऐप से स्कैन करें, या उसके नीचे के अक्षर दर्ज करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pindai kode dengan app Kamera, atau masukkan huruf di bawahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
