    "Lens, mic, quality and format can still change for one take while recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن تغيير العدسة والميكروفون والجودة والصيغة لتسجيلة واحدة أثناء التسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objektiv, Mikro, Qualität und Format lassen sich beim Aufnehmen noch für einen Take ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lente, el micro, la calidad y el formato aún pueden cambiar en una toma mientras grabas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’objectif, le micro, la qualité et le format peuvent encore changer pour une prise pendant l’enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग के दौरान एक टेक के लिए लेंस, माइक, क्वालिटी और फ़ॉर्मैट बदले जा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lensa, mikrofon, kualitas, dan format masih bisa diubah untuk satu take saat merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obiettivo, mic, qualità e formato possono ancora cambiare per una ripresa mentre registri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画中は、1テイクだけレンズ・マイク・画質・フォーマットを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 중에도 한 테이크에 한해 렌즈, 마이크, 화질, 형식을 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lente, mic, qualidade e formato ainda podem mudar em um take durante a gravação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังเปลี่ยนเลนส์ ไมค์ คุณภาพ และฟอร์แมตสำหรับเทคเดียวได้ระหว่างอัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt sırasında tek bir çekim için lens, mikrofon, kalite ve biçim yine değiştirilebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vẫn có thể đổi ống kính, mic, chất lượng và định dạng cho một take khi đang quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制时仍可为单次拍摄更改镜头、麦克风、画质和格式。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lens, microfoon, kwaliteit en formaat kunnen tijdens het opnemen nog voor één opname veranderen."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lins, mikrofon, kvalitet och format kan fortfarande ändras för en tagning under inspelning."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linse, mikrofon, kvalitet og format kan stadig ændres for én optagelse under optagelsen."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linse, mikrofon, kvalitet og format kan fortsatt endres for ett opptak under opptaket."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄影時，鏡頭、麥克風、畫質與畫幅仍可針對單一鏡頭變更。"
          }
        }
      }
    },
