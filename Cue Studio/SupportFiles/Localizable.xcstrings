    "New captions from your voice replace the lines you corrected or wrote." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحلّ الترجمة النصية الجديدة من صوتك محل السطور التي صحّحتها أو كتبتها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye undertekster fra din stemme erstatter de linjer, du har rettet eller skrevet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Untertitel aus deiner Stimme ersetzen die Zeilen, die du korrigiert oder geschrieben hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos subtítulos de tu voz reemplazan las líneas que corregiste o escribiste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux sous-titres issus de votre voix remplacent les lignes que vous avez corrigées ou écrites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी आवाज़ से नए कैप्शन उन लाइनों की जगह लेंगे जिन्हें आपने सुधारा या लिखा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks baru dari suaramu akan menggantikan baris yang kamu koreksi atau tulis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi sottotitoli dalla tua voce sostituiscono le righe che hai corretto o scritto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "声から作る新しい字幕は、修正または入力した行を置き換えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목소리로 만든 새 자막이 수정하거나 입력한 줄을 대체합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nye undertekster fra stemmen din erstatter linjene du har rettet eller skrevet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwe ondertitels van je stem vervangen de regels die je hebt gecorrigeerd of geschreven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As novas legendas da sua voz substituem as linhas que você corrigiu ou escreveu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nya undertexter från din röst ersätter raderna du har rättat eller skrivit."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำบรรยายใหม่จากเสียงจะแทนที่บรรทัดที่คุณแก้หรือเขียนไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesinden yeni altyazılar, düzelttiğin veya yazdığın satırların yerini alır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phụ đề mới từ giọng nói sẽ thay các dòng bạn đã sửa hoặc viết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据声音生成的新字幕将替换你修改或写下的行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你的聲音產生的新字幕，會取代你修正或自行撰寫的字幕行。"
          }
        }
      }
    },
