    "For text, plates and screens, Solid hides completely." : {
      "comment" : "Blur area note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للنصوص واللوحات والشاشات، يخفي «معتم» كل شيء."
          }
        },
        "da" : {
          "stringUnit" : {
