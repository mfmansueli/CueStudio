    "Pick again. It replaces the paste you just made." : {
      "comment" : "Paste look sheet's subtitle when opened by the toast's Change: what it pastes now takes the place of the paste just made",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر من جديد. سيحلّ محل اللصق الذي قمت به للتو."
