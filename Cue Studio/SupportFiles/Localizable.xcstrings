    "Your AI identity. Cue writes and rewrites every script to sound like you — on every platform." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هويتك في الذكاء الاصطناعي. يكتب Cue كل نص ويعيد صياغته ليشبهك — على كل منصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine KI-Identität. Cue schreibt jedes Skript so, dass es nach dir klingt – auf jeder Plattform."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu identidad en la IA. Cue escribe y reescribe cada guion para que suene como tú — en cada plataforma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre identité IA. Cue écrit et réécrit chaque script pour qu’il vous ressemble — sur chaque plateforme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI में आपकी पहचान। Cue हर प्लेटफ़ॉर्म पर हर स्क्रिप्ट को आपके जैसा लिखता और दोबारा लिखता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Identitas AI-mu. Cue menulis dan menulis ulang setiap naskah agar terdengar seperti kamu — di setiap platform."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua identità IA. Cue scrive e riscrive ogni copione perché sembri tuo — su ogni piattaforma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIのための、あなたらしさ。Cueはどのプラットフォームでも、あなたらしい台本を書き、書き直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 속 나의 정체성. Cue는 모든 플랫폼에서 모든 대본을 나답게 쓰고 다시 써요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua identidade na IA. O Cue escreve e reescreve cada roteiro com a sua cara — em todas as plataformas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัวตน AI ของคุณ Cue เขียนและเขียนใหม่ทุกสคริปต์ให้ฟังเหมือนคุณ — ในทุกแพลตฟอร์ม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ kimliğin. Cue her senaryoyu senin gibi konuşacak şekilde yazar ve yeniden yazar — her platformda."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản sắc AI của bạn. Cue viết và viết lại mọi kịch bản để nghe giống bạn — trên mọi nền tảng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 AI 中的个人风格。Cue 会让每个脚本在每个平台上都像你说的话。"
          }
        }
      }
    },
    "Your first line matters more than your camera." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جملتك الأولى أهم من الكاميرا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein erster Satz zählt mehr als deine Kamera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primera frase importa más que tu cámara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre première phrase compte plus que votre caméra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पहली लाइन आपके कैमरे से ज़्यादा मायने रखती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kalimat pertamamu lebih penting daripada kameramu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua prima frase conta più della tua fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラより大事なのは最初のひとこと。"
          }
        },
        "ko" : {
