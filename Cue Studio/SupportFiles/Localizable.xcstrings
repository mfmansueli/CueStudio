    "That’s all %lld friends. Thank you for sharing Cue." : {
      "comment" : "Invites: all 5 friends counted, no more rewards.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتمل عدد أصدقائك: %lld. شكرًا لأنك شاركت Cue."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det var alle %lld venner. Tak, fordi du deler Cue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das waren alle %lld Freunde. Danke, dass du Cue teilst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya son los %lld amigos. Gracias por compartir Cue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez atteint les %lld amis. Merci de partager Cue."
