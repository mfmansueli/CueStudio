          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين للبدء، ثم اضغط مرتين مرة أخرى للإنهاء"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobbelttryk for at starte, dobbelttryk igen for at slutte"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen zum Starten, noch einmal doppeltippen zum Beenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para empezar y otra vez para terminar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour démarrer, puis encore deux fois pour terminer"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुरू करने के लिए दो बार टैप करें, खत्म करने के लिए फिर दो बार टैप करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
