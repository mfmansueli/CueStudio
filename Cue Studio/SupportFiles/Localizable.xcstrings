      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للتحريك، واضغط بإصبعين لتغيير الحجم، أو استخدم الإجراءات. اضغط حيث يتداخل عنصر آخر لاختياره."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at flytte, knib for at ændre størrelse, eller brug handlingerne. Tryk hvor et andet overlapper for at vælge det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen zum Bewegen, Zusammenziehen zum Skalieren oder die Aktionen nutzen. Tippe, wo ein anderes überlappt, um es zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para mover, pellizca para cambiar el tamaño o usa las acciones. Toca donde se superpone otro para elegirlo."
