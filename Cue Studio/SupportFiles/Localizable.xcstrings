    "Closing all your apps to save battery? Let’s talk about that." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغلق كل تطبيقاتك لتوفير البطارية؟ لنتحدث عن ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukker du alle dine apps for at spare batteri? Lad os tale om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du schließt alle Apps, um Akku zu sparen? Reden wir mal darüber."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cierras todas las apps para ahorrar batería? Hablemos de eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous fermez toutes vos apps pour économiser la batterie ? Parlons-en."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैटरी बचाने के लिए सारे ऐप्स बंद करते हैं? इस पर बात करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suka menutup semua aplikasi biar baterai awet? Yuk bahas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi tutte le app per risparmiare batteria? Parliamone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー節約のためにアプリを全部閉じていますか？その話をしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리 아끼려고 앱을 전부 닫나요? 그 얘기 좀 해 볼게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lukker du alle appene for å spare batteri? La oss snakke om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit je al je apps om batterij te sparen? Laten we het daar even over hebben."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fecha todos os apps para economizar bateria? Vamos falar sobre isso."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stänger du alla appar för att spara batteri? Vi pratar om det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปิดแอปทั้งหมดเพื่อประหยัดแบตเหรอ มาคุยเรื่องนี้กัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarj tasarrufu için tüm uygulamaları mı kapatıyorsun? Hadi bunu konuşalım."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt hết ứng dụng để tiết kiệm pin? Cùng nói về chuyện đó nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了省电把所有 App 都关掉？我们来聊聊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為了省電把所有 App 都關掉？我們來聊聊。"
          }
        }
      }
    },
