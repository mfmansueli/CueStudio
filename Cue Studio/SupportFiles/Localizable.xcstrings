    "Make it shorter, or record as is — you can trim later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختصره، أو سجّل كما هو — يمكنك القص لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør det kortere, eller optag som det er — du kan trimme senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kürze es oder nimm es so auf – du kannst später schneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazlo más corto o grábalo así — puedes recortar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcissez-le ou enregistrez tel quel — vous pourrez couper ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे छोटा करें या ऐसे ही रिकॉर्ड करें — बाद में ट्रिम कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Persingkat, atau rekam apa adanya — bisa dipangkas nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accorcialo o registra così — potrai tagliare dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短くするか、このまま撮影できます。あとでトリムも可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 짧게 만들거나 그대로 녹화하세요. 나중에 다듬을 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør det kortere, eller ta opp som det er — du kan klippe senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak het korter of neem het zo op — je kunt later bijsnijden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe mais curto ou grave assim — dá para cortar depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör det kortare eller spela in som det är — du kan trimma senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้สั้นลง หรืออัดไปเลย — ตัดต่อทีหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kısalt ya da olduğu gibi kaydet — sonra kırpabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rút ngắn, hoặc quay luôn — bạn có thể cắt sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改短一点，或直接录制，之后还能剪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改短一點，或直接錄製，之後還能剪。"
          }
        }
      }
    },
    "Make scripts sound like you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل النصوص تبدو مثلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få manuskripter til at lyde som dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass Skripte nach dir klingen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que los guiones suenen como tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites sonner vos scripts comme vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रिप्ट को अपनी आवाज़ जैसा बनाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buat naskah terdengar seperti kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai suonare i copioni come te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台本をあなたらしく。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본을 나답게 만드세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få manus til å høres ut som deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat scripts als jou klinken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça os roteiros soarem como você."
          }
        },
