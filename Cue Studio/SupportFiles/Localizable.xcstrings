    "Great. Another thing nobody asked for." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رائع. شيء آخر لم يطلبه أحد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fedt. Endnu noget ingen bad om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super. Noch etwas, das keiner wollte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genial. Otra cosa que nadie pidió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Super. Encore un truc que personne n’a demandé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वाह। एक और चीज़ जो किसी ने नहीं माँगी।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hebat. Satu lagi yang tak diminta siapa pun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fantastico. Un’altra cosa che nessuno aveva chiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すごい。誰も頼んでいないものがまた一つ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좋네요. 아무도 원하지 않은 게 또 하나."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flott. Enda noe ingen har bedt om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geweldig. Weer iets waar niemand om vroeg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ótimo. Mais uma coisa que ninguém pediu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toppen. Ännu en sak ingen bett om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เยี่ยม อีกเรื่องที่ไม่มีใครขอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika. Kimsenin istemediği bir şey daha."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuyệt. Lại một thứ không ai đòi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太棒了，又一个没人要的东西。"
