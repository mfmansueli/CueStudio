    "Small changes make a big difference. Let’s fix a few common ones." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التغييرات الصغيرة تصنع فرقًا كبيرًا. لنصلح بعض الأخطاء الشائعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små ændringer gør en stor forskel. Lad os rette et par almindelige fejl."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Änderungen machen einen großen Unterschied. Beheben wir ein paar typische."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequeños cambios marcan una gran diferencia. Arreglemos algunos comunes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De petits changements font une grande différence. Corrigeons les plus courants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटे बदलाव बड़ा फ़र्क़ लाते हैं। चलिए कुछ आम गलतियाँ सुधारें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perubahan kecil berdampak besar. Yuk perbaiki beberapa yang umum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piccoli cambiamenti fanno una grande differenza. Correggiamo i più comuni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さな変化が大きな違いを生みます。よくあるものを直していきましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작은 변화가 큰 차이를 만들어요. 흔한 실수 몇 가지를 고쳐 볼게요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små endringer gjør stor forskjell. La oss fikse noen vanlige feil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine veranderingen maken een groot verschil. Laten we een paar veelvoorkomende aanpakken."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequenas mudanças fazem grande diferença. Vamos corrigir alguns erros comuns."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Små ändringar gör stor skillnad. Vi fixar några vanliga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนเล็ก ๆ สร้างความต่างได้มาก มาแก้จุดที่พบบ่อยกัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük değişiklikler büyük fark yaratır. Hadi birkaç yaygın hatayı düzeltelim."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thay đổi nhỏ tạo khác biệt lớn. Cùng sửa vài lỗi phổ biến nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小改变带来大不同。我们来改几个常见的。"
          }
        },
        "zh-Hant" : {
