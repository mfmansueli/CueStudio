    "Shows proportions on your screen — not the final look." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض النِّسَب على شاشتك — وليس الشكل النهائي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Proportionen auf deinem Bildschirm — nicht das endgültige Aussehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las proporciones en tu pantalla, no el aspecto final."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre les proportions sur votre écran — pas le rendu final."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी स्क्रीन पर अनुपात दिखाता है — अंतिम रूप नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan proporsi di layarmu — bukan tampilan akhir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra le proporzioni sul tuo schermo, non l’aspetto finale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面上の比率を示すもので、最終的な見た目ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 비율을 보여줄 뿐, 최종 모습은 아니에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as proporções na sua tela — não o visual final."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงสัดส่วนบนหน้าจอของคุณ — ไม่ใช่หน้าตาจริง"
          }
        },
        "tr" : {
