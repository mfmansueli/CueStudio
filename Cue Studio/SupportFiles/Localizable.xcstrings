        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Worte erscheinen hier, damit du sie vor dem Senden prüfen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus palabras aparecen aquí para que las revises antes de enviarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos mots apparaissent ici pour que vous les relisiez avant d’envoyer."
