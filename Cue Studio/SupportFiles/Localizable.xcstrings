          "stringUnit" : {
            "state" : "translated",
            "value" : "Få manus att låta som du."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทำให้สคริปต์ฟังดูเหมือนคุณ"
