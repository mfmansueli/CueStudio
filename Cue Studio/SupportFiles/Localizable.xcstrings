    "This iPhone can’t find people in video, so the background can’t change here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ iPhone تحديد الأشخاص في الفيديو، لذا لا يمكن تغيير الخلفية هنا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhone kan ikke finde personer i video, så baggrunden kan ikke ændres her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann keine Personen im Video erkennen, daher lässt sich der Hintergrund hier nicht ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede encontrar personas en vídeo, así que aquí no se puede cambiar el fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas repérer les personnes dans la vidéo : l’arrière-plan ne peut pas changer ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone वीडियो में लोगों को नहीं ढूँढ सकता, इसलिए यहाँ बैकग्राउंड नहीं बदल सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa menemukan orang di video, jadi latar belakang tidak bisa diubah di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non riesce a trovare persone nel video, quindi qui lo sfondo non può cambiare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneはビデオ内の人物を認識できないため、ここでは背景を変更できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone은 비디오에서 사람을 찾을 수 없어 여기서는 배경을 바꿀 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhonen kan ikke finne personer i video, så bakgrunnen kan ikke endres her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze iPhone kan geen mensen in video vinden, dus de achtergrond kan hier niet veranderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone não consegue encontrar pessoas no vídeo, então o fundo não pode mudar aqui."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här iPhonen kan inte hitta personer i video, så bakgrunden kan inte ändras här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone เครื่องนี้หาคนในวิดีโอไม่ได้ จึงเปลี่ยนพื้นหลังที่นี่ไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone videoda kişileri bulamıyor, bu yüzden arka plan burada değişemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone này không nhận ra người trong video nên không đổi được nền ở đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 iPhone 无法识别视频中的人物，因此这里无法更改背景。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這部 iPhone 無法辨識影片中的人物，因此無法在此更換背景。"
          }
        }
      }
    },
    "This iPhone can’t translate %@ to %@. You can write the translation yourself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ iPhone الترجمة من %1$@ إلى %2$@. يمكنك كتابة الترجمة بنفسك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhone kan ikke oversætte %1$@ til %2$@. Du kan skrive oversættelsen selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone kann nicht von %1$@ nach %2$@ übersetzen. Du kannst die Übersetzung selbst schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This iPhone can’t translate %1$@ to %2$@. You can write the translation yourself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone no puede traducir del %1$@ al %2$@. Puedes escribir la traducción tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone ne peut pas traduire du %1$@ vers le %2$@. Vous pouvez écrire la traduction vous-même."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह iPhone %1$@ से %2$@ में अनुवाद नहीं कर सकता। आप अनुवाद ख़ुद लिख सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone ini tidak bisa menerjemahkan %1$@ ke %2$@. Kamu bisa menulis terjemahannya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo iPhone non può tradurre da %1$@ a %2$@. Puoi scrivere tu la traduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneでは%1$@から%2$@に翻訳できません。翻訳を自分で入力できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone에서는 %1$@을(를) %2$@(으)로 번역할 수 없습니다. 번역을 직접 입력할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne iPhonen kan ikke oversette %1$@ til %2$@. Du kan skrive oversettelsen selv."
          }
        },
        "nl" : {
