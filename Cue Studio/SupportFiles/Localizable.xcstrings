    "Drag a point up to speed up, down to slow down." : {
      "comment" : "Speed curve editor note",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب نقطة لأعلى للإسراع ولأسفل للإبطاء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk et punkt op for at gå hurtigere, ned for at gå langsommere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zieh einen Punkt nach oben für schneller, nach unten für langsamer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un punto hacia arriba para acelerar y hacia abajo para ralentizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez un point vers le haut pour accélérer, vers le bas pour ralentir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तेज़ करने के लिए पॉइंट ऊपर, धीमा करने के लिए नीचे खींचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret titik ke atas untuk mempercepat, ke bawah untuk memperlambat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina un punto in alto per accelerare, in basso per rallentare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点を上にドラッグで速く、下で遅くなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점을 위로 끌면 빨라지고 아래로 끌면 느려져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
