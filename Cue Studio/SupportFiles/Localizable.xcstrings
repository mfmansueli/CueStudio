    "Share your first video and it becomes a star here, joined to the platform it travelled to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارك أول فيديو ليصبح نجمة هنا، متصلة بالمنصة التي سافر إليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile dein erstes Video, und es wird hier zu einem Stern, verbunden mit der Plattform, zu der es gereist ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu primer vídeo y se convertirá en una estrella aquí, unida a la plataforma a la que viajó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partage ta première vidéo : elle devient ici une étoile, reliée à la plateforme où elle a voyagé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहला वीडियो शेयर करें और वह यहाँ एक तारा बन जाएगा, उस प्लेटफ़ॉर्म से जुड़ा जहाँ वह गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bagikan video pertamamu dan ia jadi bintang di sini, terhubung ke platform tujuannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo primo video e diventerà una stella qui, collegata alla piattaforma a cui è arrivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の動画を共有すると、ここで星になり、届いたプラットフォームとつながります。"
