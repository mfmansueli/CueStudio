    "Shape it to see where to cut, or record as is — you can trim later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسّقه لترى أين تقصّ، أو سجّل كما هو — يمكنك القص لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme es, um zu sehen, wo du kürzen kannst, oder nimm es so auf — kürzen kannst du später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dale forma para ver dónde recortar, o graba tal cual: puedes recortar después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structurez-le pour voir où couper, ou enregistrez tel quel — vous pourrez raccourcir plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेप करके देखें कहाँ काटना है, या जैसा है वैसा रिकॉर्ड करें — बाद में ट्रिम कर सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bentuk dulu untuk lihat bagian yang dipotong, atau rekam apa adanya — bisa dipangkas nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Strutturalo per vedere dove tagliare, o registra così com’è: potrai tagliare dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整形してカットする場所を確認するか、そのまま録画しましょう。トリミングは後でできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정리해서 어디를 줄일지 확인하거나 그대로 녹화하세요. 나중에 다듬을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estruture para ver onde cortar ou grave como está — você pode cortar depois."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดโครงเพื่อดูว่าควรตัดตรงไหน หรืออัดเลยก็ได้ — ตัดทีหลังได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nereyi keseceğini görmek için şekillendir ya da olduğu gibi kaydet — sonra kırpabilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Định hình để xem nên cắt ở đâu, hoặc quay luôn — bạn có thể cắt sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先成型看看该在哪里删减，或直接录制 —— 之后还可以裁剪。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorm het om te zien waar je kunt inkorten, of neem op zoals het is — je kunt later bijsnijden."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forma det för att se var du kan korta, eller spela in som det är — du kan trimma senare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Form det for at se, hvor du kan klippe, eller optag, som det er — du kan trimme senere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Form det for å se hvor du kan kutte, eller ta opp som det er — du kan trimme senere."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先成形看看哪裡可以刪減，或直接錄影 — 之後還能修剪。"
          }
        }
      }
    },
