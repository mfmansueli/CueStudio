    "Ideas you catch wait here until you shape them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأفكار التي تلتقطها تنتظر هنا حتى تصوغها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideen, die du festhältst, warten hier, bis du sie formst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ideas que captures esperan aquí hasta que las formes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les idées capturées attendent ici que tu les façonnes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके दर्ज किए आइडिया यहाँ तब तक इंतज़ार करते हैं जब तक आप उन्हें आकार नहीं देते।"
