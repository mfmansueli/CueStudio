        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le idee che catturi aspettano qui finché non le modelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録したアイデアは、形にするまでここで待っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록한 아이디어는 다듬을 때까지 여기서 기다려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As ideias que você captura esperam aqui até você dar forma."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไอเดียที่คุณจับไว้จะรออยู่ที่นี่จนกว่าคุณจะปั้นมัน"
          }
        },
