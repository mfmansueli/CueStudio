    "Welcome back. Cue lights its planet once it’s live." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أهلًا بعودتك. يُضيء Cue كوكبها عندما تنشر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velkommen tilbage. Cue tænder sin planet, når den er live."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen zurück. Cue lässt den Planeten leuchten, sobald es live ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bienvenido de nuevo. Cue enciende su planeta cuando esté publicado."
