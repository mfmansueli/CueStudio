    "These gym mistakes are so common that most people never notice them." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخطاء النادي هذه شائعة لدرجة أن معظم الناس لا يلاحظونها أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De her fejl i fitnesscentret er så almindelige, at de fleste aldrig opdager dem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gym-Fehler sind so verbreitet, dass die meisten sie nie bemerken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos errores de gimnasio son tan comunes que casi nadie los nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces erreurs à la salle sont si courantes que la plupart ne les remarquent jamais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिम की ये गलतियाँ इतनी आम हैं कि ज़्यादातर लोग इन्हें कभी नोटिस नहीं करते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kesalahan gym ini begitu umum sampai kebanyakan orang nggak pernah sadar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi errori in palestra sono così comuni che quasi nessuno li nota."
