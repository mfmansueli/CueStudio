    "Asks for confirmation. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب التأكيد. لا يمكن التراجع عن هذا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beder om bekræftelse. Kan ikke fortrydes."
          }
        },
