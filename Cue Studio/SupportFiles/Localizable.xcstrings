    "Cue says it only where it is true of you, and never invents another." : {
      "comment" : "My Cue Voice (Apple Intelligence plan)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يذكرها Cue فقط حيث تنطبق عليك، ولا يخترع مؤهلات أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nævner den kun, hvor den passer på dig, og opfinder aldrig en anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nennt sie nur dort, wo sie auf dich zutrifft, und erfindet nie eine andere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue la menciona solo donde es cierta y nunca inventa otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ne la mentionne que lorsqu’elle est vraie et n’en invente jamais d’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue इसे सिर्फ़ वहीं कहता है जहाँ यह आप पर सच हो, और कोई दूसरी योग्यता कभी नहीं गढ़ता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue hanya menyebutnya jika memang sesuai denganmu, dan tidak pernah mengarang yang lain."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue la dice solo dove è vera per te e non ne inventa mai altre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueは当てはまる場面でだけ使い、他の肩書きを作り出すことはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 실제로 해당될 때만 이 자격을 말하고, 다른 자격을 지어내지 않아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nevner den bare der den stemmer for deg, og finner aldri på en annen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue noemt die alleen waar die op jou van toepassing is en verzint nooit een andere."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue só a menciona quando for verdadeira para você e nunca inventa outra."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nämner den bara där den stämmer på dig och hittar aldrig på en annan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue จะพูดถึงเฉพาะตอนที่ตรงกับคุณ และไม่แต่งคุณวุฒิอื่นขึ้นมาเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue bunu yalnızca sana uyduğu yerde söyler ve asla başka bir unvan uydurmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue chỉ nhắc đến khi đúng với bạn và không bao giờ bịa ra chứng chỉ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 只在符合你的情况时才会提到，绝不会编造其他资质。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 只在符合你的情況時才會提到，絕不會編造其他資歷。"
          }
        }
      }
    },
    "Cue sets the frame, safe zones, teleprompter position and length goals. Fine-tune anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضبط Cue الإطار والمناطق الآمنة وموضع الملقّن وأهداف المدة. عدّلها متى شئت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue indstiller billedformat, sikre zoner, teleprompterens placering og længdemål. Finjuster når som helst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue stellt Bildausschnitt, sichere Bereiche, Teleprompter-Position und Längenziele ein. Jederzeit anpassbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ajusta el encuadre, las zonas seguras, la posición del teleprompter y los objetivos de duración. Afínalo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue règle le cadrage, les zones sûres, la position du téléprompteur et les objectifs de durée. Ajustez quand vous voulez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue फ़्रेम, सेफ़ ज़ोन, टेलीप्रॉम्प्टर की जगह और लंबाई के लक्ष्य सेट करता है। कभी भी बदलें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue mengatur bingkai, zona aman, posisi teleprompter, dan target durasi. Sesuaikan kapan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue imposta formato, zone sicure, posizione del teleprompter e obiettivi di durata. Rifinisci quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueがフレーム、セーフゾーン、プロンプターの位置、長さの目安を設定します。いつでも微調整できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 프레임, 세이프 존, 프롬프터 위치, 길이 목표를 설정해요. 언제든 조정할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue stiller inn bildeformat, trygge soner, teleprompterens plassering og lengdemål. Finjuster når som helst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue stelt het beeld, de veilige zones, de positie van de teleprompter en de lengtedoelen in. Stem het altijd zelf af."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue define o enquadramento, as zonas seguras, a posição do teleprompter e as metas de duração. Ajuste quando quiser."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ställer in format, säkra zoner, teleprompterns position och längdmål. Finjustera när som helst."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ตั้งเฟรม พื้นที่ปลอดภัย ตำแหน่งเทเลพรอมป์เตอร์ และเป้าความยาวให้ ปรับละเอียดได้ทุกเมื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kadrajı, güvenli alanları, teleprompter konumunu ve süre hedeflerini ayarlar. İstediğin zaman ince ayar yap."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue đặt khung hình, vùng an toàn, vị trí teleprompter và mục tiêu độ dài. Tinh chỉnh bất cứ lúc nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会设置画幅、安全区、提词器位置和时长目标。你可以随时微调。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 會設定畫幅、安全區、提詞機位置與長度目標。隨時都可以微調。"
          }
        }
      }
    },
