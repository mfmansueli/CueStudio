    "TikTok only pays Creator Rewards on videos longer than one minute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدفع TikTok مكافآت Creator Rewards فقط للفيديوهات التي تتجاوز دقيقة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok zahlt Creator Rewards nur für Videos, die länger als eine Minute sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok solo paga Creator Rewards en vídeos de más de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTok ne verse les Creator Rewards que pour les vidéos de plus d’une minute."
