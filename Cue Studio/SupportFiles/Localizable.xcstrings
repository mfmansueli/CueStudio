        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có ý tưởng chưa? Hãy nói hoặc gõ — Cue viết kịch bản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
