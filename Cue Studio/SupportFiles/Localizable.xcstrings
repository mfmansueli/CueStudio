          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op het eerste woord van het stuk dat je wilt knippen en daarna op het laatste. Doorgestreepte woorden zijn geknipt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
