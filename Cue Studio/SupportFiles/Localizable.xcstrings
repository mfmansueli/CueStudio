          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schnitt bei %@ · „Ohne“ lässt ihn als harten Schnitt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corte en %@ · Ninguna lo deja como corte seco"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coupe à %@ · Aucune garde une coupe franche"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ पर कट · कोई नहीं चुनने पर सीधा कट रहेगा"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potongan di %@ · Tidak Ada membuatnya tetap potong langsung"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglio a %@ · Nessuna lo lascia un taglio netto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のカット · 「なし」でそのままカット"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 컷 · ‘없음’은 그대로 잘라요"
