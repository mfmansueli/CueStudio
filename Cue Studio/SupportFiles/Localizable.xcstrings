    "Catch it in the Logbook now. Develop it later." : {
      "comment" : "Discovery notification body (Logbook)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّلها الآن في دفتر اليوميات وطوّرها لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang den i Logbogen nu. Arbejd videre med den senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte sie jetzt im Logbuch fest. Ausbauen kannst du sie später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anótala ahora en la Bitácora. Desarróllala después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez-la maintenant dans le Journal de bord. Développez-la plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी लॉगबुक में लिख लें। बाद में आगे बढ़ाएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat di Buku log sekarang. Kembangkan nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annotala ora nel Diario di bordo. Sviluppala dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今すぐ航海日誌に書き留めて、あとで形にしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금 항해 일지에 적어 두고 나중에 발전시키세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang den i Loggboken nå. Utvikle den senere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg het nu vast in je logboek. Werk het later uit."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote agora no Diário de bordo. Desenvolva depois."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fånga den i loggboken nu. Utveckla den senare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จดไว้ในสมุดบันทึกตอนนี้ แล้วค่อยพัฒนาทีหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şimdi seyir defterine yaz, sonra geliştir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi vào Nhật ký ngay. Phát triển sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在记进航行日志，以后再完善。"
          }
