    "Starting to run is harder than it looks, and that’s normal." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البدء في الجري أصعب مما يبدو، وهذا طبيعي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At begynde at løbe er sværere, end det ser ud, og det er helt normalt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Laufen anzufangen ist schwerer, als es aussieht, und das ist normal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empezar a correr es más difícil de lo que parece, y es normal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer à courir est plus dur qu’il n’y paraît, et c’est normal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दौड़ना शुरू करना जितना दिखता है उससे मुश्किल है, और यह सामान्य है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai lari itu lebih susah dari kelihatannya, dan itu wajar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniziare a correre è più difficile di quanto sembri, ed è normale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走り始めは見た目より大変。でも、それが普通です。"
          }
        },
