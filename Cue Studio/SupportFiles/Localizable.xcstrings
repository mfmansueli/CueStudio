          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเสร็จสิ้นในตัวตัดต่อ หรือเลือกเทคที่ดีที่สุด แล้ววิดีโอจะมาอยู่ที่นี่พร้อมโพสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düzenleyicide Bitti’a dokun ya da en iyi çekimi seç; video burada paylaşıma hazır görünür."
          }
        },
        "vi" : {
          "stringUnit" : {
