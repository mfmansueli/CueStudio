    "Lines, timing, size and place stay" : {
      "comment" : "Apply a brand kit sheet (✦ Smart › Brand, tapping a kit), detail line under the Caption style row (its title reads \"Caption style · <style name>\"): the video has captions; their lines, timing, size and place don't change",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الأسطر والتوقيت والحجم والمكان"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjer, timing, størrelse og placering bliver"
          }
