    "Viewers decide in the first 3 seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرر المشاهدون في أول 3 ثوانٍ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerne beslutter sig inden for de første 3 sekunder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuschauer entscheiden in den ersten 3 Sekunden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El público decide en los primeros 3 segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le public décide dans les 3 premières secondes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दर्शक पहले 3 सेकंड में फ़ैसला कर लेते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penonton memutuskan dalam 3 detik pertama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pubblico decide nei primi 3 secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴者は最初の3秒で決めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청자는 처음 3초 안에 결정해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerne bestemmer seg i løpet av de første 3 sekundene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijkers beslissen in de eerste 3 seconden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O público decide nos primeiros 3 segundos."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tittarna bestämmer sig inom de första 3 sekunderna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คนดูตัดสินใจใน 3 วินาทีแรก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzleyiciler ilk 3 saniyede karar verir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Người xem quyết định trong 3 giây đầu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观众在前 3 秒就做出决定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "觀眾在前 3 秒就會決定要不要看下去。"
          }
        }
      }
    },
