    "Want Cue to write it? Use the Let’s Cue card." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تريد أن يكتبه Cue؟ استخدم بطاقة «هيا نبدأ مع Cue!»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue soll schreiben? Nutze die Karte „Los geht’s mit Cue!“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres que Cue lo escriba? Usa la tarjeta «¡Vamos con Cue!»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue peut l’écrire pour vous. Utilisez la carte « C’est parti avec Cue ! »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चाहते हैं कि Cue लिखे? “चलिए, Cue करें!” कार्ड इस्तेमाल करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mau Cue yang menulis? Pakai kartu “Ayo Cue!”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi che sia Cue a scriverlo? Usa la scheda «Si parte con Cue!»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueに書かせたいときは、「さあ、Cue しよう！」のカードをお使いください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue가 써 주길 원하나요? “Cue 시작해요!” 카드를 사용해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quer que o Cue escreva? Use o card “Vamos de Cue!”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อยากให้ Cue เขียนให้? ใช้การ์ด “ไปกับ Cue กัน!”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue yazsın mı istiyorsun? “Haydi Cue!” kartını kullan."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muốn Cue viết giúp? Dùng thẻ “Cùng Cue nào!”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想让 Cue 来写？用“来 Cue 吧！”这张卡片。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wil je dat Cue het schrijft? Gebruik de Let’s Cue-kaart."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vill du att Cue ska skriva det? Använd Let’s Cue-kortet."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du have, at Cue skriver det? Brug Let’s Cue-kortet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du at Cue skal skrive det? Bruk Let’s Cue-kortet."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想讓 Cue 來寫嗎？使用 Let’s Cue 卡片。"
          }
