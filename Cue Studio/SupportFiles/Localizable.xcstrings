    "Creator Rewards only counts videos over one minute, and TikTok has other rules too." : {
      "comment" : "Why stopping a TikTok take early matters, shown when the creator tries to stop short. Must not promise earnings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تحتسب مكافآت المبدعين إلا الفيديوهات الأطول من دقيقة، ولدى TikTok قواعد أخرى أيضًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creator Rewards tæller kun videoer over ét minut, og TikTok har også andre regler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creator Rewards zählt nur Videos über einer Minute, und TikTok hat noch weitere Regeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creator Rewards solo cuenta videos de más de un minuto, y TikTok tiene otras reglas."
