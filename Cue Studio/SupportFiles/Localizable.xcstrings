    "Only the type changes. Filters and the cover stay as they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتغيّر الخط فقط. تبقى الفلاتر والغلاف كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur die Schrift ändert sich. Filter und Cover bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia la tipografía. Los filtros y la portada quedan igual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seule la typographie change. Les filtres et la couverture restent tels quels."
          }
