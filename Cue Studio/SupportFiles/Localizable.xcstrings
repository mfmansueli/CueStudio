    "Story time — and yes, it ends well." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت الحكاية — ونعم، تنتهي نهاية سعيدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storytime – und ja, es geht gut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hora del cuento — y sí, acaba bien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Petite histoire — et oui, ça finit bien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कहानी का वक़्त — और हाँ, अंत अच्छा है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktunya cerita — dan ya, akhirnya bahagia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storytime — e sì, finisce bene."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ちょっとした話 — ちゃんとハッピーエンドです。"
