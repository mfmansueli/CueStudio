        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TikTokのCreator Rewardsは1分を超える動画にのみ支払われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
