    "Your recording stays as filmed. The effect is added to the take, and you can change it in Quick edit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى تسجيلك كما صُوّر. يُضاف التأثير إلى اللقطة، ويمكنك تغييره في التعديل السريع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufnahme bleibt, wie sie gefilmt wurde. Der Effekt wird dem Take hinzugefügt, und du kannst ihn im Schnellschnitt ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu grabación queda tal como se grabó. El efecto se añade a la toma y puedes cambiarlo en Edición rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre enregistrement reste tel qu’il a été filmé. L’effet est ajouté à la prise, et vous pouvez le modifier dans Montage rapide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रिकॉर्डिंग वैसी ही रहती है जैसी फ़िल्माई गई। इफ़ेक्ट टेक में जुड़ता है, और आप इसे क्विक एडिट में बदल सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekamanmu tetap seperti saat direkam. Efek ditambahkan ke take, dan kamu bisa mengubahnya di Edit cepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione resta come è stata girata. L’effetto viene aggiunto alla ripresa e puoi cambiarlo in Modifica rapida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録はそのまま残ります。効果はテイクに追加され、クイック編集で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹화 원본은 그대로입니다. 효과는 테이크에 추가되며 빠른 편집에서 바꿀 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua gravação fica como foi filmada. O efeito é adicionado ao take, e você pode mudá-lo na Edição rápida."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์ที่อัดยังเหมือนตอนถ่าย เอฟเฟกต์จะเพิ่มลงในเทค และเปลี่ยนได้ในแก้ไขด่วน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydın çekildiği gibi kalır. Efekt çekime eklenir ve Hızlı düzenleme’de değiştirebilirsin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bản quay giữ nguyên như lúc quay. Hiệu ứng được thêm vào cảnh quay và bạn có thể đổi trong Sửa nhanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的录制保持原样。效果会添加到镜头中，可在快速剪辑中更改。"
          }
        }
      }
    },
