    "Use only music you own or have the rights to. Songs from Apple Music can’t be added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم فقط موسيقى تملكها أو لديك حقوقها. لا يمكن إضافة أغاني Apple Music."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze nur Musik, die dir gehört oder für die du die Rechte hast. Titel aus Apple Music können nicht hinzugefügt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo música tuya o con derechos. Las canciones de Apple Music no se pueden añadir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’utilisez que de la musique à vous ou dont vous avez les droits. Les titres d’Apple Music ne peuvent pas être ajoutés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिर्फ़ वही म्यूज़िक इस्तेमाल करें जो आपका है या जिसके अधिकार आपके पास हैं। Apple Music के गाने नहीं जोड़े जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan hanya musik milikmu atau yang kamu punya haknya. Lagu dari Apple Music tidak bisa ditambahkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa solo musica tua o di cui hai i diritti. I brani di Apple Music non si possono aggiungere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分が所有する、または権利を持つ音楽だけを使ってください。Apple Musicの曲は追加できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 소유했거나 권리가 있는 음악만 사용하세요. Apple Music의 노래는 추가할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use só músicas suas ou com direitos. Músicas do Apple Music não podem ser adicionadas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้เฉพาะเพลงของคุณเองหรือที่คุณมีสิทธิ์ เพลงจาก Apple Music เพิ่มไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca sahibi olduğun veya haklarına sahip olduğun müziği kullan. Apple Music şarkıları eklenemez."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ dùng nhạc của bạn hoặc nhạc bạn có quyền. Không thể thêm bài hát từ Apple Music."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只使用你拥有或有权使用的音乐。无法添加 Apple Music 中的歌曲。"
          }
        }
      }
    },
