    "Redo it as often as you like. You pick the take that's posted." : {
      "comment" : "First voyage record tip line",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعده كما تشاء. أنت تختار اللقطة التي تُنشر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag det om, så tit du vil. Du vælger den optagelse, der skal deles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederhole es, so oft du willst. Du wählst den Take, den du postest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repítelo cuantas veces quieras. Tú eliges la toma que se publica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recommencez autant de fois que vous voulez. Vous choisissez la prise publiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जितनी बार चाहें दोबारा करें। कौन-सा टेक पोस्ट होगा, आप चुनते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ulangi sesukamu. Kamu yang memilih take yang akan diposting."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rifalla quante volte vuoi. Scegli tu la ripresa da pubblicare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何度でも撮り直せます。投稿するテイクはあなたが選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 만큼 다시 찍으세요. 올릴 테이크는 직접 골라요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta det om så ofte du vil. Du velger opptaket som legges ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe het zo vaak als je wilt. Jij kiest de opname die online gaat."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refaça quantas vezes quiser. Você escolhe o take que vai ao ar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör om så många gånger du vill. Du väljer tagningen som läggs upp."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ่ายใหม่ได้ตามใจ คุณเลือกเทคที่จะโพสต์เอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İstediğin kadar tekrarla. Paylaşılacak çekimi sen seçersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quay bao nhiêu lần cũng được. Bạn chọn cảnh quay được đăng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想重来几次都行。发哪个镜头由你选。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想重來幾次都行。發哪個鏡頭由你選。"
          }
        }
      }
    },
