    "Tell me your snooze count below." : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرني كم مرة تؤجّل المنبّه في التعليقات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv, hvor mange gange du trykker på udsæt, nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreib unten, wie oft du auf Schlummern drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntame en los comentarios cuántas veces pospones la alarma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-moi en commentaire combien de fois vous repoussez l’alarme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नीचे बताइए आप कितनी बार स्नूज़ दबाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tulis di bawah berapa kali kamu menekan snooze."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivimi qui sotto quante volte premi snooze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スヌーズを何回押すか、コメントで教えてね。"
          }
        },
        "ko" : {
          "stringUnit" : {
