          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेटफ़ॉर्म बदलने पर प्रीसेट अपने-आप अपडेट होते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
