    "Turn on Enhance voice or Reduce noise to compare." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغّل تحسين الصوت أو تقليل الضوضاء للمقارنة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå Forbedr stemmen eller Reducér støj til for at sammenligne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere „Stimme verbessern“ oder „Rauschen reduzieren“, um zu vergleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Mejorar voz o Reducir ruido para comparar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Améliorer la voix ou Réduire le bruit pour comparer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुलना के लिए आवाज़ बेहतर करें या शोर कम करें चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyalakan Tingkatkan suara atau Kurangi derau untuk membandingkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Migliora la voce o Riduci il rumore per confrontare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較するには「声を補正」か「ノイズを軽減」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비교하려면 목소리 보정 또는 소음 줄이기를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Forbedre stemmen eller Reduser støy for å sammenligne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Stem verbeteren of Ruis verminderen aan om te vergelijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Realçar voz ou Reduzir ruído para comparar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Förbättra rösten eller Minska brus för att jämföra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดปรับเสียงพูดให้ดีขึ้นหรือลดเสียงรบกวนเพื่อเปรียบเทียบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
