        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिखने के चरणों के बीच का ड्राफ़्ट, निखार के लिए और, अगर वह लंबा हो जाए, तो उसे सही लंबाई में लाने के लिए"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
