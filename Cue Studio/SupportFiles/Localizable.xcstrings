          "stringUnit" : {
            "state" : "translated",
            "value" : "Presets werden mit den Plattformen aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los preajustes se actualizan cuando cambian las plataformas."
          }
        },
