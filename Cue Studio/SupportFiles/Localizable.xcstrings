    "After posting, tap ◀ Cue at the top left. We'll come back to finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد النشر، اضغط ◀ Cue في أعلى الشاشة للعودة وإنهاء المشاركة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har slået den op, så tryk på ◀ Cue øverst til venstre for at gøre det færdigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe nach dem Posten oben links auf ◀ Cue. Danach geht es hier weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de publicar, toca ◀ Cue arriba a la izquierda. Volveremos para terminar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la publication, touchez ◀ Cue en haut à gauche pour revenir et terminer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पोस्ट करने के बाद ऊपर बाईं ओर ◀ Cue पर टैप करें। फिर यहीं से पूरा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah memposting, ketuk ◀ Cue di kiri atas untuk kembali dan menyelesaikannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver pubblicato, tocca ◀ Cue in alto a sinistra per tornare e finire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投稿したら、左上の◀ Cueをタップしてください。最後にここへ戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게시한 후 왼쪽 위의 ◀ Cue를 탭하세요. 돌아와서 마무리하면 돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du har postet, trykker du på ◀ Cue øverst til venstre for å fullføre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik na het posten linksboven op ◀ Cue. We komen terug om af te ronden."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de postar, toque em ◀ Cue no canto superior esquerdo. Vamos voltar para terminar."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har postat trycker du på ◀ Cue högst upp till vänster för att slutföra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังโพสต์ ให้แตะ ◀ Cue ที่มุมซ้ายบน เพื่อกลับมาทำต่อให้เสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaştıktan sonra sol üstteki ◀ Cue’ya dokun. Bitirmek için buraya dönersin."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi đăng, chạm ◀ Cue ở góc trên bên trái. Cue sẽ đưa bạn quay lại để hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发布后，轻点左上角的 ◀ Cue，回来完成剩下的步骤。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發布後，輕點左上角的 ◀ Cue，回來完成剩下的步驟。"
          }
        }
      }
    },
