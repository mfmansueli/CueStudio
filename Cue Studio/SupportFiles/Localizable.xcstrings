    "Background and blur only change your preview — never the recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخلفية والتمويه يغيّران المعاينة فقط — وليس التسجيل أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hintergrund und Unschärfe ändern nur die Vorschau – nie die Aufnahme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El fondo y el desenfoque solo cambian la vista previa — nunca la grabación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’arrière-plan et le flou ne changent que l’aperçu — jamais l’enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बैकग्राउंड और ब्लर सिर्फ़ प्रीव्यू बदलते हैं — रिकॉर्डिंग कभी नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Latar dan buram hanya mengubah pratinjau — tidak pernah rekamannya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sfondo e sfocatura cambiano solo l’anteprima — mai la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景とぼかしが変わるのはプレビューだけ — 録画は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배경과 흐림은 미리보기만 바꿔요 — 녹화에는 적용되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fundo e desfoque só mudam a prévia — nunca a gravação."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นหลังและความเบลอเปลี่ยนแค่ภาพพรีวิว — ไม่เปลี่ยนวิดีโอที่อัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arka plan ve bulanıklık yalnızca önizlemeyi değiştirir — kaydı asla."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nền và độ mờ chỉ thay đổi bản xem trước — không bao giờ thay đổi video quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背景和模糊只改变预览 — 不影响录制。"
          }
        }
      }
    },
