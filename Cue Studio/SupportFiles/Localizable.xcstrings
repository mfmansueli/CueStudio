    "A Blur area may not cover what it hides" : {
      "comment" : "Dialog before Done",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد لا تغطي منطقة الطمس ما تخفيه"
