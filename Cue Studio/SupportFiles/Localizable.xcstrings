    "Consider limiting phone use, drinking water and setting goals for the day." : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فكّر في تقليل استخدام الهاتف وشرب الماء ووضع أهداف لليوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overvej at begrænse telefonbrug, drikke vand og sætte mål for dagen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überlege, die Handynutzung zu begrenzen, Wasser zu trinken und dir Ziele für den Tag zu setzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba a limitar el uso del teléfono, beber agua y ponerte metas para el día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pensez à limiter le téléphone, à boire de l’eau et à vous fixer des objectifs pour la journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोन का इस्तेमाल सीमित करें, पानी पिएँ और दिन के लक्ष्य तय करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba batasi pemakaian ponsel, minum air, dan tetapkan target untuk hari ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova a limitare il telefono, a bere acqua e a darti degli obiettivi per la giornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマホの使用を控え、水を飲み、その日の目標を決めてみましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰 사용을 줄이고, 물을 마시고, 하루의 목표를 세워 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøv å begrense telefonbruken, drikke vann og sette mål for dagen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probeer je telefoongebruik te beperken, water te drinken en doelen voor de dag te stellen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente limitar o celular, beber água e definir metas para o dia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Försök begränsa mobilen, dricka vatten och sätta mål för dagen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองจำกัดการใช้โทรศัพท์ ดื่มน้ำ และตั้งเป้าหมายสำหรับวันนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefon kullanımını sınırlamayı, su içmeyi ve gün için hedefler koymayı dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy thử hạn chế dùng điện thoại, uống nước và đặt mục tiêu cho ngày hôm nay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试着少看手机、多喝水，并为今天定下目标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試著少看手機、多喝水，並為今天訂下目標。"
          }
        }
      }
    },
