    "This camera can’t show the effect while recording. It’s added to the take after you record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تستطيع هذه الكاميرا عرض التأثير أثناء التسجيل. سيُضاف إلى اللقطة بعد التسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kamera kann den Effekt während der Aufnahme nicht zeigen. Er wird dem Take danach hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cámara no puede mostrar el efecto mientras grabas. Se añade a la toma después de grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette caméra ne peut pas montrer l’effet pendant que vous filmez. Il est ajouté à la prise ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कैमरा रिकॉर्ड करते समय इफ़ेक्ट नहीं दिखा सकता। रिकॉर्ड करने के बाद इसे टेक में जोड़ा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera ini tidak bisa menampilkan efek saat merekam. Efek ditambahkan ke take setelah kamu merekam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa fotocamera non può mostrare l’effetto mentre registri. Viene aggiunto alla ripresa dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカメラでは録画中に効果を表示できません。録画後にテイクに追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 카메라는 녹화 중에 효과를 보여줄 수 없습니다. 녹화 후 테이크에 추가됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta câmera não consegue mostrar o efeito enquanto grava. Ele é adicionado ao take depois de gravar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กล้องนี้แสดงเอฟเฟกต์ระหว่างอัดไม่ได้ จะเพิ่มลงในเทคหลังอัดเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kamera kayıt sırasında efekti gösteremiyor. Kayıttan sonra çekime eklenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera này không hiện được hiệu ứng khi quay. Hiệu ứng được thêm vào cảnh quay sau khi quay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此相机无法在录制时显示效果。录制后会添加到镜头中。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze camera kan het effect niet tonen tijdens het opnemen. Het wordt na het opnemen aan de opname toegevoegd."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den här kameran kan inte visa effekten under inspelning. Den läggs till i tagningen efter inspelningen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
