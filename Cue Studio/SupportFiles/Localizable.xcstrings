        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciddi mod: kanca, şaka, abartı veya “daha fazlası için takip et” yok."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chế độ nghiêm túc: không hook, không đùa, không phô trương hay “theo dõi để xem thêm”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "严肃模式：没有钩子、玩笑、夸张或“关注我看更多”。"
          }
