    "Fifteen minutes on Sunday can make the whole week calmer." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خمس عشرة دقيقة يوم الأحد قد تجعل الأسبوع كله أهدأ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et kvarter om søndagen kan gøre hele ugen roligere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünfzehn Minuten am Sonntag können die ganze Woche ruhiger machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quince minutos el domingo pueden hacer toda la semana más tranquila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quinze minutes le dimanche peuvent rendre toute la semaine plus calme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रविवार को पंद्रह मिनट पूरे हफ़्ते को शांत बना सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lima belas menit di hari Minggu bisa bikin seminggu lebih tenang."
