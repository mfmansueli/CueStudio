    "Ask your audience one question and share your own answer first." : {
      "comment" : "Find inspiration: the angle of a starter made from the creator's own topic (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرح سؤالًا واحدًا على جمهورك وشارك إجابتك أولًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stil dit publikum ét spørgsmål, og del dit eget svar først."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell deinem Publikum eine Frage und gib zuerst deine eigene Antwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hazle una pregunta a tu audiencia y comparte primero tu respuesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez une question à votre public et donnez d’abord votre propre réponse."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने दर्शकों से एक सवाल पूछें और पहले अपना जवाब बताएँ।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajukan satu pertanyaan ke penonton dan bagikan jawabanmu sendiri lebih dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai una domanda al tuo pubblico e condividi prima la tua risposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴者に質問をひとつ投げかけ、まず自分の答えを話す。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시청자에게 질문을 하나 던지고, 자신의 답을 먼저 말해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still publikummet ditt ett spørsmål og del ditt eget svar først."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel je publiek één vraag en geef eerst je eigen antwoord."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça uma pergunta ao seu público e dê a sua resposta primeiro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ en fråga till din publik och dela ditt eget svar först."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถามผู้ชมหนึ่งคำถาม และเล่าคำตอบของตัวเองก่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
