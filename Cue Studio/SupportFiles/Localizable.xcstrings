    "Send this to someone who still believes it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل هذا لمن ما زال يصدّقها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send den her til en, der stadig tror på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schick das jemandem, der es noch glaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía esto a alguien que todavía se lo crea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez ça à quelqu’un qui y croit encore."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह उसे भेजें जो अब भी इसे मानता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirim ini ke orang yang masih memercayainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mandalo a chi ci crede ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ信じている人に送ってあげてね。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직도 믿는 사람에게 보내 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send dette til noen som fortsatt tror på det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuur dit naar iemand die het nog gelooft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manda isso pra quem ainda acredita."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skicka det här till någon som fortfarande tror på det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งคลิปนี้ให้คนที่ยังเชื่ออยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu hâlâ buna inanan birine gönder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi video này cho người vẫn còn tin điều đó."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把这个发给还信这个误区的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把這個傳給還相信這個迷思的人。"
          }
        }
      }
    },
