        }
      }
    },
    "Before you upgrade, ask yourself one simple question." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن تقوم بالترقية، اسأل نفسك سؤالًا بسيطًا واحدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du opgraderer, så stil dig selv ét enkelt spørgsmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du aufrüstest, stell dir eine einfache Frage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de actualizar, hazte una pregunta sencilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de changer d’appareil, posez-vous une question simple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपग्रेड करने से पहले, ख़ुद से एक आसान सवाल पूछें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum upgrade, tanyakan satu pertanyaan sederhana ke dirimu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di aggiornare, fatti una semplice domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "買い替える前に、自分にひとつだけ質問してみて。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업그레이드하기 전에 스스로에게 간단한 질문 하나를 해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du oppgraderer, still deg selv ett enkelt spørsmål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel jezelf één simpele vraag voor je upgradet."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de trocar, faça a si mesmo uma pergunta simples."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du uppgraderar, ställ dig själv en enkel fråga."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ก่อนอัปเกรด ลองถามตัวเองคำถามง่าย ๆ ข้อหนึ่ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükseltmeden önce kendine basit bir soru sor."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi nâng cấp, hãy tự hỏi một câu đơn giản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升级之前，先问自己一个简单的问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升級之前，先問自己一個簡單的問題。"
          }
        }
      }
    },
    "Before your next purchase, ask yourself this one question." : {
