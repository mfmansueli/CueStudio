            "value" : "Her er grunden til, at dine første ti minutter afgør din dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Darum entscheiden deine ersten zehn Minuten über deinen Tag."
          }
