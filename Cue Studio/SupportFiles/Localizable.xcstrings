    "Ideas come from the niche in My Cue Voice. Tap one to fine-tune it in Prompt." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأتي الأفكار من المجال المحدد في My Cue Voice. اضغط على إحداها لتحسينها في الطلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ideen kommen aus der Nische in My Cue Voice. Tippe auf eine, um sie im Prompt anzupassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ideas salen del nicho de My Cue Voice. Toca una para afinarla en Prompt."
