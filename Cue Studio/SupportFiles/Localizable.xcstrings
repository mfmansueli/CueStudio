    "Suggestions only — you decide what goes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجرد اقتراحات — أنت تقرر ما يُحذف"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Vorschläge – du entscheidest, was rausfliegt"
          }
