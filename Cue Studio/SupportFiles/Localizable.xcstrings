    "Getting ready to follow your words. Scrolls at %@ while you talk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ التجهيز لتتبّع كلماتك. يتحرك بسرعة %@ أثناء حديثك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereitet das Folgen deiner Worte vor. Scrollt mit %@, während du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparándose para seguir tus palabras. Se desplaza a %@ mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparation du suivi de vos mots. Défile à %@ pendant que vous parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शब्दों के साथ चलने की तैयारी हो रही है। आपके बोलते समय %@ पर स्क्रॉल होता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersiap mengikuti kata-katamu. Bergulir pada %@ saat kamu bicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi preparo a seguire le tue parole. Scorre a %@ mentre parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉に合わせる準備をしています。話している間%@でスクロール。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단어를 따라갈 준비 중이에요. 말하는 동안 %@로 스크롤."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preparando para seguir suas palavras. Rola a %@ enquanto você fala."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กำลังเตรียมเลื่อนตามคำที่คุณพูด ระหว่างนี้เลื่อนที่ %@ ขณะที่คุณพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlerini takip etmeye hazırlanıyor. Sen konuşurken %@ hızla kayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đang chuẩn bị theo từng lời bạn nói. Cuộn ở %@ khi bạn nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在准备跟随你说的话。你说话时以 %@ 滚动。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voorbereiden om je woorden te volgen. Scrollt op %@ terwijl je praat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gör sig redo att följa dina ord. Skrollar med %@ medan du pratar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gør klar til at følge dine ord. Ruller med %@, mens du taler."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjør klar for å følge ordene dine. Ruller med %@ mens du snakker."
