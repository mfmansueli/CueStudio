    "Five quick questions. Cue's drafts start closer to you." : {
      "comment" : "Feature introduction of My Cue Voice (its setup has five questions)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خمسة أسئلة سريعة. تبدأ مسودات Cue أقرب إليك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem hurtige spørgsmål. Cues udkast starter tættere på dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fünf kurze Fragen. So klingen Cues Entwürfe von Anfang an mehr nach dir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco preguntas rápidas. Los borradores de Cue empiezan más cerca de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinq questions rapides. Les brouillons de Cue partent plus près de vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाँच छोटे सवाल। Cue के ड्राफ़्ट आपके और क़रीब से शुरू होंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lima pertanyaan singkat. Draf dari Cue jadi lebih mirip denganmu sejak awal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque domande veloci. Le bozze di Cue partono più vicine a te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5つの簡単な質問で、Cueの下書きがあなたに近づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "짧은 질문 다섯 개. Cue의 초안이 처음부터 나에게 더 가까워져요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem raske spørsmål. Cues utkast starter nærmere deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vijf korte vragen. De concepten van Cue beginnen dichter bij jou."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinco perguntas rápidas. Os rascunhos do Cue começam mais perto de você."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fem snabba frågor. Cues utkast börjar närmare dig."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ห้าคำถามสั้นๆ ฉบับร่างของ Cue จะเริ่มใกล้ตัวคุณขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beş kısa soru. Cue’nun taslakları sana daha yakın başlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Năm câu hỏi nhanh. Bản nháp của Cue sẽ gần bạn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "五个快速问题，让 Cue 的草稿更贴近你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "五個快速問題，讓 Cue 的草稿更貼近你。"
          }
        }
      }
