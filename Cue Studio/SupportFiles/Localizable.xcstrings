    "Can we talk about this for a second?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يمكننا التحدث عن هذا لحظة؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan vi tale lidt om det her?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Können wir kurz darüber reden?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Podemos hablar de esto un segundo?"
          }
        },
        "fr" : {
