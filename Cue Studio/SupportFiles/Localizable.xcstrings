    "Let’s make mornings a little softer, okay?" : {
      "comment" : "My Cue Voice: preview and learning",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لنجعل الصباحات ألطف قليلًا، اتفقنا؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lad os gøre morgenerne lidt blødere, okay?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen wir den Morgen ein bisschen sanfter, okay?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hagamos las mañanas un poco más suaves, ¿sí?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendons les matins un peu plus doux, d’accord ?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चलो सुबहों को थोड़ा और नरम बनाते हैं, ठीक है?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yuk buat pagi sedikit lebih lembut, ya?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendiamo le mattine un po’ più dolci, ok?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "朝を少しだけやさしくしてみませんか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아침을 조금만 더 부드럽게 만들어 볼까요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La oss gjøre morgenene litt mykere, ok?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laten we de ochtenden wat zachter maken, oké?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vamos deixar as manhãs um pouco mais leves, certo?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låt oss göra morgnarna lite mjukare, okej?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มาทำให้ตอนเช้านุ่มนวลขึ้นอีกนิดกันนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabahları biraz daha yumuşatalım, olur mu?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình cùng làm buổi sáng nhẹ nhàng hơn một chút nhé?"
          }
