        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिस हिस्से को काटना है उसके पहले शब्द पर टैप करें, फिर आखिरी शब्द पर। कटे हुए शब्दों पर लाइन है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk kata pertama bagian yang ingin dipotong, lalu kata terakhirnya. Kata yang dicoret sudah dipotong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
