    "Hold the mic to catch an idea. Write it later." : {
      "comment" : "A description of how to use the Logbook.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولاً على الميكروفون لالتقاط فكرة. اكتبها لاحقاً."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold mikrofonen for at fange en idé. Skriv den senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Mikrofontaste gedrückt, um eine Idee festzuhalten. Schreib sie später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el micrófono para captar una idea. Escríbela luego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le micro pour noter une idée. Écrivez-la plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आइडिया नोट करने के लिए माइक दबाए रखें। बाद में लिखें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tahan mikrofon untuk menangkap ide. Tulis nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il microfono per catturare un’idea. Scrivila dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクを長押しでアイデアを記録。書くのはあとで。"
          }
        },
        "ko" : {
