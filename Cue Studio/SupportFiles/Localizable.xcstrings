        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모양을 고르세요. 사진이나 영상에서 모양 안쪽만 보이고, 주변에는 아래 영상이 보여요."
          }
        },
        "nb" : {
          "stringUnit" : {
