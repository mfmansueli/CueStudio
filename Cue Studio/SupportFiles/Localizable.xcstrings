    "Set it up once. Cue remembers how you create." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبطه مرة واحدة. يتذكر Cue طريقتك في الإبداع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal einrichten. Cue merkt sich, wie du arbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configúralo una vez. Cue recuerda cómo creas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réglez une fois. Cue se souvient de votre façon de créer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार सेट करें। Cue याद रखता है कि आप कैसे बनाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur sekali. Cue ingat cara kamu berkarya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configuralo una volta. Cue ricorda come crei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度設定すれば、Cueがあなたの作り方を覚えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번만 설정하세요. Cue가 내 작업 방식을 기억해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure uma vez. O Cue lembra como você cria."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งครั้งเดียว Cue จำวิธีสร้างงานของคุณไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez ayarla. Cue nasıl üretim yaptığını hatırlar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết lập một lần. Cue nhớ cách bạn sáng tạo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置一次，Cue 记住你的创作习惯。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel het één keer in. Cue onthoudt hoe jij maakt."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in det en gång. Cue kommer ihåg hur du skapar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil det én gang. Cue husker, hvordan du skaber."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett det opp én gang. Cue husker hvordan du lager innhold."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定一次就好，Cue 會記住你的創作方式。"
          }
        }
      }
    },
    "Set this script’s language to follow your words. The script scrolls while you talk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّد لغة هذا النص لمتابعة كلماتك. يتحرك النص أثناء حديثك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg die Sprache dieses Skripts fest, damit deinen Wörtern gefolgt wird. Das Skript scrollt, während du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el idioma de este guion para seguir tus palabras. El guion se desplaza mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la langue de ce script pour suivre vos mots. Le script défile pendant que vous parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके शब्दों को फ़ॉलो करने के लिए इस स्क्रिप्ट की भाषा सेट करें। आपके बोलते समय स्क्रिप्ट स्क्रॉल होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atur bahasa naskah ini agar kata-katamu diikuti. Naskah bergulir saat kamu bicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta la lingua di questo copione per seguire le tue parole. Il copione scorre mentre parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言葉に合わせて追従するには、この台本の言語を設定してください。話している間は台本がスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말을 따라가려면 이 대본의 언어를 설정하세요. 말하는 동안 대본이 스크롤돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina o idioma deste roteiro para seguir suas palavras. O roteiro rola enquanto você fala."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งภาษาของสคริปต์นี้เพื่อให้ติดตามคำพูดของคุณ สคริปต์จะเลื่อนขณะที่คุณพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sözlerini takip etmek için bu senaryonun dilini ayarla. Senaryo sen konuşurken kayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt ngôn ngữ cho kịch bản này để theo lời bạn nói. Kịch bản sẽ cuộn khi bạn nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置这个脚本的语言即可跟随你的话语。你说话时脚本会滚动。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel de taal van dit script in om je woorden te volgen. Het script scrolt terwijl je praat."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ställ in det här manusets språk för att följa dina ord. Manuset skrollar medan du pratar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indstil dette manuskripts sprog for at følge dine ord. Manuskriptet ruller, mens du taler."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sett språket for dette manuset for å følge ordene dine. Manuset ruller mens du snakker."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請設定這份腳本的語言，才能跟隨你的字詞。你說話時腳本會捲動。"
          }
        }
      }
    },
