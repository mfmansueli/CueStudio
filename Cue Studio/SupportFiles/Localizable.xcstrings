    "Tap the first word of the part to cut, then its last word. Crossed-out words were cut." : {
      "comment" : "Edit by text hint",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط أول كلمة في الجزء المراد قصّه، ثم آخر كلمة فيه. الكلمات المشطوبة قُصّت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
