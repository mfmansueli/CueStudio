    "The effect makes its own light and shadow. Pick a style without it to use a background or an outline." : {
      "comment" : "Text style › Color note for a text wearing an animated effect",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصنع التأثير ضوءه وظله. اختر نمطًا بدونه لاستخدام خلفية أو حدّ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekten laver sit eget lys og sin egen skygge. Vælg en stil uden den for at bruge baggrund eller kontur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Effekt macht sein eigenes Licht und seinen Schatten. Wähle einen Stil ohne ihn für Hintergrund oder Kontur."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El efecto crea su propia luz y sombra. Elige un estilo sin él para usar fondo o contorno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’effet crée sa propre lumière et son ombre. Choisissez un style sans lui pour un fond ou un contour."
