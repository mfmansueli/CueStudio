    "A great trip doesn’t need a big budget. It needs a plan." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرحلة الرائعة لا تحتاج إلى ميزانية كبيرة، بل إلى خطة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En god rejse kræver ikke et stort budget. Den kræver en plan."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tolle Reise braucht kein großes Budget. Sie braucht einen Plan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un gran viaje no necesita mucho presupuesto. Necesita un plan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un super voyage n’a pas besoin d’un gros budget. Il a besoin d’un plan."
