    "Just start talking… shape it later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بالكلام فقط… ونسّقه لاحقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fang einfach an zu reden … formen kannst du später."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza a hablar… ya le darás forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlez simplement… vous structurerez plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बस बोलना शुरू करें… शेप बाद में करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai bicara saja… bentuk nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia a parlare… lo struttura dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずは話すように書いて… 整形は後で。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일단 말하듯 써 보세요… 정리는 나중에."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece falando… estruture depois."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พูดไปเลย… จัดโครงทีหลัง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşmaya başla… sonra şekillendir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cứ nói đi… định hình sau."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "想到什么说什么… 之后再成型。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begin gewoon te praten… vorm het later."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Börja bara prata… forma det senare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Begynd bare at tale… form det senere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare begynn å snakke… form det senere."
