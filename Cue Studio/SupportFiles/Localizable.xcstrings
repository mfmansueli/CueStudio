    "Your light. It grows with every video you share — no photo needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضوؤك. يكبر مع كل فيديو تشاركه — بلا حاجة إلى صورة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lys. Det vokser med hver video, du deler — intet foto nødvendigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Licht. Es wächst mit jedem Video, das du teilst — ganz ohne Foto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your light. It grows with every video you share — no photo needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu luz. Crece con cada vídeo que compartes — sin necesidad de foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta lumière. Elle grandit à chaque vidéo partagée — pas besoin de photo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी रोशनी। हर वीडियो शेयर करने पर यह बढ़ती है — फ़ोटो की ज़रूरत नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cahayamu. Ia tumbuh dengan setiap video yang kamu bagikan — tanpa perlu foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua luce. Cresce a ogni video che condividi — nessuna foto necessaria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの光。動画を共有するたびに大きくなります。写真は不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만의 빛. 영상을 공유할 때마다 커져요 — 사진은 필요 없어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyset ditt. Det vokser for hver video du deler — ingen bilder nødvendig."
          }
        },
