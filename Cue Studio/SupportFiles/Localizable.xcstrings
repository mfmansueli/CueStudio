    "Your script is ready. Now it needs you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نصّك جاهز. الآن يحتاجك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Skript ist fertig. Jetzt braucht es dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu guion está listo. Ahora te necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton script est prêt. Il a maintenant besoin de toi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी स्क्रिप्ट तैयार है। अब उसे आपकी ज़रूरत है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naskahmu sudah siap. Sekarang butuh kamu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo copione è pronto. Ora ha bisogno di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "台本ができました。次はあなたの番です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대본이 준비됐어요. 이제 당신 차례예요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu roteiro está pronto. Agora ele precisa de você."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สคริปต์พร้อมแล้ว ตอนนี้ต้องการคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senaryon hazır. Şimdi sana ihtiyacı var."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kịch bản đã sẵn sàng. Giờ nó cần bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "脚本准备好了，现在轮到你了。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je script is klaar. Nu heeft het jou nodig."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt manus är klart. Nu behöver det dig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit manuskript er klart. Nu har det brug for dig."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuset ditt er klart. Nå trenger det deg."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的腳本準備好了，現在輪到你了。"
          }
        }
      }
    },
    "Cue listens so the text can follow your voice, and uses the camera so you can see your framing. Everything stays on this iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستمع Cue ليتبع النص صوتك، ويستخدم الكاميرا لترى إطارك. كل شيء يبقى على هذا الـ iPhone."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue hört zu, damit der Text deiner Stimme folgt, und nutzt die Kamera, damit du deinen Bildausschnitt siehst. Alles bleibt auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue escucha para que el texto siga tu voz y usa la cámara para que veas tu encuadre. Todo se queda en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue écoute pour que le texte suive ta voix et utilise la caméra pour que tu voies ton cadrage. Tout reste sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue सुनता है ताकि टेक्स्ट आपकी आवाज़ के साथ चले, और कैमरा इस्तेमाल करता है ताकि आप अपनी फ़्रेमिंग देख सकें। सब कुछ इसी iPhone पर रहता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue mendengarkan agar teks mengikuti suaramu, dan memakai kamera agar kamu bisa melihat framing-mu. Semuanya tetap di iPhone ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ascolta perché il testo segua la tua voce e usa la fotocamera per farti vedere l’inquadratura. Tutto resta su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueは声を聞いてテキストを合わせ、カメラで構図を確認できるようにします。すべてこのiPhoneの中にとどまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 텍스트가 당신의 목소리를 따라가도록 듣고, 화면 구도를 볼 수 있도록 카메라를 사용해요. 모든 것은 이 iPhone에 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue escuta para o texto seguir a sua voz e usa a câmera para você ver o seu enquadramento. Tudo fica neste iPhone."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ฟังเสียงเพื่อให้ข้อความตามเสียงคุณ และใช้กล้องเพื่อให้คุณเห็นเฟรมภาพ ทุกอย่างอยู่บน iPhone เครื่องนี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue, metnin sesini takip etmesi için dinler ve kadrajını görebilmen için kamerayı kullanır. Her şey bu iPhone’da kalır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lắng nghe để văn bản theo giọng bạn và dùng camera để bạn thấy khung hình. Mọi thứ vẫn ở trên iPhone này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会聆听，让文字跟随你的声音；也会使用相机，让你看到取景。一切都留在这部 iPhone 上。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue luistert zodat de tekst je stem kan volgen, en gebruikt de camera zodat je je kadrering ziet. Alles blijft op deze iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lyssnar så att texten kan följa din röst och använder kameran så att du ser din bildruta. Allt stannar på den här iPhonen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lytter, så teksten kan følge din stemme, og bruger kameraet, så du kan se din billedramme. Alt bliver på denne iPhone."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lytter slik at teksten kan følge stemmen din, og bruker kameraet slik at du kan se bildeutsnittet ditt. Alt blir på denne iPhonen."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 需要聆聽，文字才能跟隨你的聲音；也需要使用相機，你才能看到自己的構圖。一切都保留在這部 iPhone 上。"
          }
        }
      }
    },
