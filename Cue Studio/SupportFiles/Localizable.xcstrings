    "Cut removes the words from the video. Fix caption text only changes what the caption says." : {
      "comment" : "Edit by text explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القص يزيل الكلمات من الفيديو. أما «تصحيح نص الترجمة» فيغيّر ما تقوله الترجمة النصية فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip fjerner ordene fra videoen. Ret undertekst ændrer kun, hvad underteksten siger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneiden entfernt die Wörter aus dem Video. Untertitel korrigieren ändert nur, was der Untertitel sagt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortar quita las palabras del video. Corregir subtítulo solo cambia lo que dice el subtítulo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couper retire les mots de la vidéo. Corriger le sous-titre ne change que ce qu’il affiche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काटने से शब्द वीडियो से हट जाते हैं। कैप्शन ठीक करने से सिर्फ़ कैप्शन का टेक्स्ट बदलता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potong menghapus kata dari video. Perbaiki teks hanya mengubah isi teks."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taglia toglie le parole dal video. Correggi sottotitolo cambia solo il testo del sottotitolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カットは動画から言葉を取り除きます。「字幕を修正」は字幕の文字だけを変えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잘라내기는 영상에서 단어를 없애요. 자막 수정은 자막 내용만 바꿔요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipp fjerner ordene fra videoen. Rett underteksten endrer bare hva underteksten sier."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knippen haalt de woorden uit de video. Ondertitel corrigeren verandert alleen wat de ondertitel zegt."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cortar tira as palavras do vídeo. Corrigir legenda só muda o que a legenda diz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipp tar bort orden ur videon. Rätta undertext ändrar bara vad undertexten säger."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตัดจะลบคำออกจากวิดีโอ ส่วนแก้ข้อความคำบรรยายจะเปลี่ยนแค่สิ่งที่คำบรรยายแสดง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kes, kelimeleri videodan çıkarır. Altyazıyı düzelt yalnızca altyazının yazdığını değiştirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cắt sẽ bỏ các từ khỏi video. Sửa phụ đề chỉ đổi nội dung phụ đề."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
