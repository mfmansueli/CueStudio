    "Before and After compare right after the run; Undo still takes it all back." : {
      "comment" : "Auto edit: why Before/After is off (something changed since the run)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المقارنة قبل/بعد تعمل مباشرة بعد التشغيل؛ و«تراجع» ما زال يعيد كل شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før og Efter sammenligner lige efter kørslen; Fortryd tager stadig det hele tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorher und Nachher vergleichen direkt nach dem Durchgang; Widerrufen nimmt weiter alles zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes y Después comparan justo tras la pasada; Deshacer sigue revirtiéndolo todo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant et Après comparent juste après le passage ; Annuler revient toujours sur tout."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले और बाद की तुलना ठीक चलने के बाद होती है; पूर्ववत करें अब भी सब वापस लेता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum dan Sesudah membandingkan tepat setelah dijalankan; Urungkan tetap mengembalikan semuanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima e Dopo confrontano subito dopo la passata; Annulla riporta ancora tutto indietro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前後の比較は実行直後だけできます。取り消せば今もすべて元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전/후 비교는 실행 직후에만 돼요. 실행 취소하면 여전히 모두 되돌아가요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før og Etter sammenligner rett etter kjøringen; Angre tar fortsatt alt tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor en Na vergelijken direct na de ronde; Ongedaan maken draait nog steeds alles terug."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes e Depois comparam logo após a passada; Desfazer ainda volta tudo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Före och Efter jämför direkt efter omgången; Ångra tar fortfarande tillbaka allt."
