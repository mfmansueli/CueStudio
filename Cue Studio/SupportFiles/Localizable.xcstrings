    "It’s one of the most common gym questions. Let’s settle it." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنه من أكثر أسئلة النادي شيوعًا. لنحسم الأمر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
