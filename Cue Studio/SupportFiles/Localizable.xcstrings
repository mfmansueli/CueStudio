    "Translated on your iPhone with Apple Translation. Nothing is sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُترجم على iPhone باستخدام ترجمة Apple. لا يُرسل أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem iPhone mit Apple Übersetzen übersetzt. Nichts wird gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traducido en tu iPhone con Traducir de Apple. No se envía nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduit sur votre iPhone avec Traduire d’Apple. Rien n’est envoyé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Translation से आपके iPhone पर अनुवाद होता है। कुछ भी कहीं नहीं भेजा जाता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diterjemahkan di iPhone-mu dengan Apple Translation. Tidak ada yang dikirim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tradotto sul tuo iPhone con Traduci di Apple. Non viene inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AppleのTranslationでiPhone上で翻訳。どこにも送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 번역으로 iPhone에서 번역합니다. 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traduzido no seu iPhone com o Tradutor da Apple. Nada é enviado."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แปลบน iPhone ของคุณด้วยการแปลของ Apple ไม่มีการส่งข้อมูลไปที่ใด"
