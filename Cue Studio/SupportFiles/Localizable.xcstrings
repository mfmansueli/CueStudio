        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berätta var ett familjerecept kommer ifrån medan du lagar det."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เล่าที่มาของสูตรอาหารประจำครอบครัวระหว่างทำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir aile tarifinin nereden geldiğini pişirirken anlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kể nguồn gốc một công thức gia đình trong lúc nấu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
