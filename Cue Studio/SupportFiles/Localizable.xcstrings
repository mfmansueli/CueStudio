            "state" : "translated",
            "value" : "Denne enhed skal køle ned. Kameraet kommer tilbage om et øjeblik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät muss abkühlen. Die Kamera ist gleich wieder da."
