    "Every answer, example and what Cue learned is deleted. Your themes stay." : {
      "comment" : "Message of the confirmation before clearing My Cue Voice",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحذف كل إجابة ومثال وكل ما تعلّمه Cue. تبقى موضوعاتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle svar, eksempler og det, Cue har lært, slettes. Dine temaer bliver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Antworten, Beispiele und alles, was Cue gelernt hat, werden gelöscht. Deine Themen bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borran todas las respuestas, los ejemplos y lo que Cue aprendió. Tus temas se quedan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les réponses, les exemples et ce que Cue a appris sont supprimés. Vos thèmes restent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर जवाब, उदाहरण और Cue ने जो सीखा, सब मिट जाएगा। आपके विषय बने रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semua jawaban, contoh, dan yang dipelajari Cue dihapus. Temamu tetap ada."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni risposta, esempio e ciò che Cue ha imparato viene eliminato. I tuoi temi restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての回答、例、Cue が学んだことが削除されます。テーマは残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 답변, 예시, Cue가 배운 내용이 삭제돼요. 주제는 그대로 남아요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle svar, eksempler og det Cue har lært, slettes. Temaene dine blir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle antwoorden, voorbeelden en wat Cue heeft geleerd worden gewist. Je thema's blijven."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as respostas, exemplos e o que o Cue aprendeu são apagados. Seus temas ficam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla svar, exempel och det Cue har lärt sig raderas. Dina teman finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำตอบ ตัวอย่าง และสิ่งที่ Cue เรียนรู้ทั้งหมดจะถูกลบ หัวข้อของคุณยังอยู่"
