    "Add anything true about you that the questions don’t ask." : {
      "comment" : "My Cue Voice › Also true about me: what to do here",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أي شيء صحيح عنك لا تسأل عنه الأسئلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj alt, der er sandt om dig, som spørgsmålene ikke spørger om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge alles hinzu, was über dich stimmt und wonach die Fragen nicht fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade cualquier cosa cierta sobre ti que las preguntas no piden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez tout ce qui est vrai à votre sujet et que les questions ne demandent pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने बारे में कोई भी सच जोड़ें जो सवालों में नहीं पूछा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan hal benar apa pun tentang dirimu yang tidak ditanyakan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi qualsiasi cosa vera su di te che le domande non chiedono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "質問にないことで、あなたについて本当のことを追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "질문에 없는 나에 대한 사실을 추가하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til alt som er sant om deg som spørsmålene ikke spør om."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg alles toe wat waar is over jou en waar de vragen niet naar vragen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione o que for verdade sobre você e as perguntas não pedem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till allt som är sant om dig som frågorna inte frågar om."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มเรื่องจริงเกี่ยวกับคุณที่คำถามไม่ได้ถาม"
          }
        },
        "tr" : {
          "stringUnit" : {
