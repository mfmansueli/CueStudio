    "The text follows your voice. Nothing is recorded." : {
      "comment" : "First voyage practice tip, when the script's length isn't known",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النص يتبع صوتك. لا يُسجَّل شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten følger din stemme. Intet optages."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Text folgt deiner Stimme. Nichts wird aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto sigue tu voz. Nada se graba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte suit votre voix. Rien n’est filmé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टेक्स्ट आपकी आवाज़ के साथ चलता है। कुछ रिकॉर्ड नहीं होता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teks mengikuti suaramu. Tidak ada yang direkam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il testo segue la tua voce. Nulla viene registrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字が声に合わせて進みます。録画はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "글이 목소리를 따라와요. 녹화는 안 해요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teksten følger stemmen din. Ingenting tas opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tekst volgt je stem. Er wordt niets opgenomen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O texto segue a sua voz. Nada é gravado."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texten följer din röst. Inget spelas in."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความเลื่อนตามเสียงคุณ ไม่มีการอัด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin sesini takip eder. Kayıt yapılmaz."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chữ chạy theo giọng bạn. Không quay gì cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字跟着你的声音走。不录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字跟著你的聲音走。不錄影。"
          }
        }
      }
    },
