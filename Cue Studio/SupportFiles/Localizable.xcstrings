    "Got an idea? Say it or type it — Cue writes the script." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لديك فكرة؟ قلها أو اكتبها — وCue يكتب النص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Idee? Sprich sie oder tipp sie ein — Cue schreibt das Skript."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes una idea? Dila o escríbela: Cue escribe el guion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une idée ? Dites-la ou écrivez-la — Cue écrit le script."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई आइडिया है? बोलें या लिखें — Cue स्क्रिप्ट लिखेगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punya ide? Ucapkan atau ketik — Cue menulis naskahnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un’idea? Dilla o scrivila: Cue scrive il copione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイデアは？ 話すか入力すれば、Cueが台本を書きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아이디어가 있나요? 말하거나 입력하면 Cue가 대본을 써요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tem uma ideia? Fale ou digite — o Cue escreve o roteiro."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีไอเดียไหม? พูดหรือพิมพ์ แล้ว Cue จะเขียนสคริปต์ให้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir fikrin mi var? Söyle ya da yaz — Cue senaryoyu yazar."
