        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई प्लेटफ़ॉर्म किसी वीडियो के लिए दूसरी सेटिंग सुझा सकता है — चुनाव आपका है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platform bisa menyarankan setelan lain untuk video — kamu yang memilih."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una piattaforma può consigliare altro per un video — scegli tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラットフォームが動画に別の設定をすすめることがあります — 選ぶのはあなたです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "플랫폼이 동영상에 다른 설정을 추천할 수 있어요 — 선택은 직접 하세요."
