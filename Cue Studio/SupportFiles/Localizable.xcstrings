        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk videonu paylaş, burada gittiği platforma bağlı bir yıldız olsun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chia sẻ video đầu tiên và nó thành một ngôi sao ở đây, nối với nền tảng nó đã đến."
