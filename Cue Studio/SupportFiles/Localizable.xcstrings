    "Compare two common options and say who each one is for." : {
      "comment" : "Find inspiration: the angle of a starter made from the creator's own topic (an instruction to the creator)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن بين خيارين شائعين وقل لمن يناسب كل منهما."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign to almindelige muligheder, og sig, hvem hver af dem passer til."
