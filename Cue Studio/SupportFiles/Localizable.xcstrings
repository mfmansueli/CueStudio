    "Explain why small, flexible habits beat strict schedules." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرح لماذا تتفوق العادات الصغيرة المرنة على الجداول الصارمة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forklar, hvorfor små, fleksible vaner slår stramme skemaer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erklär, warum kleine, flexible Gewohnheiten strenge Zeitpläne schlagen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica por qué los hábitos pequeños y flexibles ganan a los horarios estrictos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expliquez pourquoi de petites habitudes souples battent les plannings stricts."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समझाएँ कि छोटी, लचीली आदतें सख़्त शेड्यूल से बेहतर क्यों हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan kenapa kebiasaan kecil yang fleksibel lebih ampuh dari jadwal ketat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiega perché piccole abitudini flessibili battono gli orari rigidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "小さく柔軟な習慣が厳しいスケジュールに勝つ理由を説明する。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작고 유연한 습관이 빡빡한 일정보다 나은 이유를 설명하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forklar hvorfor små, fleksible vaner slår strenge timeplaner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg uit waarom kleine, flexibele gewoontes strakke schema’s verslaan."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explique por que hábitos pequenos e flexíveis vencem agendas rígidas."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förklara varför små, flexibla vanor slår strikta scheman."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบายว่าทำไมนิสัยเล็ก ๆ ที่ยืดหยุ่นถึงดีกว่าตารางเวลาที่เข้มงวด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Küçük, esnek alışkanlıkların katı programlardan neden daha iyi olduğunu anlat."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giải thích vì sao thói quen nhỏ, linh hoạt hiệu quả hơn lịch trình cứng nhắc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解释为什么小而灵活的习惯胜过严格的时间表。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解釋為什麼小而靈活的習慣勝過嚴格的時間表。"
          }
        }
      }
    },
    "Explain the order of the steps and why it matters." : {
      "comment" : "Find inspiration: a starter idea's angle, a short instruction to the creator",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرح ترتيب الخطوات ولماذا هو مهم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forklar rækkefølgen af trinene, og hvorfor den betyder noget."
