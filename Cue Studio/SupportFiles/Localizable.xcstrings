        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mulai tulis yang ingin kamu katakan… Ketuk [ ] untuk menambah aba-aba."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi quello che vuoi dire… Tocca [ ] per aggiungere indicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話したいことを書いてください… [ ] をタップして合図を追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하고 싶은 말을 적어 보세요… [ ]를 탭해 신호를 추가할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece a escrever o que quer dizer… Toque em [ ] para adicionar marcações."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เริ่มเขียนสิ่งที่อยากพูด… แตะ [ ] เพื่อเพิ่มคิว"
