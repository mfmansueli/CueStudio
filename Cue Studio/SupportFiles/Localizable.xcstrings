        }
      }
    },
    "Before you add these to your cart, hear me out." : {
      "comment" : "Find inspiration: a starter idea's opening line, a first sentence the creator could say to camera",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن تضيف هذه إلى سلتك، اسمعني أولًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du lægger dem i kurven, så hør lige her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du das in den Warenkorb legst, hör mir kurz zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de añadir esto al carrito, escúchame."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de mettre ça dans votre panier, écoutez-moi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें कार्ट में डालने से पहले, मेरी बात सुन लें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum kamu masukkan ini ke keranjang, dengar dulu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di metterli nel carrello, ascoltami."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カートに入れる前に、ちょっと聞いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "장바구니에 담기 전에, 제 얘기 좀 들어 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du legger disse i handlekurven, hør hva jeg har å si."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
