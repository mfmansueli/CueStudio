    "State the myth in one line, say why people believe it, then give the fact. Keep to one belief per video." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اذكر الخرافة في سطر واحد، ثم سبب تصديق الناس لها، ثم الحقيقة. معتقد واحد فقط في كل فيديو."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig myten i én linje, forklar hvorfor folk tror på den, og giv så fakta. Kun én overbevisning pr. video."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenne den Mythos in einer Zeile, sag, warum man ihn glaubt, und gib dann den Fakt. Ein Irrglaube pro Video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di el mito en una línea, explica por qué se cree y da la realidad. Una creencia por vídeo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Énoncez le mythe en une ligne, dites pourquoi on y croit, puis donnez la réalité. Une idée reçue par vidéo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मिथक एक पंक्ति में बताएँ, कहें कि लोग क्यों मानते हैं, फिर सच बताएँ। हर वीडियो में एक ही धारणा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebut mitosnya dalam satu kalimat, jelaskan kenapa orang memercayainya, lalu beri faktanya. Satu anggapan per video."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enuncia il mito in una riga, di’ perché ci si crede e poi dai il fatto. Una credenza per video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "俗説を一言で述べ、なぜ信じられているかを話し、事実を伝えます。1本につき1つの思い込みに絞ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통념을 한 줄로 말하고, 왜 믿는지 설명한 뒤, 사실을 알려 주세요. 영상 하나에 통념 하나만."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si myten på én linje, forklar hvorfor folk tror på den, og gi så fakta. Én oppfatning per video."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noem de mythe in één regel, zeg waarom mensen het geloven en geef dan het feit. Eén overtuiging per video."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga o mito em uma linha, explique por que as pessoas acreditam e depois dê o fato. Uma crença por vídeo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg myten på en rad, förklara varför folk tror på den och ge sedan fakta. En myt per video."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกความเชื่อผิดๆ ในหนึ่งบรรทัด บอกว่าทำไมคนถึงเชื่อ แล้วค่อยบอกข้อเท็จจริง หนึ่งคลิปต่อหนึ่งความเชื่อ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efsaneyi tek cümleyle söyle, insanların neden inandığını anlat, sonra gerçeği ver. Her videoda tek bir inanç."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nêu lầm tưởng trong một câu, nói vì sao nhiều người tin, rồi đưa ra sự thật. Mỗi video chỉ một quan niệm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一句话说出误区，讲清人们为什么信，再给出事实。一条视频只讲一个误区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一句話說出迷思，講清人們為什麼相信，再給出事實。一支影片只講一個迷思。"
          }
        }
      }
    },
    "State the opinion in one line, give one reason, end with a question — questions drive comments." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اذكر رأيك في جملة، وأعطِ سببًا واحدًا، واختم بسؤال — الأسئلة تجلب التعليقات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sig din mening i én linje, giv én grund, og slut med et spørgsmål — spørgsmål giver kommentarer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag deine Meinung in einem Satz, nenn einen Grund und ende mit einer Frage – Fragen bringen Kommentare."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di tu opinión en una frase, da un motivo y termina con una pregunta — las preguntas generan comentarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donnez votre avis en une phrase, une raison, et finissez par une question — les questions font réagir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक लाइन में राय बताएँ, एक वजह दें, सवाल से ख़त्म करें — सवालों से कमेंट आते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sampaikan opini dalam satu kalimat, beri satu alasan, tutup dengan pertanyaan — pertanyaan memancing komentar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esprimi l’opinione in una frase, dai un motivo e chiudi con una domanda — le domande portano commenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意見をひとことで、理由をひとつ、最後に問いかけを — 問いかけがコメントを生みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의견을 한 줄로, 이유를 하나, 마지막엔 질문을 — 질문이 댓글을 불러요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si meningen din på én linje, gi én grunn og avslutt med et spørsmål — spørsmål gir kommentarer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg je mening in één zin, geef één reden, sluit af met een vraag — vragen leiden tot reacties."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga a opinião numa frase, dê um motivo e termine com uma pergunta — perguntas geram comentários."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säg åsikten på en rad, ge ett skäl och avsluta med en fråga — frågor ger kommentarer."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกความเห็นในประโยคเดียว ให้เหตุผลหนึ่งข้อ แล้วปิดด้วยคำถาม — คำถามทำให้คนคอมเมนต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görüşünü tek cümleyle söyle, bir neden ver, bir soruyla bitir — sorular yorum getirir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nêu quan điểm trong một câu, đưa một lý do, kết bằng một câu hỏi — câu hỏi kéo bình luận."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一句话说观点，给一个理由，用问题收尾 — 问题能带来评论。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用一句話說出你的觀點，給一個理由，最後以問題收尾 — 問題會帶來留言。"
          }
        }
      }
    },
