    "Okay, I have to tell you about %@. [pause]" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسنًا، يجب أن أخبرك عن %@. [توقف]"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okay, ich muss euch von %@ erzählen. [Pause]"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale, tengo que hablarte de %@. [pausa]"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon, il faut que je vous parle de %@. [pause]"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुनिए, मुझे आपको %@ के बारे में बताना ही है। [रुकें]"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oke, aku harus cerita soal %@. [jeda]"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ok, devo parlarvi di %@. [pausa]"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@について、どうしても話したい。[間]"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 얘기는 꼭 해야겠어요. [멈춤]"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gente, preciso contar sobre %@. [pausa]"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โอเค ต้องเล่าเรื่อง %@ ให้ฟัง [หยุด]"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamam, sana %@ hakkında bir şey anlatmam lazım. [durakla]"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Được rồi, mình phải kể cho bạn về %@. [dừng]"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我必须跟你们说说%@。[停顿]"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oké, ik moet het even over %@ hebben. [pauze]"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okej, jag måste berätta om %@. [paus]"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okay, jeg er nødt til at fortælle dig om %@. [pause]"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okay, jeg må fortelle deg om %@. [pause]"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好，我一定要跟你聊聊%@。[停頓]"
          }
        }
      }
