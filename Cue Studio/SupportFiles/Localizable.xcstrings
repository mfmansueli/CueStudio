    "Voice Following can’t listen in %@ on this iPhone. The script scrolls while you talk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع تتبّع الصوت الاستماع باللغة %@ على هذا الـ iPhone. يتحرك النص أثناء حديثك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachfolge kann auf diesem iPhone nicht auf %@ hören. Das Skript scrollt, während du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento de voz no puede escuchar en %@ en este iPhone. El guion se desplaza mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi vocal ne peut pas écouter en %@ sur cet iPhone. Le script défile pendant que vous parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस iPhone पर आवाज़ ट्रैकिंग %@ में नहीं सुन सकती। आपके बोलते समय स्क्रिप्ट स्क्रॉल होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti Suara tidak bisa mendengarkan bahasa %@ di iPhone ini. Naskah bergulir saat kamu bicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui voce non può ascoltare in %@ su questo iPhone. Il copione scorre mentre parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このiPhoneの音声追従は%@を聞き取れません。話している間は台本がスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 iPhone의 음성 따라가기는 %@을(를) 들을 수 없어요. 말하는 동안 대본이 스크롤돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir voz não consegue ouvir em %@ neste iPhone. O roteiro rola enquanto você fala."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การติดตามเสียงฟังภาษา%@ใน iPhone เครื่องนี้ไม่ได้ สคริปต์จะเลื่อนขณะที่คุณพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Takibi bu iPhone'da %@ dinleyemiyor. Senaryo sen konuşurken kayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo giọng nói không thể nghe tiếng %@ trên iPhone này. Kịch bản sẽ cuộn khi bạn nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 iPhone 上的语音跟随无法识别%@。你说话时脚本会滚动。"
          }
        }
      }
    },
    "Voice Following couldn’t start listening. The script scrolls while you talk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على تتبّع الصوت بدء الاستماع. يتحرك النص أثناء حديثك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachfolge konnte nicht anfangen zuzuhören. Das Skript scrollt, während du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento de voz no pudo empezar a escuchar. El guion se desplaza mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi vocal n’a pas pu commencer à écouter. Le script défile pendant que vous parlez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ ट्रैकिंग सुनना शुरू नहीं कर सकी। आपके बोलते समय स्क्रिप्ट स्क्रॉल होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti Suara tidak bisa mulai mendengarkan. Naskah bergulir saat kamu bicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui voce non è riuscito ad avviare l’ascolto. Il copione scorre mentre parli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声追従で聞き取りを開始できませんでした。話している間は台本がスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 따라가기가 듣기를 시작하지 못했어요. 말하는 동안 대본이 스크롤돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir voz não conseguiu começar a ouvir. O roteiro rola enquanto você fala."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การติดตามเสียงเริ่มฟังไม่ได้ สคริปต์จะเลื่อนขณะที่คุณพูด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Takibi dinlemeye başlayamadı. Senaryo sen konuşurken kayar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo giọng nói không thể bắt đầu nghe. Kịch bản sẽ cuộn khi bạn nói."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音跟随无法开始聆听。你说话时脚本会滚动。"
          }
        }
      }
    },
    "Voice Following needs to download %@. Connect to the internet and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج تتبّع الصوت إلى تنزيل اللغة %@. اتصل بالإنترنت وحاول مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprachfolge muss %@ laden. Verbinde dich mit dem Internet und versuch es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento de voz necesita descargar %@. Conéctate a internet y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi vocal doit télécharger %@. Connectez-vous à Internet et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आवाज़ ट्रैकिंग को %@ डाउनलोड करनी होगी। इंटरनेट से कनेक्ट करें और फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikuti Suara perlu mengunduh bahasa %@. Sambungkan ke internet dan coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segui voce deve scaricare %@. Collegati a internet e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声追従には%@のダウンロードが必要です。インターネットに接続してもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성 따라가기에 %@ 다운로드가 필요해요. 인터넷에 연결하고 다시 시도하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguir voz precisa baixar %@. Conecte-se à internet e tente de novo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การติดตามเสียงต้องดาวน์โหลดภาษา%@ เชื่อมต่ออินเทอร์เน็ตแล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses Takibi için %@ indirilmeli. İnternete bağlanıp yeniden dene."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo giọng nói cần tải tiếng %@. Hãy kết nối internet và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "语音跟随需要下载%@。请连接互联网后重试。"
          }
        }
      }
    },
    "Voice Following needs to download this language. Connect to the internet and try again." : {
