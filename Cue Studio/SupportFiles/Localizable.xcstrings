    "Their font hadn’t downloaded. Export again when you’re online." : {
      "comment" : "Ready to travel, under \"Some words use the system font\": the font of another script hadn't arrived in time; exporting again once online fixes it.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل تنزيل خطها. صدّر مرة أخرى عند الاتصال بالإنترنت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deres skrifttype var ikke downloadet. Eksportér igen, når du er online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Schrift war noch nicht geladen. Exportiere erneut, wenn du online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su fuente no se había descargado. Exporta de nuevo cuando tengas conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur police n’était pas téléchargée. Exporte à nouveau une fois en ligne."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उनका फ़ॉन्ट डाउनलोड नहीं हुआ था। ऑनलाइन होने पर फिर से एक्सपोर्ट करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Font-nya belum terunduh. Ekspor lagi saat kamu online."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il loro font non era ancora scaricato. Esporta di nuovo quando sei online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォントのダウンロードが終わっていませんでした。オンラインのときにもう一度書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서체가 아직 다운로드되지 않았어요. 온라인일 때 다시 내보내세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifttypen var ikke lastet ned. Eksporter på nytt når du er på nett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hun lettertype was nog niet gedownload. Exporteer opnieuw als je online bent."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fonte delas não tinha baixado. Exporte de novo quando estiver online."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deras teckensnitt hade inte hämtats. Exportera igen när du är online."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟอนต์ของคำเหล่านี้ยังดาวน์โหลดไม่เสร็จ ส่งออกอีกครั้งเมื่อออนไลน์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazı tipleri inmemişti. Çevrimiçiyken yeniden dışa aktar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phông chữ của chúng chưa tải xong. Hãy xuất lại khi có mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们的字体还没下载好。联网后再导出一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它們的字體還沒下載好。連上網路後再匯出一次。"
          }
        }
      }
    },
