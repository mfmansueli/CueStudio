    "Pick a shape: only the part of the photo or video inside it shows, with the video under it around it." : {
      "comment" : "Mask panel, before a shape is picked",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر شكلًا: يظهر فقط جزء الصورة أو الفيديو الذي داخله، ويحيط به الفيديو الذي تحته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en form: kun den del af fotoet eller videoen, der er inden for, vises, med videoen nedenunder rundt om."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle eine Form: Nur der Teil des Fotos oder Videos darin ist zu sehen, rundherum das Video darunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una forma: solo se ve la parte de la foto o del video que queda dentro, con el video de abajo alrededor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
