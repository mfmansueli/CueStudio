    "Notifications are off for Cue in iOS Settings. The reminder is kept here in Cue." : {
      "comment" : "Reminder sheet note when denied",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات Cue متوقفة في إعدادات iOS. يُحفظ التذكير هنا في Cue."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra for Cue i iOS-indstillinger. Påmindelsen gemmes her i Cue."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen für Cue sind in den iOS-Einstellungen aus. Die Erinnerung bleibt hier in Cue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de Cue están desactivadas en Ajustes de iOS. El recordatorio se guarda aquí, en Cue."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications de Cue sont désactivées dans Réglages iOS. Le rappel est conservé ici, dans Cue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS सेटिंग्ज़ में Cue की सूचनाएँ बंद हैं। रिमाइंडर यहीं Cue में रखा जाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikasi Cue nonaktif di Pengaturan iOS. Pengingat tetap disimpan di sini, di Cue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche di Cue sono disattivate in Impostazioni di iOS. Il promemoria resta qui in Cue."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSの設定でCueの通知がオフになっています。リマインダーはCueの中に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 Cue 알림이 꺼져 있어요. 리마인더는 Cue 안에 보관돼요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler er av for Cue i Innstillinger. Påminnelsen lagres her i Cue."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen voor Cue staan uit in iOS-instellingen. De herinnering blijft hier in Cue bewaard."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações do Cue estão desligadas nos Ajustes do iOS. O lembrete fica guardado aqui no Cue."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda för Cue i Inställningar. Påminnelsen sparas här i Cue."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การแจ้งเตือนของ Cue ปิดอยู่ในการตั้งค่า iOS การเตือนจะเก็บไว้ใน Cue"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
