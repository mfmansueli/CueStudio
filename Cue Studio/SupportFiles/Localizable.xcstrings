        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने एडिट पर नैरेशन करें। रिकॉर्ड करने से पहले Cue समझाता है।"
          }
        },
        "id" : {
          "stringUnit" : {
