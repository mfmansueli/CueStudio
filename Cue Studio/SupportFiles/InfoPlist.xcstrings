    "NSCameraUsageDescription" : {
      "comment" : "Privacy description shown in the system permission prompt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Cue لقطاتك بالكاميرا بينما يتحرك النص أسفل العدسة مباشرة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue optager dine optagelser med kameraet, mens dit manuskript ruller under linsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nimmt deine Takes mit der Kamera auf, während dein Skript unter dem Objektiv läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cue records your takes with the camera while your script scrolls under the lens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue graba tus tomas con la cámara mientras tu guion se desplaza bajo el objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue enregistre vos prises avec la caméra pendant que votre script défile sous l’objectif."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue कैमरे से आपके टेक रिकॉर्ड करता है, जबकि आपकी स्क्रिप्ट लेंस के ठीक नीचे स्क्रॉल होती है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue merekam take kamu dengan kamera sementara naskah bergulir tepat di bawah lensa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue registra le tue riprese con la fotocamera mentre il copione scorre sotto l’obiettivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueはカメラでテイクを録画し、そのあいだ台本をレンズのすぐ下でスクロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 대본이 렌즈 바로 아래에서 스크롤되는 동안 카메라로 테이크를 녹화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue tar opp opptakene dine med kameraet mens manuset ditt ruller under linsen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue neemt je opnames op met de camera terwijl je script onder de lens scrolt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue grava seus takes com a câmera enquanto o roteiro rola logo abaixo da lente."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue spelar in dina tagningar med kameran medan ditt manus skrollar under linsen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue อัดเทคของคุณด้วยกล้อง ขณะที่สคริปต์เลื่อนอยู่ใต้เลนส์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue, metin objektifin hemen altında kayarken çekimlerini kamerayla kaydeder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue quay các bản quay của bạn bằng camera trong khi kịch bản cuộn ngay dưới ống kính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会用相机录制你的镜头，同时让脚本在镜头下方滚动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 會使用相機錄製你的鏡頭，同時讓腳本在鏡頭下方捲動。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy description shown in the system permission prompt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصل Cue بجهاز iPhone أو iPad آخر لديك قريب منك، ليتحكم أحدهما في الملقّن على الآخر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue opretter forbindelse til din anden iPhone eller iPad i nærheden, så den ene kan styre teleprompteren på den anden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue verbindet sich mit deinem anderen iPhone oder iPad in der Nähe, damit eines den Teleprompter auf dem anderen steuern kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cue connects to your other iPhone or iPad nearby, so one can control the teleprompter on the other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue se conecta a tu otro iPhone o iPad cercano para que uno controle el teleprompter del otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue se connecte à votre autre iPhone ou iPad à proximité, pour que l’un contrôle le téléprompteur de l’autre."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue पास के आपके दूसरे iPhone या iPad से जुड़ता है, ताकि एक डिवाइस दूसरे के टेलीप्रॉम्प्टर को कंट्रोल कर सके।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue terhubung ke iPhone atau iPad lain milikmu di dekat sini, sehingga satu perangkat bisa mengendalikan teleprompter di perangkat lainnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue si collega al tuo altro iPhone o iPad nelle vicinanze, così uno può controllare il teleprompter dell’altro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueは近くにあるもう1台のiPhoneやiPadと接続し、一方からもう一方のプロンプターを操作できるようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 근처의 다른 iPhone 또는 iPad와 연결되어 한 기기로 다른 기기의 프롬프터를 조작할 수 있게 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kobler til den andre iPhonen eller iPaden din i nærheten, slik at den ene kan styre teleprompteren på den andre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue maakt verbinding met je andere iPhone of iPad in de buurt, zodat je de teleprompter op het ene apparaat met het andere kunt bedienen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue se conecta ao seu outro iPhone ou iPad por perto, para que um controle o teleprompter do outro."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ansluter till din andra iPhone eller iPad i närheten, så att den ena kan styra teleprompter på den andra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue เชื่อมต่อกับ iPhone หรือ iPad อีกเครื่องของคุณที่อยู่ใกล้ๆ เพื่อให้เครื่องหนึ่งควบคุมเทเลพรอมป์เตอร์ของอีกเครื่องได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue yakındaki diğer iPhone veya iPad'ine bağlanır, böylece biri diğerindeki teleprompter'ı kontrol edebilir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue kết nối với iPhone hoặc iPad khác của bạn ở gần, để một thiết bị điều khiển máy nhắc chữ trên thiết bị kia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会连接你附近的另一台 iPhone 或 iPad，让一台设备控制另一台上的提词器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 會連線到附近你的另一部 iPhone 或 iPad，讓其中一部能控制另一部上的提詞機。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy description shown in the system permission prompt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل Cue صوتك في كل لقطة وفي التعليق الصوتي، ويمكنه تتبّع صوتك لتمرير النص، ويستمع إليك حين تُملي فكرة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue optager din stemme i hver optagelse og til voiceovers, kan følge din stemme for at rulle manuskriptet og lytter, når du dikterer en idé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue nimmt deine Stimme bei jedem Take und für Voice-overs auf, kann deiner Stimme folgen, um das Skript laufen zu lassen, und hört zu, wenn du eine Idee diktierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cue records your voice with each take and for voice-overs, can follow your voice to scroll the script, and listens when you dictate an idea."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue graba tu voz en cada toma y en las voces en off, puede seguir tu voz para desplazar el guion y te escucha cuando dictas una idea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue enregistre votre voix à chaque prise et pour les voix off, peut suivre votre voix pour faire défiler le script et vous écoute lorsque vous dictez une idée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue हर टेक और वॉइस-ओवर के लिए आपकी आवाज़ रिकॉर्ड करता है, स्क्रिप्ट स्क्रॉल करने के लिए आपकी आवाज़ को फ़ॉलो कर सकता है, और जब आप कोई आइडिया बोलकर लिखवाते हैं तब सुनता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue merekam suaramu di setiap take dan untuk sulih suara, bisa mengikuti suaramu untuk menggulir naskah, dan mendengarkan saat kamu mendiktekan ide."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue registra la tua voce in ogni ripresa e per le voci fuori campo, può seguire la tua voce per far scorrere il copione e ti ascolta quando detti un’idea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueはテイクごとの声やボイスオーバーを録音し、声に合わせて台本をスクロールでき、アイデアを音声入力するときにも声を聞き取ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 테이크마다 목소리를 녹음하고 보이스오버도 녹음하며, 목소리에 맞춰 대본을 스크롤할 수 있고, 아이디어를 음성으로 입력할 때 소리를 듣습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue tar opp stemmen din i hvert opptak og til voiceovers, kan følge stemmen din for å rulle manuset og lytter når du dikterer en idé."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue neemt je stem op bij elke opname en voor voice-overs, kan je stem volgen om het script te scrollen en luistert mee wanneer je een idee dicteert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue grava sua voz em cada take e nas narrações, pode seguir sua voz para rolar o roteiro e ouve você quando dita uma ideia."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue spelar in din röst i varje tagning och för voiceovers, kan följa din röst för att skrolla manuset och lyssnar när du dikterar en idé."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue อัดเสียงของคุณในทุกเทคและสำหรับเสียงบรรยาย ติดตามเสียงของคุณเพื่อเลื่อนสคริปต์ได้ และรับฟังเมื่อคุณพูดไอเดียเป็นข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue her çekimde ve seslendirmelerde sesini kaydeder; metni kaydırmak için sesini de takip edebilir ve bir fikri sesle yazdığında seni dinler."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue ghi âm giọng bạn trong mỗi bản quay và cho phần lồng tiếng, có thể theo giọng bạn để cuộn kịch bản, và lắng nghe khi bạn đọc to một ý tưởng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会录制每个镜头和画外音中的声音，还能跟随你的声音滚动脚本，并在你语音输入想法时聆听。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 會在每個鏡頭與旁白中錄下你的聲音，可跟隨你的聲音捲動腳本，並在你口述想法時聆聽。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy description shown in the system permission prompt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Cue اللقطات التي تصدّرها في مكتبة الصور."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue gemmer de optagelser, du eksporterer, i dit fotobibliotek."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue sichert die Takes, die du exportierst, in deiner Fotomediathek."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Cue saves the takes you export to your photo library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue guarda en tu fototeca las tomas que exportas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue enregistre dans votre photothèque les prises que vous exportez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue आपके एक्सपोर्ट किए गए टेक आपकी फ़ोटो लाइब्रेरी में सेव करता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue menyimpan take yang kamu ekspor ke perpustakaan foto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue salva nella tua libreria foto le riprese che esporti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cueは書き出したテイクを写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue는 내보낸 테이크를 사진 보관함에 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lagrer opptakene du eksporterer i bildebiblioteket ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue bewaart de opnames die je exporteert in je fotobibliotheek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Cue salva na sua fototeca os takes que você exporta."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue sparar de tagningar du exporterar i ditt fotobibliotek."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue บันทึกเทคที่คุณส่งออกไว้ในคลังรูปภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue, dışa aktardığın çekimleri fotoğraf arşivine kaydeder."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue lưu các bản quay bạn xuất vào thư viện ảnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 会将你导出的镜头存储到照片图库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue 會將你匯出的鏡頭儲存到你的照片圖庫。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy description shown in the system permission prompt.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعرّف Cue على كلامك على جهاز iPhone هذا ليبقي النص على السطر الذي تقرؤه ويحوّل فكرتك المُملاة إلى نص. لا يغادر أي شيء الجهاز."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue genkender din tale på denne iPhone for at holde manuskriptet på den linje, du læser, og for at omsætte en idé, du dikterer, til tekst. Intet forlader enheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cue erkennt deine Sprache auf diesem iPhone, damit das Skript bei der Zeile bleibt, die du gerade liest, und um eine diktierte Idee in Text umzuwandeln. Nichts verlässt das Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
