    "Crown adjusting speed %@. Tap to release." : {
      "comment" : "Watch, accessibility: the Digital Crown turns the speed; %@ is the speed",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التاج يضبط السرعة %@. اضغط للإفلات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kronen justerer hastigheden %@. Tryk for at slippe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krone stellt Tempo %@ ein. Zum Lösen tippen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corona ajusta la velocidad %@. Toca para soltarla."
