# Who writes Ultra AI's scripts (claude-opus-5-5, claude-sonnet-5-5 or claude-haiku-5-5). Change it and redeploy: no new app build.
ULTRA_MODEL=claude-opus-5-5
# How hard it thinks when the app leaves it to the server (low, medium or high).
ULTRA_EFFORT=low
# How the server meters Ultra AI: off, observe or enforce (DESIGN_PROJECT §57).
ULTRA_METERING=enforce
# Cue's most per UTC day on Claude, in USD; past it Ultra AI rests until the next day. 0 is no cap.
ULTRA_DAILY_BUDGET_USD=20
