rules_version = '2';

// Only Cue's server writes or reads the invites (the `referral` Function, through the Admin SDK, which these rules don't apply to).
// No app or browser may touch the database directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
